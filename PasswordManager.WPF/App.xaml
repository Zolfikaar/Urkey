<Application x:Class="PasswordManager.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Basic Color Definitions -->
            <Color x:Key="PrimaryBrush">#7380EC</Color>
            <Color x:Key="BgBrush">#F6F6F9</Color>
            <Color x:Key="TextBrush">#363949</Color>
            <Color x:Key="InputBgBrush">#80D9D9D9</Color>
            <Color x:Key="CardBgBrush">#FFFFFF</Color>
            <Color x:Key="BorderBrush">#E0E0E0</Color>
            <Color x:Key="SecondaryTextBrush">#666666</Color>
            <Color x:Key="HoverBrush">#F0F0F0</Color>

            <!-- Basic Brushes -->
            <SolidColorBrush x:Key="PrimaryColor"
                             Color="{StaticResource PrimaryBrush}"/>
            <SolidColorBrush x:Key="BgColor"
                             Color="{StaticResource BgBrush}"/>
            <SolidColorBrush x:Key="TextColor"
                             Color="{StaticResource TextBrush}"/>
            <SolidColorBrush x:Key="InputBgColor"
                             Color="{StaticResource InputBgBrush}"/>
            <SolidColorBrush x:Key="CardBgColor"
                             Color="{StaticResource CardBgBrush}"/>
            <SolidColorBrush x:Key="BorderColor"
                             Color="{StaticResource BorderBrush}"/>
            <SolidColorBrush x:Key="SecondaryTextColor"
                             Color="{StaticResource SecondaryTextBrush}"/>
            <SolidColorBrush x:Key="HoverColor"
                             Color="{StaticResource HoverBrush}"/>

            <!-- Basic Styles -->
            <Style x:Key="PrimaryButtonStyle"
                   TargetType="Button">
                <Setter Property="Background"
                        Value="{StaticResource PrimaryColor}"/>
                <Setter Property="Foreground"
                        Value="White"/>
                <Setter Property="FontSize"
                        Value="16"/>
                <Setter Property="FontWeight"
                        Value="Bold"/>
                <Setter Property="BorderThickness"
                        Value="0"/>
                <Setter Property="Padding"
                        Value="20,10"/>
                <Setter Property="Cursor"
                        Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="8"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter Property="Background"
                                            Value="#5A6FD8"/>
                                </Trigger>
                                <Trigger Property="IsPressed"
                                         Value="True">
                                    <Setter Property="Background"
                                            Value="#4A5FC8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CardStyle"
                   TargetType="Border">
                <Setter Property="Background"
                        Value="{StaticResource CardBgColor}"/>
                <Setter Property="BorderBrush"
                        Value="{StaticResource BorderColor}"/>
                <Setter Property="BorderThickness"
                        Value="1"/>
                <Setter Property="CornerRadius"
                        Value="8"/>
                <Setter Property="Padding"
                        Value="20"/>
            </Style>

            <!-- Global Font Family Style -->
            <Style TargetType="Control">
                <Setter Property="FontFamily"
                        Value="pack://application:,,,/Fonts/#Cairo"/>
            </Style>

