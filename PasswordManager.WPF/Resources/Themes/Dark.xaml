<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Core brushes -->
    <SolidColorBrush x:Key="BgColor" Color="#0F1117"/>
    <SolidColorBrush x:Key="TextColor" Color="#F5F5F7"/>
    <SolidColorBrush x:Key="PrimaryColor" Color="#818CF8"/>
    <SolidColorBrush x:Key="InputBgColor" Color="#1A1C23"/>
    <SolidColorBrush x:Key="CardBgColor" Color="#1C1E26"/>
    <SolidColorBrush x:Key="BorderColor" Color="#2C2F38"/>
    <SolidColorBrush x:Key="SecondaryTextColor" Color="#9CA3AF"/>
    <SolidColorBrush x:Key="HoverColor" Color="#252832"/>

    <!-- Extended brushes -->
    <SolidColorBrush x:Key="SidebarBackgroundColor" Color="#14161C"/>
    <SolidColorBrush x:Key="SidebarSelectedColor" Color="#23273A"/>
    <SolidColorBrush x:Key="TertiaryBackgroundColor" Color="#1A1C25"/>
    <SolidColorBrush x:Key="InputBorderColor" Color="#3D4049"/>
    <SolidColorBrush x:Key="PlaceholderTextColor" Color="#A1A1AA"/>
    <SolidColorBrush x:Key="SuccessColor" Color="#22C55E"/>
    <SolidColorBrush x:Key="WarningColor" Color="#EAB308"/>
    <SolidColorBrush x:Key="ErrorColor" Color="#EF4444"/>

    <!-- Aliases -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#0F1117"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F5F5F7"/>

</ResourceDictionary>
