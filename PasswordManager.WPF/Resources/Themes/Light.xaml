<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Core brushes -->
    <SolidColorBrush x:Key="BgColor" Color="#F7F8FB"/>
    <SolidColorBrush x:Key="TextColor" Color="#1C1C28"/>
    <SolidColorBrush x:Key="PrimaryColor" Color="#4F46E5"/>
    <SolidColorBrush x:Key="InputBgColor" Color="#EFF1F7"/>
    <SolidColorBrush x:Key="CardBgColor" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="BorderColor" Color="#E3E5EC"/>
    <SolidColorBrush x:Key="SecondaryTextColor" Color="#5E6172"/>
    <SolidColorBrush x:Key="HoverColor" Color="#ECEEF5"/>

    <!-- Extended brushes -->
    <SolidColorBrush x:Key="SidebarBackgroundColor" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SidebarSelectedColor" Color="#E6E8FC"/>
    <SolidColorBrush x:Key="TertiaryBackgroundColor" Color="#FAFAFE"/>
    <SolidColorBrush x:Key="InputBorderColor" Color="#D0D2DA"/>
    <SolidColorBrush x:Key="PlaceholderTextColor" Color="#9CA3AF"/>
    <SolidColorBrush x:Key="SuccessColor" Color="#16A34A"/>
    <SolidColorBrush x:Key="WarningColor" Color="#EAB308"/>
    <SolidColorBrush x:Key="ErrorColor" Color="#DC2626"/>

    <!-- Aliases -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F7F8FB"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1C1C28"/>

</ResourceDictionary>
