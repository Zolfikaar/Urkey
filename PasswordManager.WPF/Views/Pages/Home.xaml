<Page x:Class="PasswordManager.WPF.Views.Pages.Home"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:PasswordManager.WPF.Views.Pages"
      mc:Ignorable="d"
      Title="Home"
      Background="#fff"
      FlowDirection="RightToLeft">

    <Border 
            Margin="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Page Header -->
            <Border Grid.Row="0"
                    Background="Transparent"
                    Margin="30,30,30,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="الرئيسية"
                               FontSize="24"
                               FontWeight="Bold"
                               
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="1"
                            Content="+ إضافة كلمة مرور جديدة"
                            Style="{StaticResource PrimaryButtonStyle}"
                            FontSize="14"
                            Padding="16,10"
                            Click="AddNewPassword"/>
                </Grid>
            </Border>

            <!-- Main Content -->
            <ScrollViewer Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    Margin="30,0,30,30">
                <StackPanel>
                    <!-- Welcome Section -->
                    <Border 
                            CornerRadius="8"
                            Padding="20"
                            Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="مرحباً بك في مدير كلمات المرور"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       
                                       Margin="0,0,0,10"/>
                            <TextBlock Text="إدارة آمنة ومرتبة لجميع كلمات المرور الخاصة بك"
                                       FontSize="14"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Quick Stats -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Total Passwords Card -->
                        <Border Grid.Column="0"
                                CornerRadius="8"
                                Margin="0,0,10,0"
                                BorderThickness="1">
                            <StackPanel Margin="20"
                                    HorizontalAlignment="Center">
                                <Path Data="M12 15l-3-3 3-3"
                                      Stroke="{StaticResource PrimaryColor}"
                                      StrokeThickness="2"
                                      Fill="Transparent"
                                      Width="24"
                                        Height="24"
                                      HorizontalAlignment="Center"
                                      Margin="0,0,0,10"/>
                                <TextBlock Text="0"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,5"/>
                                <TextBlock Text="إجمالي كلمات المرور"
                                           FontSize="12"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Vaults Card -->
                        <Border Grid.Column="1"
                                CornerRadius="8"
                                Margin="5,0"
                                BorderThickness="1">
                            <StackPanel Margin="20"
                                    HorizontalAlignment="Center">
                                <Path Data="M4 7V4a2 2 0 012-2h8a2 2 0 012 2v3M4 7H2a2 2 0 00-2 2v9a2 2 0 002 2h16a2 2 0 002-2V9a2 2 0 00-2-2h-2M4 7v10a2 2 0 002 2h8a2 2 0 002-2V7"
                                      Stroke="{StaticResource PrimaryColor}"
                                      StrokeThickness="2"
                                      Fill="Transparent"
                                      Width="24"
                                        Height="24"
                                      HorizontalAlignment="Center"
                                      Margin="0,0,0,10"/>
                                <TextBlock Text="0"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,5"/>
                                <TextBlock Text="المخازن"
                                           FontSize="12"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Security Score Card -->
                        <Border Grid.Column="2"
                                CornerRadius="8"
                                Margin="10,0,0,0"
                                BorderThickness="1">
                            <StackPanel Margin="20"
                                    HorizontalAlignment="Center">
                                <Path Data="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                                      Stroke="{StaticResource PrimaryColor}"
                                      StrokeThickness="2"
                                      Fill="Transparent"
                                      Width="24"
                                        Height="24"
                                      HorizontalAlignment="Center"
                                      Margin="0,0,0,10"/>
                                <TextBlock Text="100%"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,5"/>
                                <TextBlock Text="نقاط الأمان"
                                           FontSize="12"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Recent Activity -->
                    <Border 
                            CornerRadius="8"
                            BorderThickness="1">
                        <StackPanel Margin="20">
                            <TextBlock Text="النشاط الأخير"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,15"/>

                            <TextBlock Text="لا يوجد نشاط حديث"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       Margin="0,20"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Page>
