<Page x:Class="PasswordManager.WPF.Views.Pages.Settings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:PasswordManager.WPF.Views.Pages"
      mc:Ignorable="d"
      Title="Settings"
      Background="#fff"
      FlowDirection="RightToLeft">


    <Border
        Margin="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Page Header -->
            <Border Grid.Row="0"
                    Background="Transparent"
                    Margin="30,30,30,20">
                <TextBlock Text="الإعدادات"
                           FontSize="24"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- Settings Content -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Margin="30,0,30,30">
                <StackPanel>

                    <!-- Security Settings -->
                    <Border
                        CornerRadius="8"
                        BorderThickness="1"
                        Margin="0,0,0,20"
                        Style="{StaticResource CardStyle}">
                        <StackPanel Margin="20">
                            <TextBlock Text="إعدادات الأمان"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,20"/>

                            <!-- Master Password Change -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="تغيير كلمة المرور الرئيسية"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,5"/>
                                    <TextBlock Text="قم بتغيير كلمة المرور الرئيسية لحماية جميع كلمات المرور"
                                               FontSize="12"
                                               Foreground="{StaticResource SecondaryTextColor}"/>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="تغيير"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        FontSize="12"
                                        Padding="12,6"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Page>
