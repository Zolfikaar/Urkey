<Page x:Class="PasswordManager.WPF.Views.Pages.Settings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:PasswordManager.WPF.Views.Pages"
      mc:Ignorable="d"
      Title="{DynamicResource Settings_Title}"
      Foreground="{DynamicResource TextColor}">

    <Page.Resources>
        <Style TargetType="ScrollBar">
            <Setter Property="Margin"
                    Value="10,0,0,0"/>
            <Setter Property="Width"
                    Value="6"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="true">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Visibility="Collapsed"/>
                                </Track.DecreaseRepeatButton>

                                <!-- 🟢 الـ Thumb (المقبض) بحواف منحنية -->
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{StaticResource SecondaryTextColor}"
                                                        CornerRadius="5"
                                                        Width="10"
                                                        Margin="1"
                                                        SnapsToDevicePixels="True"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Visibility="Collapsed"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


    </Page.Resources>

    <Border
        Margin="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Page Header -->
            <Border Grid.Row="0"
                    Background="Transparent"
                    Margin="30,30,30,20">
                <TextBlock Text="{DynamicResource Settings_Title}"
                           FontSize="24"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- Settings Content -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Margin="30,0,30,30">
                <StackPanel>

                    <!-- Security Settings -->
                    <Border
                        CornerRadius="8"
                        BorderThickness="1"
                        Margin="0,0,0,20"
                        Style="{StaticResource CardStyle}">
                        <StackPanel Margin="20">
                            <TextBlock Text="{DynamicResource SecuritySettings_Title}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,20"/>

                            <!-- Master Password Change -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource MasterPassword_Title}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,5"/>
                                    <TextBlock Text="{DynamicResource MasterPassword_Description}"
                                               FontSize="12"
                                               Foreground="{StaticResource SecondaryTextColor}"/>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="{DynamicResource ChangeBtn}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        FontSize="12"
                                        Padding="12,6"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Language Settings -->
                    <Border CornerRadius="8"
                            BorderThickness="1"
                            Margin="0,0,0,20"
                            Style="{StaticResource CardStyle}">
                        <StackPanel Margin="20">
                            <TextBlock Text="{DynamicResource LanguageSettings_Title}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,20"/>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource LanguageSettings_Description}"
                                               FontSize="12"
                                               Margin="0,0,0,5"
                                               Foreground="{StaticResource SecondaryTextColor}"/>
                                </StackPanel>

                                <ToggleButton x:Name="LangToggle"
                                              Grid.Column="1"
                                              Content="{DynamicResource ChangeBtn}"
                                              Style="{StaticResource PrimaryToggleButtonStyle}"
                                              VerticalAlignment="Center"
                                              Click="OnLanguageChanged"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Theme Settings -->
                    <Border  CornerRadius="8"
                             BorderThickness="1"
                             Margin="0,0,0,20"
                             Style="{StaticResource CardStyle}">

                        <StackPanel Margin="20">
                            <TextBlock Text="{DynamicResource ThemeSettings_Title}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,20"/>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource ThemeSettings_Description}"
                                               FontSize="12"
                                               Margin="0,0,0,5"
                                               Foreground="{StaticResource SecondaryTextColor}"/>
                                </StackPanel>

                                <Button x:Name="ThemeToggle"
                                        Grid.Column="1"
                                        Content="{DynamicResource ChangeBtn}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        FontSize="12"
                                        Padding="12,6"
                                        VerticalAlignment="Center"
                                        Click="OnThemeChanged"/>
                            </Grid>
                        </StackPanel>
                    </Border>


                </StackPanel>


            </ScrollViewer>
        </Grid>
    </Border>
</Page>
