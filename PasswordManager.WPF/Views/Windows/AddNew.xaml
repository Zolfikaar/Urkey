<Window x:Class="PasswordManager.WPF.Views.Windows.AddNew"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PasswordManager.WPF.Views.Windows"
        mc:Ignorable="d"
        Title="Add New"
        Height="480"
        Width="520"
        Background="{DynamicResource BgColor}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="Height">
    <Border Style="{DynamicResource CardStyle}"
            Margin="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground"
                            Value="{DynamicResource TextColor}"/>
                    <Setter Property="VerticalAlignment"
                            Value="Center"/>
                    <Setter Property="Margin"
                            Value="0,0,0,6"/>
                </Style>
                <Style TargetType="TextBox">
                    <Setter Property="Foreground"
                            Value="{DynamicResource TextColor}"/>
                    <Setter Property="Background"
                            Value="{DynamicResource InputBgColor}"/>
                    <Setter Property="BorderBrush"
                            Value="{DynamicResource BorderColor}"/>
                    <Setter Property="BorderThickness"
                            Value="1"/>
                    <Setter Property="Padding"
                            Value="10"/>
                    <Setter Property="Margin"
                            Value="0,0,0,12"/>
                </Style>
                <Style TargetType="PasswordBox">
                    <Setter Property="Foreground"
                            Value="{DynamicResource TextColor}"/>
                    <Setter Property="Background"
                            Value="{DynamicResource InputBgColor}"/>
                    <Setter Property="BorderBrush"
                            Value="{DynamicResource BorderColor}"/>
                    <Setter Property="BorderThickness"
                            Value="1"/>
                    <Setter Property="Padding"
                            Value="10"/>
                    <Setter Property="Margin"
                            Value="0,0,0,12"/>
                </Style>
            </Grid.Resources>

            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Text="Title"/>
            <TextBox x:Name="TitleTextBox"
                     Grid.Row="0"
                     Grid.Column="1"/>

            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Text="Username"/>
            <TextBox x:Name="UsernameTextBox"
                     Grid.Row="1"
                     Grid.Column="1"/>

            <TextBlock Grid.Row="2"
                       Grid.Column="0"
                       Text="Password"/>
            <PasswordBox x:Name="PasswordBox"
                         Grid.Row="2"
                         Grid.Column="1"/>

            <TextBlock Grid.Row="3"
                       Grid.Column="0"
                       Text="URL"/>
            <TextBox x:Name="UrlTextBox"
                     Grid.Row="3"
                     Grid.Column="1"/>

            <TextBlock Grid.Row="4"
                       Grid.Column="0"
                       Text="Notes"/>
            <TextBox x:Name="NotesTextBox"
                     Grid.Row="4"
                     Grid.Column="1"
                     AcceptsReturn="True"
                     Height="100"
                     TextWrapping="Wrap"/>

            <StackPanel Grid.Row="5"
                        Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,10,0,0">
                <Button Content="Cancel"
                        Margin="0,0,10,0"
                        Padding="16,8"
                        Click="OnCancelClick"/>
                <Button Content="Save"
                        Style="{DynamicResource PrimaryButtonStyle}"
                        Padding="16,8"
                        Click="OnSaveClick"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
