<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Fallback Color tokens (pre-theme). Themes override the SolidColorBrush keys. -->
    <Color x:Key="PrimaryBrush">#8B93F7</Color>
    <Color x:Key="BgBrush">#16171F</Color>
    <Color x:Key="TextBrush">#E8E9F5</Color>
    <Color x:Key="InputBgBrush">#2A2C3E</Color>
    <Color x:Key="CardBgBrush">#1E2030</Color>
    <Color x:Key="BorderBrush">#34364A</Color>
    <Color x:Key="SecondaryTextBrush">#9A9BB8</Color>
    <Color x:Key="HoverBrush">#2E3044</Color>
    <Color x:Key="BlueGray">#536878</Color>
</ResourceDictionary>
