<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- الأساس: Cairo للعربي -->
    <!-- اسم الخط الفعلي من ملف Cairo.ttf -->
    <FontFamily x:Key="AppArabicFont">pack://application:,,,/Assets/Fonts/#Cairo</FontFamily>

    <!-- للإنكليزي: League Spartan -->
    <!-- اسم الخط الفعلي من ملف LeagueSpartan.ttf -->
    <!-- جرب "LeagueSpartan" (بدون مسافة) أو "League Spartan" (مع مسافة) حسب اسم الخط الفعلي -->
    <FontFamily x:Key="AppEnglishFont">pack://application:,,,/Assets/Fonts/#LeagueSpartan</FontFamily>


    <!-- FontFamily يجمع اللغتين حسب Script -->
    <!-- استخدام خط افتراضي مع FamilyMaps -->
    <!-- ملاحظة: FontFamilyMap في WPF لا يدعم خطوط مختلفة مباشرة في نفس FontFamily -->
    <!-- لذلك نستخدم خط افتراضي (LeagueSpartan) ونطبق Cairo ديناميكياً للعربية -->
    <FontFamily x:Key="GlobalFont">pack://application:,,,/Assets/Fonts/#LeagueSpartan</FontFamily>
    
    <!-- نستخدم خطوط منفصلة ونطبقها ديناميكياً -->
    <!-- الخط الافتراضي للعربية -->
    <FontFamily x:Key="DefaultArabicFont">pack://application:,,,/Assets/Fonts/#Cairo</FontFamily>
    
    <!-- الخط الافتراضي للإنجليزية -->
    <FontFamily x:Key="DefaultEnglishFont">pack://application:,,,/Assets/Fonts/#LeagueSpartan</FontFamily>


    <!-- نحقن الخط على مستوى كل شي -->
    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="{StaticResource GlobalFont}"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource GlobalFont}"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource GlobalFont}"/>
    </Style>

    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource GlobalFont}"/>
    </Style>

    <Style TargetType="Control">
        <Setter Property="FontFamily" Value="{StaticResource GlobalFont}"/>
    </Style>

</ResourceDictionary>
