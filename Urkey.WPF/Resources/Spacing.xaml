<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Spacing scale (device-independent pixels) -->
    <sys:Double x:Key="SpaceXS">4</sys:Double>
    <sys:Double x:Key="SpaceSM">8</sys:Double>
    <sys:Double x:Key="SpaceMD">12</sys:Double>
    <sys:Double x:Key="SpaceLG">16</sys:Double>
    <sys:Double x:Key="SpaceXL">24</sys:Double>
    <sys:Double x:Key="SpaceXXL">32</sys:Double>

    <Thickness x:Key="PageMargin">24</Thickness>
    <Thickness x:Key="PageMarginCompact">16,24</Thickness>
    <Thickness x:Key="CardPadding">20</Thickness>
    <Thickness x:Key="CardPaddingCompact">16</Thickness>
    <Thickness x:Key="StatCardGap">6</Thickness>
    <Thickness x:Key="SectionSpacing">0,0,0,20</Thickness>
    <Thickness x:Key="PageHeaderMargin">0,0,0,20</Thickness>
    <Thickness x:Key="ControlPadding">16,10</Thickness>
    <Thickness x:Key="InputPadding">14,12</Thickness>

    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="PillCornerRadius">24</CornerRadius>

    <sys:Double x:Key="CardBorderThickness">1</sys:Double>
    <sys:Double x:Key="AuthInputHeight">56</sys:Double>
    <sys:Double x:Key="AuthButtonHeight">50</sys:Double>

</ResourceDictionary>
