<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Primary -->
    <SolidColorBrush x:Key="PrimaryColor" Color="#6B73E0"/>
    <SolidColorBrush x:Key="PrimaryLight" Color="#9EA6FF"/>
    <SolidColorBrush x:Key="PrimaryLightest" Color="#E0E4FF"/>
    <SolidColorBrush x:Key="PrimaryDark" Color="#5B66D6"/>
    <SolidColorBrush x:Key="PrimaryDarker" Color="#3A42A6"/>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="BgColor" Color="#F4F5F9"/>
    <SolidColorBrush x:Key="CardBgColor" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ElevatedBgColor" Color="#F0F1F6"/>
    <SolidColorBrush x:Key="InputBgColor" Color="#EDEFF3"/>
    <SolidColorBrush x:Key="BorderColor" Color="#E0E2EA"/>
    <SolidColorBrush x:Key="HoverColor" Color="#EDEFF3"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextColor" Color="#2C2E3A"/>
    <SolidColorBrush x:Key="TextMutedColor" Color="#6B6B7A"/>
    <SolidColorBrush x:Key="SecondaryTextColor" Color="#6B6B7A"/>
    <SolidColorBrush x:Key="SubTextColor" Color="#6B6B7A"/>

    <!-- Status -->
    <SolidColorBrush x:Key="ErrorColor" Color="#E63946"/>
    <SolidColorBrush x:Key="SuccessColor" Color="#4CAF50"/>
    <SolidColorBrush x:Key="WarningBgColor" Color="#FFF8E7"/>
    <SolidColorBrush x:Key="WarningBorderColor" Color="#D4AF56"/>
    <SolidColorBrush x:Key="WarningTextColor" Color="#6B5A20"/>
    <SolidColorBrush x:Key="OverlayScrimColor" Color="#99000000"/>


    <!-- Brand gold (auth + security accents) -->
    <SolidColorBrush x:Key="AccentGold" Color="#D4AF56"/>
    <SolidColorBrush x:Key="AccentGoldHover" Color="#E4C56A"/>
    <SolidColorBrush x:Key="AccentGoldMuted" Color="#33D4AF56"/>

    <!-- Auth surfaces (splash background stays dark; fields stay high-contrast) -->
    <SolidColorBrush x:Key="AuthBgColor" Color="#16171F"/>
    <SolidColorBrush x:Key="AuthInputBg" Color="#12141F"/>
    <SolidColorBrush x:Key="AuthPanelBg" Color="#1A1C2A"/>
    <SolidColorBrush x:Key="AuthTextColor" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AuthButtonForeground" Color="#16171F"/>

    <!-- Buttons -->
    <SolidColorBrush x:Key="ButtonPrimaryBg" Color="#6B73E0"/>
    <SolidColorBrush x:Key="ButtonPrimaryHoverBg" Color="#5B66D6"/>
    <SolidColorBrush x:Key="ButtonPrimaryPressedBg" Color="#3A42A6"/>
    <SolidColorBrush x:Key="ButtonPrimaryText" Color="#FFFFFF"/>

    <!-- Navigation / lists -->
    <SolidColorBrush x:Key="SidebarSelectedColor" Color="#EDEFF3"/>
    <SolidColorBrush x:Key="RowHoverColor" Color="#F0F1F6"/>
    <SolidColorBrush x:Key="RowSelectedColor" Color="#E0E4FF"/>
    <SolidColorBrush x:Key="RowAltColor" Color="#F8F8FB"/>

</ResourceDictionary>
