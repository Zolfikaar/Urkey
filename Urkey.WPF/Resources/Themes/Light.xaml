<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

        <!-- Core Palette -->
        <SolidColorBrush x:Key="PrimaryColor"
                         Color="#818CF8"/>
        <SolidColorBrush x:Key="PrimaryLight"
                         Color="#B7BEFF"/>
        <SolidColorBrush x:Key="PrimaryLightest"
                         Color="#E0E4FF"/>
        <SolidColorBrush x:Key="PrimaryDark"
                         Color="#5B66D6"/>
        <SolidColorBrush x:Key="PrimaryDarker"
                         Color="#3A42A6"/>

        <!-- Base Colors -->
        <SolidColorBrush x:Key="BgColor"
                         Color="#F6F6F9"/>
        <!-- خلفية التطبيق العامة -->
        <SolidColorBrush x:Key="CardBgColor"
                         Color="#FFFFFF"/>
        <!-- البطاقات والنوافذ الفرعية -->
        <SolidColorBrush x:Key="InputBgColor"
                         Color="#EDEFF3"/>
        <!-- خلفية الحقول -->
        <SolidColorBrush x:Key="BorderColor"
                         Color="#E0E0E0"/>
        <!-- حدود الحقول والعناصر -->
        <SolidColorBrush x:Key="TextColor"
                         Color="#363949"/>
        <!-- النصوص العادية -->
        <SolidColorBrush x:Key="TextMutedColor"
                         Color="#6B6B7A"/>
        <!-- النصوص الثانوية -->
        <!-- Alias for small text used elsewhere -->
        <SolidColorBrush x:Key="SecondaryTextColor"
                         Color="#6B6B7A"/>
        <SolidColorBrush x:Key="ErrorColor"
                         Color="#E63946"/>
        <!-- رسائل الخطأ -->
        <SolidColorBrush x:Key="SuccessColor"
                         Color="#4CAF50"/>
        <!-- رسائل النجاح -->

        <!-- Component Examples -->
        <SolidColorBrush x:Key="ButtonPrimaryBg"
                         Color="{StaticResource PrimaryColor}"/>
        <SolidColorBrush x:Key="ButtonPrimaryHoverBg"
                         Color="{StaticResource PrimaryDark}"/>
        <SolidColorBrush x:Key="ButtonPrimaryText"
                         Color="#FFFFFF"/>

        <!-- Sidebar selected background (distinct in light theme) -->
        <SolidColorBrush x:Key="SidebarSelectedColor"
                         Color="#EDEFF3"/>

</ResourceDictionary>
