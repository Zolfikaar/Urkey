<UserControl x:Class="Urkey.WPF.UserControls.EntryTypesDropdown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Urkey.WPF.UserControls"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
        Background="Transparent"
        Foreground="{DynamicResource TextColor}">
    <Grid>
        <Button x:Name="AddButton"
                Content="{DynamicResource AddAccountTitle}"
                Style="{DynamicResource PrimaryBtnStyle}"
                Padding="16,10"
                Click="ToggleMenu"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <Path Data="{StaticResource bx_plus}"
                                  Fill="{TemplateBinding Foreground}"
                                  Margin="0,0,6,0"/>
                            <TextBlock Text="{TemplateBinding Content}"
                                       VerticalAlignment="Center"/>
                            <Path Data="M0,0 L6,6 L12,0 Z"
                                  Fill="{TemplateBinding Foreground}"
                                  Width="10"
                                  Height="6"
                                  Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Popup x:Name="AddMenuPopup"
               PlacementTarget="{Binding ElementName=AddButton}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True">
            <Grid>
                <Rectangle Fill="{DynamicResource CardBgColor}"
                           RadiusX="8"
                           RadiusY="8"
                           Stroke="{DynamicResource BorderColor}"
                           StrokeThickness="1"/>
                <Border Background="Transparent"
                        CornerRadius="8"
                        Padding="8"
                        MinWidth="170">
                    <StackPanel>
                        <StackPanel.Resources>
                            <Style x:Key="MenuButtonStyle"
                                   TargetType="Button">
                                <Setter Property="Background"
                                        Value="Transparent"/>
                                <Setter Property="BorderThickness"
                                        Value="0"/>
                                <Setter Property="Cursor"
                                        Value="Hand"/>
                                <Setter Property="HorizontalContentAlignment"
                                        Value="Left"/>
                                <Setter Property="Padding"
                                        Value="12,8"/>
                                <Setter Property="Margin"
                                        Value="2"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}"
                                                    TextElement.Foreground="{TemplateBinding Foreground}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver"
                                                         Value="True">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource HoverColor}"/>
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource PrimaryColor}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </StackPanel.Resources>
                        <Button Click="OnAddAccount_Click"
                                Style="{StaticResource MenuButtonStyle}"
                                Foreground="{DynamicResource TextColor}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource bx_userAccount}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="20"
                                      Height="20"
                                      Margin="0,0,12,0"/>
                                <TextBlock FontSize="14"
                                           VerticalAlignment="Center">
                                    <Run Text="{DynamicResource AccountTypeWebsite}"/>
                                    <Run Text=" / "/>
                                    <Run Text="{DynamicResource AccountTypeEmail}"/>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                        <Button Click="OnAddBankCard_Click"
                                Style="{StaticResource MenuButtonStyle}"
                                Foreground="{DynamicResource TextColor}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource bx_credit_card}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="20"
                                      Height="20"
                                      Margin="0,0,12,0"/>
                                <TextBlock Text="{DynamicResource AccountTypeBankCard}"
                                           FontSize="14"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Click="OnAddDocument_Click"
                                Style="{StaticResource MenuButtonStyle}"
                                Foreground="{DynamicResource TextColor}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource bx_doc}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="20"
                                      Height="20"
                                      Margin="0,0,12,0"/>
                                <TextBlock Text="{DynamicResource AccountTypeDocument}"
                                           FontSize="14"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Click="OnAddAddress_Click"
                                Style="{StaticResource MenuButtonStyle}"
                                Foreground="{DynamicResource TextColor}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource bx_address}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="20"
                                      Height="20"
                                      Margin="0,0,12,0"/>
                                <TextBlock Text="{DynamicResource AccountTypeAddress}"
                                           FontSize="14"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Click="OnAddNote_Click"
                                Style="{StaticResource MenuButtonStyle}"
                                Foreground="{DynamicResource TextColor}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource bx_notes}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="20"
                                      Height="20"
                                      Margin="0,0,12,0"/>
                                <TextBlock Text="{DynamicResource AccountTypeNote}"
                                           FontSize="14"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Popup>
    </Grid>
</UserControl>
