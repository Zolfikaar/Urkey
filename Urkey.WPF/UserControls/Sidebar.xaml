<UserControl x:Class="Urkey.WPF.UserControls.Sidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Urkey.WPF.UserControls"
             xmlns:conv="clr-namespace:Urkey.WPF.Converters"
             mc:Ignorable="d">

    <UserControl.Resources>
        <conv:FlowDirectionToHorizontalAlignmentConverter x:Key="FlowToAlign"/>

        <Style x:Key="SidebarButtonTooltipStyle" TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource ElevatedBgColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Margin="8,2"
                                SnapsToDevicePixels="True">
                            <Grid Height="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="3"/>
                                </Grid.ColumnDefinitions>

                                <!-- Accent bar (end side — mirrors with FlowDirection) -->
                                <Border x:Name="ActiveBar"
                                        Grid.Column="2"
                                        Background="{DynamicResource PrimaryColor}"
                                        CornerRadius="2"
                                        Visibility="Collapsed"
                                        Margin="0,8"/>

                                <Viewbox Grid.Column="0"
                                         Width="22"
                                         Height="22"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center">
                                    <Path x:Name="IconPath"
                                          Data="{TemplateBinding Tag}"
                                          Fill="{TemplateBinding Foreground}"
                                          Stretch="Uniform"/>
                                </Viewbox>

                                <TextBlock x:Name="Label"
                                           Grid.Column="1"
                                           Text="{TemplateBinding Content}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center"
                                           Margin="4,0,8,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverColor}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryColor}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SidebarSelectedColor}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryColor}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding (local:Sidebar.IsActive), RelativeSource={RelativeSource Self}}"
                                         Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SidebarSelectedColor}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryColor}"/>
                                <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel LastChildFill="True" Background="{DynamicResource BgColor}">

        <!-- Toggle — same 44px icon column as nav items -->
        <Button x:Name="SidebarToggleBtn"
                DockPanel.Dock="Top"
                Style="{StaticResource SidebarButtonStyle}"
                Tag="{StaticResource bx_sidebar}"
                Content="{DynamicResource SidebarToggleLabel}"
                Click="SidebarToggleBtn_Click"
                ToolTip="{DynamicResource SidebarToggleLabel}"/>

        <Button x:Name="Settings"
                DockPanel.Dock="Bottom"
                Style="{StaticResource SidebarButtonStyle}"
                Tag="{StaticResource bx_settings}"
                Content="{DynamicResource Settings_Title}"
                Click="SidebarBtnClicked"
                ToolTip="{DynamicResource Settings_Title}"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,4,0,4">
            <StackPanel x:Name="TopBtns">
                <Button Style="{StaticResource SidebarButtonStyle}"
                        Click="SidebarBtnClicked"
                        x:Name="Home"
                        Tag="{StaticResource bx_home}"
                        Content="{DynamicResource HomeTitle}"
                        ToolTip="{DynamicResource HomeTitle}"/>

                <Button Style="{StaticResource SidebarButtonStyle}"
                        Click="SidebarBtnClicked"
                        x:Name="AllEntries"
                        Tag="{StaticResource bx_app}"
                        Content="{DynamicResource AllEntriesTitle}"
                        ToolTip="{DynamicResource AllEntriesTitle}"/>

                <Button Style="{StaticResource SidebarButtonStyle}"
                        Click="SidebarBtnClicked"
                        x:Name="Accounts"
                        Tag="{StaticResource bx_userAccount}"
                        Content="{DynamicResource AccountsTitle}"
                        ToolTip="{DynamicResource AccountsTitle}"/>

                <Button Style="{StaticResource SidebarButtonStyle}"
                        Click="SidebarBtnClicked"
                        x:Name="CreditCards"
                        Tag="{StaticResource bx_credit_card}"
                        Content="{DynamicResource BankCardsTitle}"
                        ToolTip="{DynamicResource BankCardsTitle}"/>

                <Button Style="{StaticResource SidebarButtonStyle}"
                        Click="SidebarBtnClicked"
                        x:Name="Addresses"
                        Tag="{StaticResource bx_address}"
                        Content="{DynamicResource AddressesTitle}"
                        ToolTip="{DynamicResource AddressesTitle}"/>

                <Button Style="{StaticResource SidebarButtonStyle}"
                        Click="SidebarBtnClicked"
                        x:Name="Notes"
                        Tag="{StaticResource bx_notes}"
                        Content="{DynamicResource NotesTitle}"
                        ToolTip="{DynamicResource NotesTitle}"/>

                <Button Style="{StaticResource SidebarButtonStyle}"
                        Click="SidebarBtnClicked"
                        x:Name="Docs"
                        Tag="{StaticResource bx_doc}"
                        Content="{DynamicResource DocumentsTitle}"
                        ToolTip="{DynamicResource DocumentsTitle}"/>

                <Button Style="{StaticResource SidebarButtonStyle}"
                        Click="SidebarBtnClicked"
                        x:Name="PasswordCheck"
                        Tag="{StaticResource bx_passwords}"
                        Content="{DynamicResource PasswordCheckTitle}"
                        ToolTip="{DynamicResource PasswordCheckTitle}"/>

                <Button Style="{StaticResource SidebarButtonStyle}"
                        Click="SidebarBtnClicked"
                        x:Name="PasswordGenerator"
                        Tag="{StaticResource bx_password_gen}"
                        Content="{DynamicResource PasswordGeneratorTitle}"
                        ToolTip="{DynamicResource PasswordGeneratorTitle}"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
