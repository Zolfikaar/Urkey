<UserControl x:Class="Urkey.WPF.UserControls.Sidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Urkey.WPF.UserControls"
             mc:Ignorable="d">
        <UserControl.Resources>
                <!-- Tooltip Style for Sidebar Buttons (only visible when collapsed) -->
                <Style x:Key="SidebarButtonTooltipStyle" TargetType="ToolTip">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>

                <!-- Style for Sidebar Buttons -->
                <Style x:Key="SidebarButtonStyle"
                       TargetType="Button">
                        <Setter Property="Background"
                                Value="{DynamicResource BgColor}"/>
                        <Setter Property="BorderThickness"
                                Value="0"/>
                        <Setter Property="Cursor"
                                Value="Hand"/>
                        <Setter Property="Width"
                                Value="240"/>
                        <Setter Property="Height"
                                Value="60"/>
                        <Setter Property="Foreground"
                                Value="{DynamicResource TextColor}"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}">
                                                        <Grid>
                                                                <WrapPanel Height="60"
                                                                           Width="240">
                                                                        <Border Focusable="False"
                                                                                Height="60"
                                                                                Width="60"
                                                                                HorizontalAlignment="Left"
                                                                                Background="{TemplateBinding Background}">
                                                                                <Path
                                                                                        Data="{TemplateBinding Tag}"
                                                                                        Fill="{TemplateBinding Foreground}"
                                                                                        Width="24"
                                                                                        Height="24"/>
                                                                        </Border>
                                                                        <Border Focusable="False"
                                                                                Height="60"
                                                                                Width="180"
                                                                                Background="{TemplateBinding Background}">
                                                                                <TextBlock
                                                                                        Focusable="False"
                                                                                        Text="{TemplateBinding Content}"
                                                                                        FontSize="20"
                                                                                        FontWeight="Bold"
                                                                                        Foreground="{TemplateBinding Foreground}"
                                                                                        HorizontalAlignment="{Binding WordDicrection}"
                                                                                        VerticalAlignment="Center"
                                                                                        FontFamily="Cairo"/>
                                                                        </Border>
                                                                </WrapPanel>
                                                        </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>

                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                                <Setter Property="Background"
                                                                        Value="{DynamicResource HoverColor}"/>
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource PrimaryColor}"/>
                                                        </Trigger>

                                                        <Trigger Property="IsPressed"
                                                                 Value="True">
                                                                <Setter Property="Background"
                                                                        Value="{DynamicResource SidebarSelectedColor}"/>
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource PrimaryColor}"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding (local:Sidebar.IsActive), RelativeSource={RelativeSource Self}}"
                                                                     Value="True">
                                                                <Setter Property="Background"
                                                                        Value="{DynamicResource SidebarSelectedColor}"/>
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource PrimaryColor}"/>
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding (local:Sidebar.IsActive), RelativeSource={RelativeSource Self}}"
                                                                                   Value="True"/>
                                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}"
                                                                                   Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Background"
                                                                        Value="{DynamicResource HoverColor}"/>
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource PrimaryColor}"/>
                                                        </MultiDataTrigger>
                                                        <Trigger Property="IsEnabled"
                                                                 Value="False">
                                                                <Setter Property="Opacity"
                                                                        Value="0.5"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <!-- Style for Nested Menu Buttons -->
                <Style x:Key="NestedMenuButtonStyle"
                       TargetType="Button"
                       BasedOn="{StaticResource SidebarButtonStyle}">
                        <Setter Property="Height"
                                Value="50"/>
                        <Setter Property="Margin"
                                Value="0,0,0,2"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}">
                                                        <Grid>
                                                                <WrapPanel Height="50"
                                                                           Width="240">
                                                                        <Border Focusable="False"
                                                                                Height="50"
                                                                                Width="60"
                                                                                HorizontalAlignment="Left"
                                                                                Background="{TemplateBinding Background}">
                                                                                <Path
                                                                                        Data="{TemplateBinding Tag}"
                                                                                        Fill="{TemplateBinding Foreground}"
                                                                                        Width="20"
                                                                                        Height="20"/>
                                                                        </Border>
                                                                        <Border Focusable="False"
                                                                                Height="50"
                                                                                Width="180"
                                                                                Background="{TemplateBinding Background}">
                                                                                <TextBlock
                                                                                        Focusable="False"
                                                                                        Text="{TemplateBinding Content}"
                                                                                        FontSize="18"
                                                                                        FontWeight="Normal"
                                                                                        Foreground="{TemplateBinding Foreground}"
                                                                                        HorizontalAlignment="Left"
                                                                                        VerticalAlignment="Center"
                                                                                        FontFamily="Cairo"/>
                                                                        </Border>
                                                                </WrapPanel>
                                                        </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                                <Setter Property="Background"
                                                                        Value="{DynamicResource HoverColor}"/>
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource PrimaryColor}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed"
                                                                 Value="True">
                                                                <Setter Property="Background"
                                                                        Value="{DynamicResource SidebarSelectedColor}"/>
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource PrimaryColor}"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding (local:Sidebar.IsActive), RelativeSource={RelativeSource Self}}"
                                                                     Value="True">
                                                                <Setter Property="Background"
                                                                        Value="{DynamicResource SidebarSelectedColor}"/>
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource PrimaryColor}"/>
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding (local:Sidebar.IsActive), RelativeSource={RelativeSource Self}}"
                                                                                   Value="True"/>
                                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}"
                                                                                   Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Background"
                                                                        Value="{DynamicResource HoverColor}"/>
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource PrimaryColor}"/>
                                                        </MultiDataTrigger>
                                                        <Trigger Property="IsEnabled"
                                                                 Value="False">
                                                                <Setter Property="Opacity"
                                                                        Value="0.5"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>
        </UserControl.Resources>

        <!-- Sidebar -->
        <Border
                BorderBrush="{x:Null}"
                BorderThickness="0"
                x:Name="SidebarWrapper"
                Grid.Row="1"
                Grid.RowSpan="2"
                Grid.Column="0"
                VerticalAlignment="Stretch">
                <Border BorderBrush="{x:Null}"
                        BorderThickness="0"
                        Background="{DynamicResource BgColor}">
                        <Border.Effect>
                                <DropShadowEffect
                                        Color="#03000000"
                                        Direction="270"
                                        ShadowDepth="7"
                                        BlurRadius="25"
                                        Opacity=".2"/>

                        </Border.Effect>

                        <DockPanel x:Name="SidebarPanel"
                                   LastChildFill="false">

                                <!-- Top Buttons  -->
                                <StackPanel x:Name="TopBtns"
                                            DockPanel.Dock="Top">

                                        <Button Style="{StaticResource SidebarButtonStyle}"
                                                Click="SidebarBtnClicked"
                                                x:Name="Home"
                                                Tag="{StaticResource bx_home}"
                                                Content="{DynamicResource HomeTitle}">
                                            <Button.ToolTip>
                                                <ToolTip Content="{DynamicResource HomeTitle}" Style="{StaticResource SidebarButtonTooltipStyle}"/>
                                            </Button.ToolTip>
                                        </Button>

                                        <!-- All Entries as a normal item -->
                                        <Button Style="{StaticResource SidebarButtonStyle}"
                                                Click="SidebarBtnClicked"
                                                x:Name="AllEntries"
                                                Tag="{StaticResource bx_app}"
                                                Content="{DynamicResource AllEntriesTitle}">
                                            <Button.ToolTip>
                                                <ToolTip Content="{DynamicResource AllEntriesTitle}" Style="{StaticResource SidebarButtonTooltipStyle}"/>
                                            </Button.ToolTip>
                                        </Button>

                                        <!-- Former nested items moved to top level -->
                                        <Button Style="{StaticResource SidebarButtonStyle}"
                                                Click="SidebarBtnClicked"
                                                x:Name="Accounts"
                                                Tag="{StaticResource bx_userAccount}"
                                                Content="{DynamicResource AccountsTitle}">
                                            <Button.ToolTip>
                                                <ToolTip Content="{DynamicResource AccountsTitle}" Style="{StaticResource SidebarButtonTooltipStyle}"/>
                                            </Button.ToolTip>
                                        </Button>

                                        <Button Style="{StaticResource SidebarButtonStyle}"
                                                Click="SidebarBtnClicked"
                                                x:Name="CreditCards"
                                                Tag="{StaticResource bx_credit_card}"
                                                Content="{DynamicResource BankCardsTitle}">
                                            <Button.ToolTip>
                                                <ToolTip Content="{DynamicResource BankCardsTitle}" Style="{StaticResource SidebarButtonTooltipStyle}"/>
                                            </Button.ToolTip>
                                        </Button>

                                        <Button Style="{StaticResource SidebarButtonStyle}"
                                                Click="SidebarBtnClicked"
                                                x:Name="Addresses"
                                                Tag="{StaticResource bx_address}"
                                                Content="{DynamicResource AddressesTitle}">
                                            <Button.ToolTip>
                                                <ToolTip Content="{DynamicResource AddressesTitle}" Style="{StaticResource SidebarButtonTooltipStyle}"/>
                                            </Button.ToolTip>
                                        </Button>

                                        <Button Style="{StaticResource SidebarButtonStyle}"
                                                Click="SidebarBtnClicked"
                                                x:Name="Notes"
                                                Tag="{StaticResource bx_notes}"
                                                Content="{DynamicResource NotesTitle}">
                                            <Button.ToolTip>
                                                <ToolTip Content="{DynamicResource NotesTitle}" Style="{StaticResource SidebarButtonTooltipStyle}"/>
                                            </Button.ToolTip>
                                        </Button>

                                        <Button Style="{StaticResource SidebarButtonStyle}"
                                                Click="SidebarBtnClicked"
                                                x:Name="Docs"
                                                Tag="{StaticResource bx_doc}"
                                                Content="{DynamicResource DocsTitle}">
                                            <Button.ToolTip>
                                                <ToolTip Content="{DynamicResource DocsTitle}" Style="{StaticResource SidebarButtonTooltipStyle}"/>
                                            </Button.ToolTip>
                                        </Button>

                                        <Button Style="{StaticResource SidebarButtonStyle}"
                                                Click="SidebarBtnClicked"
                                                x:Name="PasswordCheck"
                                                Tag="{StaticResource bx_passwords}"
                                                Content="{DynamicResource PasswordCheckTitle}">
                                            <Button.ToolTip>
                                                <ToolTip Content="{DynamicResource PasswordCheckTitle}" Style="{StaticResource SidebarButtonTooltipStyle}"/>
                                            </Button.ToolTip>
                                        </Button>

                                        <Button Style="{StaticResource SidebarButtonStyle}"
                                                Click="SidebarBtnClicked"
                                                x:Name="PasswordGenerator"
                                                Tag="{StaticResource bx_password_gen}"
                                                Content="{DynamicResource PasswordGeneratorTitle}">
                                            <Button.ToolTip>
                                                <ToolTip Content="{DynamicResource PasswordGeneratorTitle}" Style="{StaticResource SidebarButtonTooltipStyle}"/>
                                            </Button.ToolTip>
                                        </Button>

                </StackPanel>


                                <!-- Settings Button -->
                                <Button DockPanel.Dock="Bottom"
                                        Style="{StaticResource SidebarButtonStyle}"
                                        Tag="{StaticResource bx_settings}"
                                        Click="SidebarBtnClicked"
                                        x:Name="Settings"
                                        Content="{DynamicResource SettingsTitle}">
                                    <Button.ToolTip>
                                        <ToolTip Content="{DynamicResource SettingsTitle}" Style="{StaticResource SidebarButtonTooltipStyle}"/>
                                    </Button.ToolTip>
                                </Button>




                        </DockPanel>
                </Border>
        </Border>

</UserControl>
