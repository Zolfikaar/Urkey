<UserControl x:Class="Urkey.WPF.UserControls.ViewToggler"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Urkey.WPF.UserControls"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="ViewToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource ControlCornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root"
                                        Property="BorderBrush"
                                        Value="{DynamicResource PrimaryColor}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{DynamicResource PrimaryColor}"/>
                                <Setter TargetName="Root"
                                        Property="BorderBrush"
                                        Value="{DynamicResource PrimaryColor}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{DynamicResource PrimaryColor}"/>
                                <Setter TargetName="Root"
                                        Property="BorderBrush"
                                        Value="{DynamicResource PrimaryColor}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource ButtonPrimaryText}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root"
                                        Property="Opacity"
                                        Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- View Mode Toggle -->
    <StackPanel Orientation="Horizontal"
                DockPanel.Dock="Right"
                VerticalAlignment="Center">
        <ToggleButton x:Name="ListViewButton"
                      ToolTip="{DynamicResource View_List}"
                      Style="{StaticResource ViewToggleButtonStyle}"
                      Margin="0,0,8,0"
                      Click="OnListViewClicked">
            <Viewbox Width="25"
                     Height="25"
                     Margin="0,0,5,8"
                     >
                <Path Data="{StaticResource bx_bars}"
                      Fill="{Binding Foreground,
                    RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                      
                      />
            </Viewbox>
        </ToggleButton>
        <ToggleButton x:Name="GridViewButton"
                      ToolTip="{DynamicResource View_Grid}"
                      Style="{StaticResource ViewToggleButtonStyle}"
                      Margin="0,0,8,0"
                      Click="OnGridViewClicked">
            <Viewbox Width="25"
                     Height="25"
                      Margin="0,0,5,5"
                     >
                <Path Data="{StaticResource bx_grid}"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
            </Viewbox>
        </ToggleButton>
    </StackPanel>
</UserControl>
