<Window x:Class="Urkey.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uc="clr-namespace:Urkey.WPF.UserControls"
        Title="{DynamicResource MainWindowTitle}"
        FontFamily="pack://application:,,,/Assets/Fonts/#Cairo"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Height="720"
        Width="1080"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}"
        Foreground="{DynamicResource TextColor}"
        >

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

  

    <Grid x:Name="MainGrid">
        <!-- Row and Column Definitions -->
        <Grid.RowDefinitions>
            <!-- Topbar -->
            <RowDefinition Height="60"/>
            <!-- Main content -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <!-- Edge column (Sidebar/Logo) -->
            <ColumnDefinition Width="Auto" MinWidth="60" MaxWidth="240"/>
            <!-- Center content (always middle) -->
            <ColumnDefinition Width="*"/>
            <!-- Edge column (Sidebar/Logo) -->
            <ColumnDefinition Width="Auto" MinWidth="60" MaxWidth="240"/>
        </Grid.ColumnDefinitions>

        <!-- Topbar -->
        <Border
        Panel.ZIndex="1"
        x:Name="Topbar"
        Padding="20,0"
        Grid.Column="1"
        Grid.ColumnSpan="2"
        Height="60"
        VerticalAlignment="Top"
        Background="{DynamicResource BgColor}"
        BorderThickness="0">

            <Border.Effect>
                <DropShadowEffect
                Color="#03000000"
                Direction="250"
                ShadowDepth="7"
                BlurRadius="20"
                Opacity=".2"/>
            </Border.Effect>

            <!-- Grid for layout inside topbar -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Burger Icon -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Spacer -->
                    <ColumnDefinition Width="*"/>
                    <!-- View toggler -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Search -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Burger Button (on right due to RTL) -->
                <Button Background="Transparent"
                    Click="ToggleSidebar_Click"
                    BorderThickness="0"
                    Cursor="Hand">

                    <Border Grid.Column="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Padding="10">
                        <TextBlock
                        x:Name="BurgerIcon"
                        FontSize="24"
                        Text="&#xE700;"
                        FontFamily="Segoe MDL2 Assets"
                        VerticalAlignment="Center"
                        TextAlignment="Center"
                        Foreground="{DynamicResource TextColor}"/>
                    </Border>
                </Button>

                <uc:ViewToggler x:Name="GlobalViewToggler"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0"
                                DataContext="{Binding ElementName=MainContentArea, Path=Content.DataContext}"/>

                <Border
                Height="40"
                Width="250"
                Background="{DynamicResource InputBgColor}"
                Grid.Column="3"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                CornerRadius="5">
                    <Grid>
                        <TextBox
                        x:Name="SearchBox"
                        Foreground="{DynamicResource TextColor}"
                        Padding="28,5,8,5"
                        Background="Transparent"
                        Height="40"
                        BorderThickness="0"
                        Width="250"
                        TextChanged="OnGlobalSearchTextChanged"/>

                        <!-- Search icon -->
                        <Viewbox Width="16"
                            Height="16"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0"
                            IsHitTestVisible="False">
                            <Path Data="{StaticResource bx_search}"
                                Fill="{DynamicResource SecondaryTextColor}"/>
                        </Viewbox>

                        <!-- Placeholder overlay -->
                        <TextBlock
                        Text="Search"
                        Foreground="{DynamicResource SecondaryTextColor}"
                        VerticalAlignment="Center"
                        Margin="28,0,8,0"
                        IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility"
                                        Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}"
                                            Value="0">
                                            <Setter Property="Visibility"
                                                Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Logo -->
        <Border Panel.ZIndex="3"
            x:Name="Logo"
            Grid.Row="0"
            Grid.Column="0"
            Height="60"
            Background="{DynamicResource BgColor}"
            HorizontalAlignment="Left">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType=Window}}" Value="RightToLeft">
                            <Setter Property="Grid.Column" Value="2"/>
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <WrapPanel
            x:Name="LogoWrapper"
            Height="60"
            HorizontalAlignment="Left"
            VerticalAlignment="Center">

                <Border x:Name="LogoIconWrapper"
                    Height="60"
                    Width="60">
                    <TextBlock
                    x:Name="LogoIcon"
                    FontSize="36"
                    Text=""
                    FontFamily="Segoe MDL2 Assets"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource TextColor}"/>

                </Border>

                <TextBlock x:Name="LogoText"
                        Width="180"
                        TextAlignment="Center"
                        Text=""
                        FontSize="28"
                        FontWeight="Bold"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}, RelativeSource={RelativeSource AncestorType=Window}}"/>

            </WrapPanel>
        </Border>

        <!-- Sidebar -->
        <Border x:Name="SidebarContainer"
        Width="240"
        Grid.Row="1"
        Grid.Column="0"
        Panel.ZIndex="2"
        Background="{DynamicResource BgColor}">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="RightToLeft">
                            <Setter Property="Grid.Column" Value="2"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <uc:Sidebar
        x:Name="Sidebar"
        IsSidebarExpanded="{Binding IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}"/>
        </Border>


        <!-- Main Content -->
        <Border Grid.Row="1"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Padding="20">

            <Border
            CornerRadius="20"
            Padding="20,10"
            Background="{DynamicResource CardBgColor}">
                <Border.Effect>
                    <DropShadowEffect
                    Color="#03000000"
                    Direction="270"
                    ShadowDepth="7"
                    BlurRadius="25"
                    Opacity=".2"/>
                </Border.Effect>



                <Frame x:Name="MainContentArea"
                    NavigationUIVisibility="Hidden"/>

            </Border>

        </Border>

    </Grid>



</Window>
