<Window x:Class="Urkey.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uc="clr-namespace:Urkey.WPF.UserControls"
        Title="{DynamicResource AppTitle}"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Height="720"
        Width="1080"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgColor}"
        Foreground="{DynamicResource TextColor}"
        FlowDirection="{DynamicResource AppFlowDirection}"
        Icon="pack://application:,,,/Assets/Icons/app-icon.ico"
        >

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="60" MaxWidth="240"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto" MinWidth="60" MaxWidth="240"/>
        </Grid.ColumnDefinitions>

        <!-- Topbar (no burger — toggle lives in Sidebar icon column) -->
        <Border x:Name="Topbar"
                Panel.ZIndex="1"
                Padding="16,0"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Height="60"
                VerticalAlignment="Top"
                Background="{DynamicResource BgColor}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <uc:ViewToggler x:Name="GlobalViewToggler"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0"
                                DataContext="{Binding ElementName=MainContentArea, Path=Content.DataContext}"/>

                <Button x:Name="LockVaultButton"
                        Grid.Column="2"
                        Style="{StaticResource WindowButtonStyle}"
                        Margin="0,0,8,0"
                        ToolTip="{DynamicResource LockVault_Tooltip}"
                        Click="OnLockVaultClick">
                    <Viewbox Width="16" Height="16">
                        <Path Data="{StaticResource bx_lock}" Fill="{DynamicResource TextColor}"/>
                    </Viewbox>
                </Button>

                <Border Grid.Column="3"
                        Height="40"
                        Width="260"
                        Background="{DynamicResource InputBgColor}"
                        VerticalAlignment="Center"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1">
                    <Grid>
                        <TextBox x:Name="SearchBox"
                                 Foreground="{DynamicResource TextColor}"
                                 Padding="36,5,12,5"
                                 Background="Transparent"
                                 Height="40"
                                 BorderThickness="0"
                                 VerticalContentAlignment="Center"
                                 TextChanged="OnGlobalSearchTextChanged"/>

                        <Viewbox Width="16"
                                 Height="16"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Margin="12,0,0,0"
                                 IsHitTestVisible="False">
                            <Path Data="{StaticResource bx_search}"
                                  Fill="{DynamicResource TextMutedColor}"/>
                        </Viewbox>

                        <TextBlock Text="{DynamicResource SearchPlaceholder}"
                                   Foreground="{DynamicResource TextMutedColor}"
                                   VerticalAlignment="Center"
                                   Margin="36,0,12,0"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Logo (aligned with sidebar width) -->
        <Border Panel.ZIndex="3"
                x:Name="Logo"
                Grid.Row="0"
                Grid.Column="0"
                Height="60"
                Background="{DynamicResource BgColor}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,0,0,1">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType=Window}}"
                                     Value="RightToLeft">
                            <Setter Property="Grid.Column" Value="2"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid x:Name="LogoWrapper" Height="60">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Viewbox Grid.Column="0"
                         Width="28"
                         Height="28"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center">
                    <Path Data="{StaticResource bx_lock}"
                          Fill="{DynamicResource AccentGold}"/>
                </Viewbox>

                <TextBlock x:Name="LogoText"
                           Grid.Column="1"
                           Text="{DynamicResource AppTitle}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           Foreground="{DynamicResource TextColor}"
                           Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}, RelativeSource={RelativeSource AncestorType=Window}}"/>
            </Grid>
        </Border>

        <!-- Sidebar -->
        <Border x:Name="SidebarContainer"
                Width="240"
                Grid.Row="1"
                Grid.Column="0"
                Panel.ZIndex="2"
                Background="{DynamicResource BgColor}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,0,1,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType=Window}}"
                                     Value="RightToLeft">
                            <Setter Property="Grid.Column" Value="2"/>
                            <Setter Property="BorderThickness" Value="1,0,0,0"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <uc:Sidebar x:Name="Sidebar"
                        IsSidebarExpanded="{Binding IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}"/>
        </Border>

        <!-- Main Content — flat surface (no nested shell card) -->
        <Border Grid.Row="1"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Background="{DynamicResource BgColor}">
            <Frame x:Name="MainContentArea"
                   NavigationUIVisibility="Hidden"
                   Background="Transparent"/>
        </Border>

        <!-- Global toast overlay -->
        <uc:ToastHost Grid.Row="0"
                      Grid.RowSpan="2"
                      Grid.Column="0"
                      Grid.ColumnSpan="3"
                      Panel.ZIndex="100"
                      Margin="24"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Bottom"
                      FlowDirection="{DynamicResource AppFlowDirection}"/>
    </Grid>
</Window>
