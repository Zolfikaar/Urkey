                </Grid>

            <ComboBox x:Name="CategoryCombo"
                      Width="180"
                      Margin="12,0,10,0"
                      Style="{StaticResource FilterComboBoxStyle}"
                      ItemsSource="{Binding Categories}"
                      SelectedItem="{Binding SelectedCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd"
                                            Background="Transparent"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverColor}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowSelectedColor}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryColor}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ComboBox.ItemContainerStyle>
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   HorizontalAlignment="Stretch"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,0,0">
                <Button Width="44"
                        Height="44"
                        Margin="0,0,8,0"
                        Style="{StaticResource TopbarIconBtnStyle}"
                        Command="{Binding ToggleFavoriteCommand}">
                    <ToolTipService.ToolTip>
                        <ToolTip Content="{DynamicResource FavoriteButton}"/>
                    </ToolTipService.ToolTip>
                    <Viewbox Width="20" Height="20">
                        <Path Data="{StaticResource bx_favorite}">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="{DynamicResource TextColor}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedAccount.IsFavorite}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource PrimaryColor}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource PrimaryColor}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Viewbox>
                </Button>
                <Button Width="44"
                        Height="44"
                        Margin="0,0,8,0"
                        Style="{StaticResource TopbarIconBtnStyle}"
                        Command="{Binding EditAccountCommand}">
                    <ToolTipService.ToolTip>
                        <ToolTip Content="{DynamicResource EditButton}"/>
                    </ToolTipService.ToolTip>
                    <Viewbox Width="20" Height="20">
                        <Path Data="{StaticResource bx_edit}">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="{DynamicResource TextColor}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource PrimaryColor}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Viewbox>
                </Button>
                <Button Width="44"
                        Height="44"
                        Style="{StaticResource TopbarIconBtnStyle}"
                        Click="OnMoreOptionsClick">
                    <ToolTipService.ToolTip>
                        <ToolTip Content="{DynamicResource MoreOptionsButton}"/>
                    </ToolTipService.ToolTip>
                    <Button.ContextMenu>
                        <ContextMenu Placement="Bottom"
                                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="{DynamicResource DetailsMenuItem}" Click="OnDetailsClick"/>
                            <MenuItem Header="{DynamicResource DeleteButton}"
                                      Command="{Binding DeleteAccountCommand}"/>
                            <MenuItem Header="{DynamicResource OpenMenuItem}"
                                      Command="{Binding OpenAccountCommand}"
                                      CommandParameter="{Binding SelectedAccount}"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <Viewbox Width="20" Height="20">
                        <Path Data="{StaticResource bx_show_more}">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="{DynamicResource TextColor}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource PrimaryColor}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Viewbox>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1">
                <Grid x:Name="ListViewContainer" Visibility="{Binding IsListView, Converter={StaticResource BoolToVisibility}}">
                    <DataGrid ItemsSource="{Binding FilteredAccounts}"
                              SelectedItem="{Binding SelectedAccount}"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              IsReadOnly="True"
                              Margin="0"
                              FlowDirection="{DynamicResource AppFlowDirection}"
                              Style="{StaticResource VaultDataGridStyle}"
                              ColumnHeaderStyle="{StaticResource VaultDataGridColumnHeaderStyle}"
                              RowStyle="{StaticResource VaultDataGridRowStyle}"
                              MouseDoubleClick="OnDataGridDoubleClick"
                              Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
                        <DataGrid.Resources>
                            <Style x:Key="DataGridTextCellStyle" TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryColor}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryColor}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="★"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource PrimaryColor}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{DynamicResource Column_Service}" Binding="{Binding ServiceName}" Width="2*"
                                               ElementStyle="{StaticResource DataGridTextCellStyle}"
                                               EditingElementStyle="{StaticResource DataGridTextCellStyle}"/>
                            <DataGridTextColumn Header="{DynamicResource Column_Username}" Binding="{Binding Username}" Width="*"
                                               ElementStyle="{StaticResource DataGridTextCellStyle}"
                                               EditingElementStyle="{StaticResource DataGridTextCellStyle}"/>
                            <DataGridTextColumn Header="{DynamicResource Column_Email}" Binding="{Binding Email}" Width="*"
                                               ElementStyle="{StaticResource DataGridTextCellStyle}"
                                               EditingElementStyle="{StaticResource DataGridTextCellStyle}"/>
                            <DataGridTextColumn Header="{DynamicResource Column_Type}" Binding="{Binding AccountType}" Width="*"
                                               ElementStyle="{StaticResource DataGridTextCellStyle}"
                                               EditingElementStyle="{StaticResource DataGridTextCellStyle}"/>
                            <DataGridTextColumn Header="{DynamicResource Column_UrlPath}" Width="2*">
                                <DataGridTextColumn.Binding>
                                    <PriorityBinding>
                                        <Binding Path="Url"/>
                                        <Binding Path="ApplicationPath"/>
                                    </PriorityBinding>
                                </DataGridTextColumn.Binding>
                                <DataGridTextColumn.ElementStyle>
                                    <StaticResource ResourceKey="DataGridTextCellStyle"/>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <StaticResource ResourceKey="DataGridTextCellStyle"/>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="{DynamicResource Column_Action}" Width="1.6*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Open Preview (eye) -->
                                            <Button Width="36" Height="36" Margin="0,0,8,0" Style="{StaticResource IconBtnStyle}"
                                                    ToolTip="{DynamicResource OpenAccountPreview}"
                                                    Click="OnOpenPreviewClick">
                                                <Viewbox Width="18" Height="18">
                                                    <Path Data="{StaticResource bx_eye}">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Setter Property="Fill" Value="{DynamicResource TextColor}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                                        <Setter Property="Fill" Value="{DynamicResource PrimaryColor}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                </Viewbox>
                                            </Button>
                                            <!-- Open action (website/app) -->
                                            <Button Style="{StaticResource IconBtnStyle}"
                                                    Command="{Binding DataContext.OpenAccountCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Margin="0">
                                                <Button.Content>
                                                    <Viewbox Width="18" Height="18">
                                                        <Path>
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Setter Property="Data" Value="{StaticResource bx_app}"/>
                                                                    <Setter Property="Fill" Value="{DynamicResource TextColor}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding AccountType}" Value="Website">
                                                                            <Setter Property="Data" Value="{StaticResource bx_open_in_browser}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                                            <Setter Property="Fill" Value="{DynamicResource PrimaryColor}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                    </Viewbox>
                                                </Button.Content>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Style="{StaticResource EmptyStatePanelStyle}"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <Path Data="{StaticResource bx_userAccount}"
                              Fill="{DynamicResource TextMutedColor}"
                              Width="48" Height="48" Stretch="Uniform"
                              Opacity="0.55" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <TextBlock Text="{DynamicResource Accounts_Empty}"
                                   Style="{StaticResource Text.SectionTitle}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Accounts_EmptyHint}"
                                   Style="{StaticResource Text.BodyMuted}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="GridViewContainer" Visibility="{Binding IsGridView, Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding FilteredAccounts}"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="240" Height="188"
                                            Margin="8"
                                            Padding="12"
                                            Cursor="Hand"
                                            Style="{StaticResource CardStyle}"
                                            MouseLeftButtonUp="OnGridCardClicked"
                                            MouseLeftButtonDown="OnGridCardMouseDown">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                                <TextBlock Text="{Binding ServiceName}"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource TextColor}"
                                                           TextWrapping="Wrap"
                                                           MaxWidth="180"/>
                                                <TextBlock Text="★"
                                                           Margin="6,0,0,0"
                                                           Foreground="{DynamicResource PrimaryColor}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding AccountType}"
                                                       Foreground="{DynamicResource PrimaryColor}"
                                                       FontSize="11"
                                                       Margin="0,4,0,0"/>

                                            <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                                <TextBlock Text="{Binding Username}"
                                                           Foreground="{DynamicResource SubTextColor}"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Email}"
                                                           Foreground="{DynamicResource SubTextColor}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="3"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        Margin="0,8,0,0">
                                                <Button Width="36" Height="36"
                                                        Style="{StaticResource IconBtnStyle}"
                                                        ToolTip="{DynamicResource OpenAccountPreview}"
                                                        Click="OnOpenPreviewClick"
                                                        Tag="{Binding}">
                                                    <Viewbox Width="16" Height="16">
                                                        <Path Data="{StaticResource bx_eye}"
                                                              Fill="{DynamicResource TextColor}"/>
                                                    </Viewbox>
                                                </Button>
                                                <Button Width="36" Height="36"
                                                        Margin="6,0,0,0"
                                                        Style="{StaticResource IconBtnStyle}"
                                                        ToolTip="{DynamicResource CopyBtnTitle}"
                                                        Click="OnGridCopyPasswordClick">
                                                    <Viewbox Width="16" Height="16">
                                                        <Path Data="{StaticResource bx_copy}"
                                                              Fill="{DynamicResource TextColor}"/>
                                                    </Viewbox>
                                                </Button>
                                                <Button Width="36" Height="36"
                                                        Margin="6,0,0,0"
                                                        Style="{StaticResource IconBtnStyle}"
                                                        Command="{Binding DataContext.OpenAccountCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="{DynamicResource AccountsActionOpenWebsite}">
                                                    <Viewbox Width="16" Height="16">
                                                        <Path Data="{StaticResource bx_open_in_browser}"
                                                              Fill="{DynamicResource TextColor}"/>
                                                    </Viewbox>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Style="{StaticResource EmptyStatePanelStyle}"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <Path Data="{StaticResource bx_userAccount}"
                              Fill="{DynamicResource TextMutedColor}"
                              Width="48" Height="48" Stretch="Uniform"
                              Opacity="0.55" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <TextBlock Text="{DynamicResource Accounts_Empty}"
                                   Style="{StaticResource Text.SectionTitle}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Accounts_EmptyHint}"
                                   Style="{StaticResource Text.BodyMuted}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
        </Grid>
    </Grid>
</Page>
