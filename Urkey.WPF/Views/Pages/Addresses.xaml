<Page x:Class="Urkey.WPF.Views.Pages.Addresses"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:uc="clr-namespace:Urkey.WPF.UserControls"
      Title="{DynamicResource AddressesTitle}"
      Foreground="{DynamicResource TextColor}"
      Background="{DynamicResource BgColor}"
      FlowDirection="{DynamicResource AppFlowDirection}"
      Loaded="OnPageLoaded">

    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="{StaticResource PageHeaderMargin}">
            <TextBlock Text="{DynamicResource AddressesTitle}"
                       Style="{StaticResource Text.PageTitle}"
                       VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource AddButton}"
                        Command="{Binding AddCommand}"
                        Style="{StaticResource PrimaryBtnStyle}"
                        Margin="0,0,8,0"/>
                <Button Content="{DynamicResource EditButton}"
                        Command="{Binding EditCommand}"
                        Style="{StaticResource SecondaryBtnStyle}"
                        Margin="0,0,8,0"/>
                <Button Content="{DynamicResource DeleteButton}"
                        Command="{Binding DeleteCommand}"
                        Style="{StaticResource SecondaryBtnStyle}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <ListBox ItemsSource="{Binding Items}"
                     SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                     BorderThickness="0"
                     Background="Transparent"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource EntryListBoxItemStyle}">
                <ListBox.Style>
                    <Style TargetType="ListBox">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsListView}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Style>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Viewbox Width="{StaticResource IconSizeLG}"
                                     Height="{StaticResource IconSizeLG}"
                                     Margin="0,0,14,0"
                                     VerticalAlignment="Top">
                                <Path Data="{StaticResource bx_address}"
                                      Fill="{DynamicResource PrimaryColor}"
                                      Stretch="Uniform"/>
                            </Viewbox>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           FontSize="{StaticResource FontSizeSubtitle}"
                                           Foreground="{DynamicResource TextColor}"/>
                                <TextBlock Style="{StaticResource Text.BodyMuted}" Margin="0,6,0,0" TextWrapping="Wrap">
                                    <Run Text="{Binding Street}"/>
                                    <Run Text=", "/>
                                    <Run Text="{Binding City}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Country}"
                                           Style="{StaticResource Text.Caption}"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsGridView}" Value="True"/>
                                    <Condition Binding="{Binding IsEmpty}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource EntryTileStyle}"
                                    MouseLeftButtonUp="OnTileClicked">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               FontSize="{StaticResource FontSizeSubtitle}"
                                               Foreground="{DynamicResource TextColor}"/>
                                    <Border Margin="0,12,0,0"
                                            Padding="12"
                                            CornerRadius="{StaticResource ControlCornerRadius}"
                                            Background="{DynamicResource ElevatedBgColor}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap">
                                                <Run Text="{Binding Street}"/>
                                                <Run Text=", "/>
                                                <Run Text="{Binding City}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Country}"
                                                       Style="{StaticResource Text.Caption}"
                                                       Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <uc:EmptyState IconData="{StaticResource bx_address}"
                           Title="{DynamicResource Addresses_Empty}"
                           Hint="{DynamicResource Addresses_EmptyHint}"
                           ActionText="{DynamicResource AddButton}"
                           ActionCommand="{Binding AddCommand}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>
    </Grid>
</Page>
