<Page x:Class="Urkey.WPF.Views.Pages.AllEntries"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:uc="clr-namespace:Urkey.WPF.UserControls"
      Title="{DynamicResource AllEntriesTitle}"
      Foreground="{DynamicResource TextColor}"
      Background="{DynamicResource BgColor}"
      FlowDirection="{DynamicResource AppFlowDirection}"
      Loaded="OnPageLoaded">

    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="{StaticResource PageHeaderMargin}" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <ComboBox MinWidth="160"
                          Height="40"
                          Margin="0,0,12,0"
                          VerticalAlignment="Center"
                          VerticalContentAlignment="Center"
                          Style="{StaticResource FilterComboBoxStyle}"
                          SelectedIndex="{Binding SelectedTypeFilterIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{DynamicResource Filter_AllTypes}" Tag="all"/>
                    <ComboBoxItem Content="{DynamicResource AccountType}" Tag="account"/>
                    <ComboBoxItem Content="{DynamicResource AccountTypeBankCard}" Tag="card"/>
                    <ComboBoxItem Content="{DynamicResource AccountTypeAddress}" Tag="address"/>
                    <ComboBoxItem Content="{DynamicResource AccountTypeDocument}" Tag="document"/>
                    <ComboBoxItem Content="{DynamicResource AccountTypeNote}" Tag="note"/>
                </ComboBox>

                <uc:EntryTypesDropdown x:Name="AddDropdown"
                                       VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource AllEntriesTitle}"
                           Style="{StaticResource Text.PageTitle}"/>
                <TextBlock Text="{DynamicResource AllEntries_Subtitle}"
                           Style="{StaticResource Text.BodyMuted}"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <DataGrid ColumnHeaderStyle="{StaticResource VaultDataGridColumnHeaderStyle}"
                      RowStyle="{StaticResource VaultDataGridRowStyle}"
                      IsReadOnly="True"
                      ItemsSource="{Binding FilteredEntries}"
                      SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      FlowDirection="{DynamicResource AppFlowDirection}"
                      MouseDoubleClick="OnRowDoubleClick">
                <DataGrid.Style>
                    <Style TargetType="DataGrid" BasedOn="{StaticResource VaultDataGridStyle}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsListView}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Style>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource Column_Service}"
                                        Binding="{Binding Title}"
                                        Width="2*"/>
                    <DataGridTextColumn Header="{DynamicResource Column_Username}"
                                        Binding="{Binding Username}"
                                        Width="*"/>
                    <DataGridTextColumn Header="{DynamicResource Column_Email}"
                                        Binding="{Binding Email}"
                                        Width="*"/>
                    <DataGridTextColumn Header="{DynamicResource Column_Type}"
                                        Binding="{Binding TypeDisplay}"
                                        Width="*"/>
                    <DataGridTextColumn Header="{DynamicResource Column_UrlPath}"
                                        Binding="{Binding UrlOrPath}"
                                        Width="2*"/>
                    <DataGridTemplateColumn Header="{DynamicResource Column_Action}" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="{DynamicResource EditButton}"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            Style="{StaticResource SecondaryBtnStyle}"
                                            Padding="8,4"
                                            Margin="0,0,4,0"
                                            FontSize="{StaticResource FontSizeCaption}"
                                            MinWidth="0"/>
                                    <Button Content="{DynamicResource DeleteButton}"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            Style="{StaticResource SecondaryBtnStyle}"
                                            Padding="8,4"
                                            FontSize="{StaticResource FontSizeCaption}"
                                            MinWidth="0"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsGridView}" Value="True"/>
                                    <Condition Binding="{Binding IsEmpty}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <ItemsControl ItemsSource="{Binding FilteredEntries}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource EntryTileStyle}"
                                    MouseLeftButtonUp="OnTileClicked"
                                    MouseLeftButtonDown="OnTileMouseDown">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold"
                                               FontSize="{StaticResource FontSizeSubtitle}"
                                               Foreground="{DynamicResource TextColor}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding TypeDisplay}"
                                               Style="{StaticResource Text.Caption}"
                                               Foreground="{DynamicResource PrimaryColor}"
                                               Margin="0,4,0,0"/>
                                    <StackPanel Grid.Row="2" Margin="0,10,0,10">
                                        <TextBlock Text="{Binding Username}"
                                                   Style="{StaticResource Text.Caption}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}"
                                                   Style="{StaticResource Text.Caption}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="{DynamicResource EditButton}"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                Style="{StaticResource SecondaryBtnStyle}"
                                                Padding="8,4"
                                                Margin="0,0,6,0"
                                                FontSize="{StaticResource FontSizeCaption}"
                                                MinWidth="0"
                                                Click="OnTileActionClick"/>
                                        <Button Content="{DynamicResource DeleteButton}"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                Style="{StaticResource SecondaryBtnStyle}"
                                                Padding="8,4"
                                                FontSize="{StaticResource FontSizeCaption}"
                                                MinWidth="0"
                                                Click="OnTileActionClick"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <uc:EmptyState IconData="{StaticResource bx_app}"
                           Title="{DynamicResource AllEntries_Empty}"
                           Hint="{DynamicResource AllEntries_EmptyHint}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>
    </Grid>
</Page>
