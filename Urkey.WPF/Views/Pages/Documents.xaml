<Page x:Class="Urkey.WPF.Views.Pages.Documents"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:Urkey.WPF.ViewModels"
      xmlns:uc="clr-namespace:Urkey.WPF.UserControls"
      xmlns:converters="clr-namespace:Urkey.WPF.Converters"
      Height="670"
      Title="{DynamicResource DocumentsTitle}"
      Loaded="OnPageLoaded"
      Background="{DynamicResource BgColor}"
      Foreground="{DynamicResource TextColor}"
      FlowDirection="{DynamicResource AppFlowDirection}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:DocumentThumbnailConverter x:Key="ThumbnailConverter"/>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource HoverColor}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="{StaticResource PageMarginCompact}">
        <!-- LIST VIEW: master-detail -->
        <Grid Visibility="{Binding IsListView, Converter={StaticResource BoolToVis}}">
        <Grid.ColumnDefinitions>
            <!-- Document List Column -->
            <ColumnDefinition Width="320" MinWidth="280" MaxWidth="420"/>
            <!-- Splitter -->
            <ColumnDefinition Width="Auto"/>
            <!-- Preview Column -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Document List Panel -->
        <Border Grid.Column="0" 
                BorderBrush="{DynamicResource BorderColor}" 
                BorderThickness="0,0,1,0"
                Background="Transparent">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                

                <!-- Header + actions -->
                <DockPanel Grid.Row="0"
                           Margin="16,16,16,8"
                           LastChildFill="True">
                    <StackPanel DockPanel.Dock="Bottom"
                                Orientation="Horizontal"
                                Margin="0,10,0,0">
                        <Button Content="{DynamicResource AddDocumentButton}"
                                Command="{Binding AddCommand}"
                                Style="{DynamicResource PrimaryBtnStyle}"
                                Margin="0,0,8,0"
                                Padding="12,8"/>
                        <Button Command="{Binding ReloadCommand}"
                                Padding="12,8"
                                Style="{DynamicResource SecondaryBtnStyle}"
                                ToolTip="{DynamicResource ReloadButton}">
                            <TextBlock Text="{DynamicResource ReloadButton}" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource DocumentsTitle}"
                               Style="{StaticResource Text.PageTitle}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextColor}"/>
                </DockPanel>

                <!-- Security Warning -->
                <Border Grid.Row="1"
                       Margin="16,0,16,10"
                       Padding="12"
                       Background="{DynamicResource WarningBgColor}"
                       BorderBrush="{DynamicResource WarningBorderColor}"
                       BorderThickness="1"
                       CornerRadius="4"
                       Visibility="{Binding ShowSecurityWarning, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                  TextWrapping="Wrap"
                                  Foreground="{DynamicResource WarningTextColor}"
                                  Style="{StaticResource Text.BodyMuted}"
                                  Text="{DynamicResource SecurityWarningMessage}"/>
                        <Button Grid.Column="1"
                               Content="✕"
                               Command="{Binding DismissWarningCommand}"
                               Background="Transparent"
                               BorderThickness="0"
                               Foreground="{DynamicResource WarningTextColor}"
                               Padding="4"
                               FontSize="14"
                               Cursor="Hand"
                               Margin="8,0,0,0"/>
                    </Grid>
                </Border>

                <!-- Documents List -->
                <Grid Grid.Row="2">
                <ListBox ItemsSource="{Binding Documents}"
                        SelectedItem="{Binding SelectedDocument, Mode=TwoWay}"
                        Style="{StaticResource SidebarListBoxStyle}"
                        Margin="0"
                        Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
                    <ListBox.ItemContainerStyle>
                        <StaticResource ResourceKey="SidebarListBoxItemStyle"/>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border
                                  Margin="0,0,0,0" 
                                  Padding="12"
                                  CornerRadius="4"
                                  Cursor="Hand"
                                  BorderThickness="0"
                                  HorizontalAlignment="Stretch">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Background}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource InputBgColor}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryColor}"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True"/>
                                                    <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="{DynamicResource HoverColor}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryColor}"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel 
                                        Grid.Column="0" 
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Name}" 
                                                 FontSize="16" 
                                                 FontWeight="SemiBold"
                                                 Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                                                 Margin="0,0,0,4"
                                                 Cursor="Hand"/>
                                        <TextBlock FontSize="12" 
                                                 Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                                                 Cursor="Hand">
                                            <Run Text="{DynamicResource DocumentType}"/>
                                            <Run Text=" ("/>
                                            <Run Text="{Binding ExpiryDate, Converter={StaticResource LocaleDate}, ConverterParameter=d, FallbackValue=''}"/>
                                            <Run Text=")"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                           Width="60"
                                           Height="60"
                                           Background="{DynamicResource InputBgColor}"
                                           BorderBrush="{DynamicResource BorderColor}"
                                           BorderThickness="1"
                                           CornerRadius="4"
                                           Cursor="Hand">
                                        <Image Source="{Binding Converter={StaticResource ThumbnailConverter}}"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Cursor="Hand">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Converter={StaticResource ThumbnailConverter}}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                    <uc:EmptyState IconData="{StaticResource bx_doc}"
                                   Title="{DynamicResource Documents_Empty}"
                                   Hint="{DynamicResource Documents_EmptyHint}"
                                   ActionText="{DynamicResource AddDocumentButton}"
                                   ActionCommand="{Binding AddCommand}"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Splitter removed to lock sidebar width -->

        <!-- Preview Panel -->
        <Border Grid.Column="2" 
               Background="Transparent"
               CornerRadius="20"
               Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Preview Header -->
                <Border Grid.Row="0" 
                       Padding="20,0"
                       BorderBrush="{DynamicResource BorderColor}" 
                       BorderThickness="0,0,0,1"
                       MinHeight="64"
                       VerticalAlignment="Center">
                    <Border.Resources>
                        <Style x:Key="CircularButtonStyle" TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Width" Value="44"/>
                            <Setter Property="Height" Value="44"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                               CornerRadius="22"
                                               Width="{TemplateBinding Width}"
                                               Height="{TemplateBinding Height}">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource HoverColor}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Resources>
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Selected Document Name  -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock FontSize="18" 
                                     FontWeight="Bold"
                                     TextTrimming="CharacterEllipsis"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource TextColor}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding SelectedDocument.Name}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedDocument}" Value="{x:Null}">
                                                <Setter Property="Text" Value="{DynamicResource SelectDocumentToPreview}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextMutedColor}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="FontSize" Value="16"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            
                            <TextBlock FontSize="12"
                                     Foreground="{DynamicResource TextMutedColor}"
                                     Margin="0,4,0,0"
                                     VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding SelectedDocument.Type}"/>
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedDocument}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource CircularButtonStyle}"
                                   Margin="0,0,8,0"
                                   ToolTip="{DynamicResource FavoriteButton}">
                                <Path Data="{StaticResource bx_favorite}">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Fill" Value="{DynamicResource TextColor}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource PrimaryColor}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Button>
                            <Button Style="{StaticResource CircularButtonStyle}"
                                   Margin="0,0,8,0"
                                   ToolTip="{DynamicResource EditButton}"
                                   Command="{Binding EditCommand}"
                                   CommandParameter="{Binding SelectedDocument}">
                                <Path Data="{StaticResource bx_edit}">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Fill" Value="{DynamicResource TextColor}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource PrimaryColor}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Button>
                            <Button x:Name="MoreOptionsButton"
                                   Style="{StaticResource CircularButtonStyle}"
                                   ToolTip="{DynamicResource MoreOptionsButton}"
                                   Click="ToggleMoreOptionsMenu">
                                <Path Data="{StaticResource bx_show_more}">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Fill" Value="{DynamicResource TextColor}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource PrimaryColor}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- More Options Popup -->
                <Popup x:Name="MoreOptionsPopup"
                       PlacementTarget="{Binding ElementName=MoreOptionsButton}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True">
                    <Grid>
                        <Rectangle Fill="{DynamicResource CardBgColor}"
                                   RadiusX="8"
                                   RadiusY="8"
                                   Stroke="{DynamicResource BorderColor}"
                                   StrokeThickness="1"/>
                        <Border Background="Transparent"
                                CornerRadius="8"
                                Padding="8"
                                MinWidth="150">
                            <StackPanel>
                                <Button Command="{Binding DownloadCommand}"
                                        CommandParameter="{Binding SelectedDocument}"
                                        Style="{StaticResource MenuButtonStyle}"
                                        Foreground="{DynamicResource TextColor}"
                                        HorizontalContentAlignment="Left"
                                        Padding="12,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource bx_save}" 
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Width="16" Height="16"
                                              Margin="0,0,8,0"/>
                                        <TextBlock Text="{DynamicResource DownloadButton}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding DeleteCommand}"
                                        CommandParameter="{Binding SelectedDocument}"
                                        Style="{StaticResource MenuButtonStyle}"
                                        Foreground="{DynamicResource ErrorColor}"
                                        HorizontalContentAlignment="Left"
                                        Padding="12,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource bx_delete}" 
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Width="16" Height="16"
                                              Margin="0,0,8,0"/>
                                        <TextBlock Text="{DynamicResource DeleteButton}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="ShowDetails_Click"
                                        Style="{StaticResource MenuButtonStyle}"
                                        Foreground="{DynamicResource TextColor}"
                                        HorizontalContentAlignment="Left"
                                        Padding="12,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource bx_app}" 
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Width="16" Height="16"
                                              Margin="0,0,8,0"/>
                                        <TextBlock Text="Details" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Popup>

                

                <!-- Preview Image — dark KPM-style viewer frame -->
                <Border x:Name="PreviewImageContainer"
                       Grid.Row="1" 
                       Background="#1E2128"
                       CornerRadius="0,0,12,12"
                       Cursor="Hand">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                                     VerticalScrollBarVisibility="Auto"
                                     Background="Transparent">
                            <Grid HorizontalAlignment="Center" 
                                 VerticalAlignment="Center"
                                 Margin="24">
                                <Border Background="#2A2E36"
                                        CornerRadius="4"
                                        Padding="8">
                                    <Image Source="{Binding PreviewImage}"
                                          Stretch="Uniform"
                                          MaxWidth="640"
                                          MaxHeight="520"
                                          RenderTransformOrigin="0.5,0.5"
                                          Cursor="Hand"
                                          MouseLeftButtonDown="PreviewImage_MouseLeftButtonDown">
                                        <Image.LayoutTransform>
                                            <ScaleTransform ScaleX="{Binding ZoomLevel}"
                                                            ScaleY="{Binding ZoomLevel}"/>
                                        </Image.LayoutTransform>
                                    </Image>
                                </Border>
                            </Grid>
                        </ScrollViewer>

                        <!-- Zoom toolbar -->
                        <Border HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,16"
                                Padding="8,6"
                                CornerRadius="20"
                                Background="#99000000">
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding ZoomOutCommand}"
                                        Style="{StaticResource IconBtnStyle}" Width="32" Height="32" Margin="0,0,4,0"
                                        ToolTip="{DynamicResource ZoomOutButton}">
                                    <Viewbox Width="16" Height="16">
                                        <Path Data="{StaticResource bx_minus}" Fill="White" Stretch="Uniform"/>
                                    </Viewbox>
                                </Button>
                                <Button Command="{Binding ZoomResetCommand}"
                                        Style="{StaticResource IconBtnStyle}" Width="32" Height="32" Margin="0,0,4,0"
                                        ToolTip="{DynamicResource ZoomResetButton}">
                                    <Viewbox Width="16" Height="16">
                                        <Path Data="{StaticResource bx_search}" Fill="White" Stretch="Uniform"/>
                                    </Viewbox>
                                </Button>
                                <Button Command="{Binding ZoomInCommand}"
                                        Style="{StaticResource IconBtnStyle}" Width="32" Height="32"
                                        ToolTip="{DynamicResource ZoomInButton}">
                                    <Viewbox Width="16" Height="16">
                                        <Path Data="{StaticResource bx_plus}" Fill="White" Stretch="Uniform"/>
                                    </Viewbox>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                

                <!-- Empty State -->
                <Border Grid.Row="1"
                        Background="Transparent"
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Stretch">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{DynamicResource SelectDocumentToPreview}"
                              FontSize="16"
                              Foreground="{DynamicResource SecondaryTextColor}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
        </Grid><!-- end list layout -->

        <!-- GRID VIEW -->
        <Grid Visibility="{Binding IsGridView, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="{StaticResource PageHeaderMargin}">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{DynamicResource AddDocumentButton}"
                            Command="{Binding AddCommand}"
                            Style="{StaticResource PrimaryBtnStyle}"
                            Margin="0,0,8,0"/>
                    <Button Command="{Binding ReloadCommand}"
                            Content="{DynamicResource ReloadButton}"
                            Style="{StaticResource SecondaryBtnStyle}"/>
                </StackPanel>
                <TextBlock Text="{DynamicResource DocumentsTitle}"
                           Style="{StaticResource Text.PageTitle}"
                           VerticalAlignment="Center"/>
            </DockPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding Documents}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource EntryTileStyle}"
                                    Width="280"
                                    MinHeight="220"
                                    MouseLeftButtonUp="OnDocumentTileClicked">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               FontSize="{StaticResource FontSizeSubtitle}"
                                               Foreground="{DynamicResource TextColor}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Row="1"
                                            Margin="0,10,0,10"
                                            Background="{DynamicResource ElevatedBgColor}"
                                            CornerRadius="{StaticResource ControlCornerRadius}"
                                            MinHeight="100">
                                        <Image Source="{Binding Converter={StaticResource ThumbnailConverter}}"
                                               Stretch="Uniform"
                                               Margin="8"/>
                                    </Border>
                                    <TextBlock Grid.Row="2"
                                               Text="{Binding Type}"
                                               Style="{StaticResource Text.Caption}"
                                               Margin="0,0,0,10"/>
                                    <Button Grid.Row="3"
                                            Content="{DynamicResource OpenAccountPreview}"
                                            Command="{Binding DataContext.PreviewCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource SecondaryBtnStyle}"
                                            HorizontalAlignment="Stretch"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <uc:EmptyState Grid.Row="1"
                           IconData="{StaticResource bx_doc}"
                           Title="{DynamicResource Documents_Empty}"
                           Hint="{DynamicResource Documents_EmptyHint}"
                           ActionText="{DynamicResource AddDocumentButton}"
                           ActionCommand="{Binding AddCommand}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>
    </Grid>
</Page>
