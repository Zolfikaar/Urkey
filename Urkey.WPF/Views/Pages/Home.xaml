<Page x:Class="Urkey.WPF.Views.Pages.Home"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:uc="clr-namespace:Urkey.WPF.UserControls"
      Title="{DynamicResource HomeTitle}"
      Foreground="{DynamicResource TextColor}"
      Background="{DynamicResource BgColor}"
      FlowDirection="{DynamicResource AppFlowDirection}"
      Loaded="OnPageLoaded">

    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="{StaticResource PageHeaderMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{DynamicResource HomeTitle}"
                       Style="{StaticResource Text.PageTitle}"/>

            <uc:EntryTypesDropdown x:Name="AddDropdown" Grid.Column="1"/>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <Border Style="{StaticResource CardStyle}"
                        Margin="{StaticResource SectionSpacing}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource WelcomeHomeText}"
                                   Style="{StaticResource Text.CardTitle}"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="{DynamicResource WelcomeSubtitle}"
                                   Style="{StaticResource Text.BodyMuted}"/>
                    </StackPanel>
                </Border>

                <UniformGrid Columns="3"
                             Margin="{StaticResource SectionSpacing}">

                    <Border Style="{StaticResource StatCardStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="{StaticResource bx_passwords}"
                                  Fill="{DynamicResource PrimaryColor}"
                                  Width="28"
                                  Height="28"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,12"/>
                            <TextBlock Text="{Binding PasswordsTotalText}"
                                       Style="{StaticResource Text.StatValue}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{DynamicResource PasswordsTotal}"
                                       Style="{StaticResource Text.Caption}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource StatCardStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="{StaticResource bx_lock}"
                                  Fill="{DynamicResource PrimaryColor}"
                                  Width="28"
                                  Height="28"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,12"/>
                            <TextBlock Text="{Binding VaultsTotalText}"
                                       Style="{StaticResource Text.StatValue}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{DynamicResource VaultsTotal}"
                                       Style="{StaticResource Text.Caption}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource StatCardStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="{StaticResource bx_check}"
                                  Fill="{DynamicResource AccentGold}"
                                  Width="28"
                                  Height="28"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,12"/>
                            <TextBlock Text="{Binding SecurityScoreText}"
                                       Style="{StaticResource Text.StatValue}"
                                       Foreground="{DynamicResource AccentGold}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{DynamicResource SecurityPoints}"
                                       Style="{StaticResource Text.Caption}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource RecentActivityTitle}"
                                   Style="{StaticResource Text.SectionTitle}"
                                   Margin="0,0,0,16"/>

                        <ItemsControl ItemsSource="{Binding RecentActivity}"
                                      Visibility="{Binding HasActivity, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Text}"
                                                       Style="{StaticResource Text.Body}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding TimestampText}"
                                                       Style="{StaticResource Text.Caption}"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel HorizontalAlignment="Center"
                                    Margin="0,12"
                                    Visibility="{Binding IsActivityEmpty, Converter={StaticResource BoolToVisibility}}">
                            <Path Data="{StaticResource bx_notes}"
                                  Fill="{DynamicResource TextMutedColor}"
                                  Width="40"
                                  Height="40"
                                  Stretch="Uniform"
                                  Opacity="0.55"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,12"/>
                            <TextBlock Text="{DynamicResource RecentActivityEmpty}"
                                       Style="{StaticResource Text.BodyMuted}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
