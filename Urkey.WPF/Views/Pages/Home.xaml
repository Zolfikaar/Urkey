<Page x:Class="Urkey.WPF.Views.Pages.Home"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Urkey.WPF.Views.Pages"
      mc:Ignorable="d"
      Title="{DynamicResource HomeTitle}"
      Foreground="{DynamicResource TextColor}">

    <Border
        Margin="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Page Header -->
            <Border Grid.Row="0"
                    Background="Transparent"
                    Margin="30,30,30,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{DynamicResource HomeTitle}"
                               FontSize="24"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>

                    <Grid Grid.Column="1">
                        <Button x:Name="AddButton"
                                Content="{DynamicResource AddButton}"
                                Background="{DynamicResource PrimaryColor}"
                                Foreground="White"
                                FontWeight="Bold"
                                Padding="16,10"
                                Click="ToggleMenu"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="8"
                                            Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center">
                                            <Path Data="{StaticResource bx_plus}"
                                                  Fill="White"
                                                  Margin="0,0,6,0"/>
                                            <TextBlock Text="{TemplateBinding Content}"
                                                       VerticalAlignment="Center"/>
                                            <Path Data="M0,0 L6,6 L12,0 Z"
                                                  Fill="White"
                                                  Width="10"
                                                  Height="6"
                                                  Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Popup x:Name="AddMenuPopup"
                               PlacementTarget="{Binding ElementName=AddButton}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True">
                            <Grid>
                                <Rectangle Fill="{DynamicResource CardBgColor}"
                                           RadiusX="8"
                                           RadiusY="8"
                                           Stroke="{DynamicResource BorderColor}"
                                           StrokeThickness="1"/>
                                <Border Background="Transparent"
                                        CornerRadius="8"
                                        Padding="8"
                                        MinWidth="170">
                                    <StackPanel>
                                        <StackPanel.Resources>
                                            <Style x:Key="MenuButtonStyle"
                                                   TargetType="Button">
                                                <Setter Property="Background"
                                                        Value="Transparent"/>
                                                <Setter Property="BorderThickness"
                                                        Value="0"/>
                                                <Setter Property="Cursor"
                                                        Value="Hand"/>
                                                <Setter Property="HorizontalContentAlignment"
                                                        Value="Left"/>
                                                <Setter Property="Padding"
                                                        Value="12,8"/>
                                                <Setter Property="Margin"
                                                        Value="2"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    CornerRadius="4"
                                                                    Padding="{TemplateBinding Padding}"
                                                                    TextElement.Foreground="{TemplateBinding Foreground}">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver"
                                                                         Value="True">
                                                                    <Setter Property="Background"
                                                                            Value="{DynamicResource HoverColor}"/>
                                                                    <Setter Property="Foreground"
                                                                            Value="{DynamicResource PrimaryColor}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </StackPanel.Resources>
                                        <Button Click="OnAddAccount_Click"
                                                Style="{StaticResource MenuButtonStyle}"
                                                Foreground="{DynamicResource TextColor}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource bx_userAccount}"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      Width="20"
                                                      Height="20"
                                                      Margin="0,0,12,0"/>
                                                <TextBlock Text="{DynamicResource AccountsTitle}"
                                                           FontSize="14"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Click="OnAddBankCard_Click"
                                                Style="{StaticResource MenuButtonStyle}"
                                                Foreground="{DynamicResource TextColor}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource bx_credit_card}"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      Width="20"
                                                      Height="20"
                                                      Margin="0,0,12,0"/>
                                                <TextBlock Text="{DynamicResource BankCardsTitle}"
                                                           FontSize="14"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Click="OnAddDocument_Click"
                                                Style="{StaticResource MenuButtonStyle}"
                                                Foreground="{DynamicResource TextColor}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource bx_doc}"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      Width="20"
                                                      Height="20"
                                                      Margin="0,0,12,0"/>
                                                <TextBlock Text="{DynamicResource DocsTitle}"
                                                           FontSize="14"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Click="OnAddAddress_Click"
                                                Style="{StaticResource MenuButtonStyle}"
                                                Foreground="{DynamicResource TextColor}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource bx_address}"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      Width="20"
                                                      Height="20"
                                                      Margin="0,0,12,0"/>
                                                <TextBlock Text="{DynamicResource AddressesTitle}"
                                                           FontSize="14"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Click="OnAddNote_Click"
                                                Style="{StaticResource MenuButtonStyle}"
                                                Foreground="{DynamicResource TextColor}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource bx_notes}"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      Width="20"
                                                      Height="20"
                                                      Margin="0,0,12,0"/>
                                                <TextBlock Text="{DynamicResource NotesTitle}"
                                                           FontSize="14"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>




                </Grid>
            </Border>

            <!-- Main Content -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Margin="30,0,30,30">
                <StackPanel>
                    <!-- Welcome Section -->
                    <Border
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,20"
                        Style="{StaticResource CardStyle}">
                        <Border.Effect>
                            <DropShadowEffect
                                Color="#03000000"
                                Direction="270"
                                ShadowDepth="7"
                                BlurRadius="25"
                                Opacity=".2"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource WelcomeHomeText}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>
                            <TextBlock Text="{DynamicResource WelcomeSubtitle}"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextColor}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Quick Stats -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Total Passwords Card -->
                        <Border Grid.Column="0"
                                CornerRadius="8"
                                Margin="0,0,10,0"
                                BorderThickness="1"
                                Style="{StaticResource CardStyle}">
                            <Border.Effect>
                                <DropShadowEffect
                                    Color="#03000000"
                                    Direction="270"
                                    ShadowDepth="7"
                                    BlurRadius="25"
                                    Opacity=".2"/>
                            </Border.Effect>
                            <StackPanel Margin="20"
                                        HorizontalAlignment="Center">
                                <Path Data="M12 15l-3-3 3-3"
                                      Stroke="{StaticResource PrimaryColor}"
                                      StrokeThickness="2"
                                      Fill="Transparent"
                                      Width="24"
                                      Height="24"
                                      HorizontalAlignment="Center"
                                      Margin="0,0,0,10"/>
                                <TextBlock Text="0"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,5"/>
                                <TextBlock Text="{DynamicResource PasswordsTotal}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextColor}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Vaults Card -->
                        <Border Grid.Column="1"
                                CornerRadius="8"
                                Margin="5,0"
                                BorderThickness="1"
                                Style="{StaticResource CardStyle}">
                            <Border.Effect>
                                <DropShadowEffect
                                    Color="#03000000"
                                    Direction="270"
                                    ShadowDepth="7"
                                    BlurRadius="25"
                                    Opacity=".2"/>
                            </Border.Effect>
                            <StackPanel Margin="20"
                                        HorizontalAlignment="Center">
                                <Path Data="M4 7V4a2 2 0 012-2h8a2 2 0 012 2v3M4 7H2a2 2 0 00-2 2v9a2 2 0 002 2h16a2 2 0 002-2V9a2 2 0 00-2-2h-2M4 7v10a2 2 0 002 2h8a2 2 0 002-2V7"
                                      Stroke="{StaticResource PrimaryColor}"
                                      StrokeThickness="2"
                                      Fill="Transparent"
                                      Width="24"
                                      Height="24"
                                      HorizontalAlignment="Center"
                                      Margin="0,0,0,10"/>
                                <TextBlock Text="0"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,5"/>
                                <TextBlock Text="{DynamicResource VaultsTotal}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextColor}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Security Score Card -->
                        <Border Grid.Column="2"
                                CornerRadius="8"
                                Margin="10,0,0,0"
                                BorderThickness="1"
                                Style="{StaticResource CardStyle}">
                            <Border.Effect>
                                <DropShadowEffect
                                    Color="#03000000"
                                    Direction="270"
                                    ShadowDepth="7"
                                    BlurRadius="25"
                                    Opacity=".2"/>
                            </Border.Effect>
                            <StackPanel Margin="20"
                                        HorizontalAlignment="Center">
                                <Path Data="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                                      Stroke="{StaticResource PrimaryColor}"
                                      StrokeThickness="2"
                                      Fill="Transparent"
                                      Width="24"
                                      Height="24"
                                      HorizontalAlignment="Center"
                                      Margin="0,0,0,10"/>
                                <TextBlock Text="100%"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,5"/>
                                <TextBlock Text="{DynamicResource SecurityPoints}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextColor}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Recent Activity -->
                    <Border
                        CornerRadius="8"
                        BorderThickness="1"
                        Style="{StaticResource CardStyle}">
                        <Border.Effect>
                            <DropShadowEffect
                                Color="#03000000"
                                Direction="270"
                                ShadowDepth="7"
                                BlurRadius="25"
                                Opacity=".2"/>
                        </Border.Effect>
                        <StackPanel Margin="20">
                            <TextBlock Text="النشاط الأخير"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,15"/>

                            <TextBlock Text="لا يوجد نشاط حديث"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextColor}"
                                       HorizontalAlignment="Center"
                                       Margin="0,20"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Page>
