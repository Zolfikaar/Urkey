<Page x:Class="Urkey.WPF.Views.Pages.Notes"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="{DynamicResource NotesTitle}"
      Foreground="{DynamicResource TextColor}"
      Background="{DynamicResource BgColor}"
      FlowDirection="{DynamicResource AppFlowDirection}"
      Loaded="OnPageLoaded">

    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="{StaticResource PageHeaderMargin}">
            <TextBlock Text="{DynamicResource NotesTitle}"
                       Style="{StaticResource Text.PageTitle}"
                       VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource AddButton}"
                        Command="{Binding AddCommand}"
                        Style="{StaticResource PrimaryBtnStyle}"
                        Margin="0,0,8,0"/>
                <Button Content="{DynamicResource EditButton}"
                        Command="{Binding EditCommand}"
                        Style="{StaticResource SecondaryBtnStyle}"
                        Margin="0,0,8,0"/>
                <Button Content="{DynamicResource DeleteButton}"
                        Command="{Binding DeleteCommand}"
                        Style="{StaticResource SecondaryBtnStyle}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="8">
            <Grid>
                <ListBox ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         BorderThickness="0"
                         Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="4,6"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd"
                                                Background="{DynamicResource ElevatedBgColor}"
                                                BorderBrush="{DynamicResource BorderColor}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="16,14"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter HorizontalAlignment="Stretch"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverColor}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryColor}"/>
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowSelectedColor}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="4"
                                        CornerRadius="2"
                                        Background="{DynamicResource PrimaryColor}"
                                        Margin="0,2,12,2"
                                        Opacity="0.85"/>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold"
                                               FontSize="15"
                                               Foreground="{DynamicResource TextColor}"
                                               TextWrapping="Wrap"/>

                                    <Border HorizontalAlignment="Left"
                                            Margin="0,8,0,0"
                                            Padding="8,3"
                                            CornerRadius="8"
                                            Background="{DynamicResource InputBgColor}"
                                            BorderBrush="{DynamicResource BorderColor}"
                                            BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Category}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Category}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource PrimaryColor}"/>
                                    </Border>

                                    <TextBlock Text="{Binding Content}"
                                               Style="{StaticResource Text.BodyMuted}"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               MaxHeight="48"
                                               Margin="0,10,0,0"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           VerticalAlignment="Top"
                                           Margin="12,0,0,0"
                                           Style="{StaticResource Text.Caption}"
                                           Text="{Binding UpdatedAt, Converter={StaticResource LocaleDate}, ConverterParameter=g}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Style="{StaticResource EmptyStatePanelStyle}"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <Path Data="{StaticResource bx_notes}"
                          Fill="{DynamicResource TextMutedColor}"
                          Width="48" Height="48" Stretch="Uniform"
                          Opacity="0.55" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="{DynamicResource Notes_Empty}"
                               Style="{StaticResource Text.SectionTitle}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Notes_EmptyHint}"
                               Style="{StaticResource Text.BodyMuted}"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
