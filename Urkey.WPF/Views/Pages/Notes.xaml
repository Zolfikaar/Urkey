<Page x:Class="Urkey.WPF.Views.Pages.Notes"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:uc="clr-namespace:Urkey.WPF.UserControls"
      Title="{DynamicResource NotesTitle}"
      Foreground="{DynamicResource TextColor}"
      Background="{DynamicResource BgColor}"
      FlowDirection="{DynamicResource AppFlowDirection}"
      Loaded="OnPageLoaded">

    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="{StaticResource PageHeaderMargin}">
            <TextBlock Text="{DynamicResource NotesTitle}"
                       Style="{StaticResource Text.PageTitle}"
                       VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource AddButton}"
                        Command="{Binding AddCommand}"
                        Style="{StaticResource PrimaryBtnStyle}"
                        Margin="0,0,8,0"/>
                <Button Content="{DynamicResource EditButton}"
                        Command="{Binding EditCommand}"
                        Style="{StaticResource SecondaryBtnStyle}"
                        Margin="0,0,8,0"/>
                <Button Content="{DynamicResource DeleteButton}"
                        Command="{Binding DeleteCommand}"
                        Style="{StaticResource SecondaryBtnStyle}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <ListBox ItemsSource="{Binding Items}"
                     SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                     BorderThickness="0"
                     Background="Transparent"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ItemContainerStyle="{StaticResource EntryListBoxItemStyle}">
                <ListBox.Style>
                    <Style TargetType="ListBox">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsListView}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Style>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Viewbox Width="{StaticResource IconSizeLG}"
                                     Height="{StaticResource IconSizeLG}"
                                     Margin="0,0,14,0"
                                     VerticalAlignment="Top">
                                <Path Data="{StaticResource bx_notes}"
                                      Fill="{DynamicResource PrimaryColor}"
                                      Stretch="Uniform"/>
                            </Viewbox>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}"
                                           FontWeight="SemiBold"
                                           FontSize="{StaticResource FontSizeSubtitle}"
                                           Foreground="{DynamicResource TextColor}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Category}"
                                           Style="{StaticResource Text.Caption}"
                                           Foreground="{DynamicResource PrimaryColor}"
                                           Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding Content}"
                                           Style="{StaticResource Text.BodyMuted}"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           MaxHeight="40"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2"
                                       VerticalAlignment="Top"
                                       Margin="12,0,0,0"
                                       Style="{StaticResource Text.Caption}"
                                       Text="{Binding UpdatedAt, Converter={StaticResource LocaleDate}, ConverterParameter=g}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsGridView}" Value="True"/>
                                    <Condition Binding="{Binding IsEmpty}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource EntryTileStyle}"
                                    MouseLeftButtonUp="OnTileClicked">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold"
                                               FontSize="{StaticResource FontSizeSubtitle}"
                                               Foreground="{DynamicResource TextColor}"
                                               TextWrapping="Wrap"/>
                                    <Border Grid.Row="1"
                                            Margin="0,10,0,10"
                                            Padding="12"
                                            CornerRadius="{StaticResource ControlCornerRadius}"
                                            Background="{DynamicResource ElevatedBgColor}">
                                        <TextBlock Text="{Binding Content}"
                                                   Style="{StaticResource Text.Caption}"
                                                   TextWrapping="Wrap"
                                                   MaxHeight="64"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                    <TextBlock Grid.Row="2"
                                               Text="{Binding UpdatedAt, Converter={StaticResource LocaleDate}, ConverterParameter=g}"
                                               Style="{StaticResource Text.Caption}"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <uc:EmptyState IconData="{StaticResource bx_notes}"
                           Title="{DynamicResource Notes_Empty}"
                           Hint="{DynamicResource Notes_EmptyHint}"
                           ActionText="{DynamicResource AddButton}"
                           ActionCommand="{Binding AddCommand}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>
    </Grid>
</Page>
