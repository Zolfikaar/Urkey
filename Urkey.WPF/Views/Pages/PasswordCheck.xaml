<Page x:Class="Urkey.WPF.Views.Pages.PasswordCheck"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="{DynamicResource PasswordCheckTitle}"
      Foreground="{DynamicResource TextColor}"
      Background="{DynamicResource BgColor}"
      FlowDirection="{DynamicResource AppFlowDirection}"
      Loaded="OnPageLoaded">

    <Page.Resources>
        <!-- Shared issue/feature chip -->
        <DataTemplate x:Key="ChipTemplate">
            <Border Margin="0,0,6,6"
                    Padding="8,4"
                    CornerRadius="10"
                    Background="{DynamicResource InputBgColor}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1">
                <TextBlock Text="{Binding Text}"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedColor}"/>
            </Border>
        </DataTemplate>

        <!-- List / row card -->
        <DataTemplate x:Key="RowItemTemplate">
            <Border Margin="8,6"
                    Background="{DynamicResource ElevatedBgColor}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="0"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{Binding StrengthBrush}"
                            CornerRadius="10,0,0,10"/>

                    <Grid Grid.Column="1" Margin="14,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding ServiceName}"
                                           Style="{StaticResource Text.Body}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Username}"
                                           Style="{StaticResource Text.Caption}"
                                           Margin="0,3,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="{Binding StrengthBrush}"
                                    CornerRadius="12"
                                    Padding="10,4"
                                    VerticalAlignment="Top"
                                    Margin="12,0,0,0">
                                <TextBlock Text="{Binding StrengthText}"
                                           Foreground="White"
                                           FontSize="11"
                                           FontWeight="Bold"/>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ProgressBar Grid.Column="0"
                                         Height="8"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding StrengthPercent}"
                                         Foreground="{Binding StrengthBrush}"
                                         Background="{Binding StrengthTrackBrush}"
                                         BorderThickness="0">
                                <ProgressBar.Template>
                                    <ControlTemplate TargetType="ProgressBar">
                                        <Grid>
                                            <Border x:Name="PART_Track"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="4"
                                                    Height="{TemplateBinding Height}"/>
                                            <Border x:Name="PART_Indicator"
                                                    HorizontalAlignment="Left"
                                                    Background="{TemplateBinding Foreground}"
                                                    CornerRadius="4"
                                                    Height="{TemplateBinding Height}"/>
                                        </Grid>
                                    </ControlTemplate>
                                </ProgressBar.Template>
                            </ProgressBar>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding EntropyText}"
                                       Style="{StaticResource Text.Caption}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <ItemsControl Grid.Row="2"
                                      ItemsSource="{Binding FeatureTags}"
                                      ItemTemplate="{StaticResource ChipTemplate}"
                                      Margin="0,12,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <ItemsControl Grid.Row="3"
                                      ItemsSource="{Binding Chips}"
                                      ItemTemplate="{StaticResource ChipTemplate}"
                                      Margin="0,4,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Grid card -->
        <DataTemplate x:Key="GridItemTemplate">
            <Border Width="260"
                    MinHeight="168"
                    Margin="8"
                    Padding="14"
                    Background="{DynamicResource ElevatedBgColor}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="{Binding ServiceName}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextColor}"/>
                            <TextBlock Text="{Binding Username}"
                                       Style="{StaticResource Text.Caption}"
                                       Margin="0,4,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Column="1"
                                Background="{Binding StrengthBrush}"
                                CornerRadius="10"
                                Padding="8,3"
                                VerticalAlignment="Top">
                            <TextBlock Text="{Binding StrengthText}"
                                       Foreground="White"
                                       FontSize="10"
                                       FontWeight="Bold"/>
                        </Border>
                    </Grid>

                    <ProgressBar Grid.Row="1"
                                 Height="6"
                                 Margin="0,12,0,0"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding StrengthPercent}"
                                 Foreground="{Binding StrengthBrush}"
                                 Background="{Binding StrengthTrackBrush}"
                                 BorderThickness="0"/>

                    <ItemsControl Grid.Row="2"
                                  ItemsSource="{Binding FeatureTags}"
                                  ItemTemplate="{StaticResource ChipTemplate}"
                                  Margin="0,12,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <TextBlock Grid.Row="3"
                               Text="{Binding EntropyText}"
                               Style="{StaticResource Text.Caption}"
                               Margin="0,8,0,0"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="{StaticResource PageHeaderMargin}">
            <StackPanel>
                <TextBlock Text="{DynamicResource PasswordCheckTitle}"
                           Style="{StaticResource Text.PageTitle}"/>
                <TextBlock Text="{DynamicResource PasswordCheck_Subtitle}"
                           Style="{StaticResource Text.BodyMuted}"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top">
                <ToggleButton Content="{DynamicResource PasswordCheck_Filter_IssuesOnly}"
                              IsChecked="{Binding ShowIssuesOnly}"
                              Style="{StaticResource SecondaryToggleBtnStyle}"
                              Padding="12,6"
                              Margin="0,0,8,0"
                              Cursor="Hand"/>
                <Button Content="{DynamicResource ReloadButton}"
                        Command="{Binding ReloadCommand}"
                        Style="{StaticResource SecondaryBtnStyle}"
                        Padding="12,6"/>
            </StackPanel>
        </Grid>

        <!-- Summary stats -->
        <UniformGrid Grid.Row="1"
                     Columns="6"
                     Margin="0,0,0,12">
            <Border Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding CheckedCountText}"
                               Style="{StaticResource Text.StatValue}"
                               Foreground="{DynamicResource PrimaryColor}"/>
                    <TextBlock Text="{DynamicResource PasswordCheck_Stat_Checked}"
                               Style="{StaticResource Text.Caption}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding StrongCountText}"
                               Style="{StaticResource Text.StatValue}"
                               Foreground="{DynamicResource SuccessColor}"/>
                    <TextBlock Text="{DynamicResource PasswordCheck_Stat_Strong}"
                               Style="{StaticResource Text.Caption}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding StrongWithIssuesCountText}"
                               Style="{StaticResource Text.StatValue}"
                               Foreground="{DynamicResource AccentGold}"/>
                    <TextBlock Text="{DynamicResource PasswordCheck_Stat_StrongWithIssues}"
                               Style="{StaticResource Text.Caption}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding IssueCountText}"
                               Style="{StaticResource Text.StatValue}"
                               Foreground="{DynamicResource AccentGold}"/>
                    <TextBlock Text="{DynamicResource PasswordCheck_Stat_Issues}"
                               Style="{StaticResource Text.Caption}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding WeakCountText}"
                               Style="{StaticResource Text.StatValue}"
                               Foreground="{DynamicResource ErrorColor}"/>
                    <TextBlock Text="{DynamicResource PasswordCheck_Stat_Weak}"
                               Style="{StaticResource Text.Caption}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding ReusedCountText}"
                               Style="{StaticResource Text.StatValue}"
                               Foreground="{DynamicResource ErrorColor}"/>
                    <TextBlock Text="{DynamicResource PasswordCheck_Stat_Reused}"
                               Style="{StaticResource Text.Caption}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- View toggler -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,0,0,8">
            <ToggleButton ToolTip="{DynamicResource View_List}"
                          IsChecked="{Binding IsListView, Mode=OneWay}"
                          Command="{Binding ShowListCommand}"
                          Width="40" Height="40" Margin="0,0,8,0"
                          Style="{StaticResource SecondaryToggleBtnStyle}">
                <Viewbox Width="20" Height="20">
                    <Path Data="{StaticResource bx_bars}"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                </Viewbox>
            </ToggleButton>
            <ToggleButton ToolTip="{DynamicResource View_Grid}"
                          IsChecked="{Binding IsGridView, Mode=OneWay}"
                          Command="{Binding ShowGridCommand}"
                          Width="40" Height="40"
                          Style="{StaticResource SecondaryToggleBtnStyle}">
                <Viewbox Width="20" Height="20">
                    <Path Data="{StaticResource bx_grid}"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                </Viewbox>
            </ToggleButton>
        </StackPanel>

        <!-- Entries -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="8">
            <Grid>
                <!-- List rows -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsListView, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding EntriesView}"
                                  ItemTemplate="{StaticResource RowItemTemplate}"/>
                </ScrollViewer>

                <!-- Grid cards -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsGridView, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding EntriesView}"
                                  ItemTemplate="{StaticResource GridItemTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Style="{StaticResource EmptyStatePanelStyle}"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <Path Data="{StaticResource bx_check}"
                          Fill="{DynamicResource SuccessColor}"
                          Width="48" Height="48" Stretch="Uniform"
                          HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="{DynamicResource PasswordCheck_Empty}"
                               Style="{StaticResource Text.SectionTitle}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                    <TextBlock Text="{DynamicResource PasswordCheck_EmptyHint}"
                               Style="{StaticResource Text.BodyMuted}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,8,0,0"
                               MaxWidth="360"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
