<Page x:Class="Urkey.WPF.Views.Pages.PasswordCheck"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:uc="clr-namespace:Urkey.WPF.UserControls"
      Title="{DynamicResource PasswordCheckTitle}"
      Foreground="{DynamicResource TextColor}"
      Background="{DynamicResource BgColor}"
      FlowDirection="{DynamicResource AppFlowDirection}"
      Loaded="OnPageLoaded">

    <Page.Resources>
        <DataTemplate x:Key="ChipTemplate">
            <Border Margin="0,0,6,6"
                    Padding="8,4"
                    CornerRadius="10"
                    Background="{DynamicResource InputBgColor}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1">
                <TextBlock Text="{Binding Text}"
                           FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{DynamicResource TextMutedColor}"/>
            </Border>
        </DataTemplate>

        <!-- Soft left→right wash; applied full-bleed under content (fills padding area). -->
        <LinearGradientBrush x:Key="MetricWashMask" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#FF000000" Offset="0"/>
            <GradientStop Color="#CC000000" Offset="0.18"/>
            <GradientStop Color="#00000000" Offset="0.9"/>
        </LinearGradientBrush>

        <Style x:Key="MetricCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MinHeight" Value="96"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>

        <Style x:Key="MetricWashStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}"/>
            <Setter Property="Opacity" Value="0.16"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="OpacityMask" Value="{StaticResource MetricWashMask}"/>
        </Style>

        <Style x:Key="MetricLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSubtitle}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <DataTemplate x:Key="RowItemTemplate">
            <Border Margin="0,0,0,10"
                    Background="{DynamicResource CardBgColor}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{Binding StrengthBrush}"
                            CornerRadius="12,0,0,12"/>

                    <StackPanel Grid.Column="1" Margin="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding ServiceName}"
                                           Style="{StaticResource Text.Body}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Username}"
                                           Style="{StaticResource Text.Caption}"
                                           Margin="0,3,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <Border Background="{Binding StrengthBrush}"
                                        CornerRadius="12"
                                        Padding="10,4"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StrengthText}"
                                               Foreground="White"
                                               FontSize="{StaticResource FontSizeCaption}"
                                               FontWeight="Bold"/>
                                </Border>
                                <Button Style="{StaticResource IconBtnStyle}"
                                        Width="36" Height="36"
                                        ToolTip="{DynamicResource PasswordCheck_ChangePassword}"
                                        Command="{Binding DataContext.BeginEditCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding IsNotEditing, Converter={StaticResource BoolToVisibility}}">
                                    <Viewbox Width="{StaticResource IconSizeMD}" Height="{StaticResource IconSizeMD}">
                                        <Path Data="{StaticResource bx_edit}"
                                              Fill="{DynamicResource TextColor}"
                                              Stretch="Uniform"/>
                                    </Viewbox>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0"
                              Visibility="{Binding IsNotEditing, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ProgressBar Height="8"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding StrengthPercent}"
                                         Foreground="{Binding StrengthBrush}"
                                         Background="{Binding StrengthTrackBrush}"
                                         BorderThickness="0"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding EntropyText}"
                                       Style="{StaticResource Text.Caption}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding FeatureTags}"
                                      ItemTemplate="{StaticResource ChipTemplate}"
                                      Margin="0,12,0,0"
                                      Visibility="{Binding IsNotEditing, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding Chips}"
                                      ItemTemplate="{StaticResource ChipTemplate}"
                                      Margin="0,4,0,0"
                                      Visibility="{Binding IsNotEditing, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <!-- In-place password editor -->
                        <Border Margin="0,14,0,0"
                                Padding="12"
                                Background="{DynamicResource ElevatedBgColor}"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource PasswordCheck_ChangePassword}"
                                           Style="{StaticResource Text.Caption}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding DraftPassword, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Consolas"
                                             FontSize="{StaticResource FontSizeBody}"
                                             Padding="10,8"
                                             Background="{DynamicResource InputBgColor}"
                                             Foreground="{DynamicResource TextColor}"
                                             BorderBrush="{DynamicResource BorderColor}"
                                             BorderThickness="1"
                                             VerticalContentAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource IconBtnStyle}"
                                            Width="36" Height="36"
                                            Margin="8,0,0,0"
                                            Command="{Binding DataContext.GenerateDraftCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{DynamicResource PasswordGenerator_Regenerate}">
                                        <Viewbox Width="{StaticResource IconSizeMD}" Height="{StaticResource IconSizeMD}">
                                            <Path Data="{StaticResource bx_refresh}"
                                                  Fill="{DynamicResource TextColor}"
                                                  Stretch="Uniform"/>
                                        </Viewbox>
                                    </Button>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Right">
                                    <Button Content="{DynamicResource CancelButton}"
                                            Style="{StaticResource SecondaryBtnStyle}"
                                            Margin="0,0,8,0"
                                            Command="{Binding DataContext.CancelEditCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="{DynamicResource PasswordCheck_SavePassword}"
                                            Style="{StaticResource PrimaryBtnStyle}"
                                            Command="{Binding DataContext.SavePasswordCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="{StaticResource PageHeaderMargin}">
            <StackPanel>
                <TextBlock Text="{DynamicResource PasswordCheckTitle}"
                           Style="{StaticResource Text.PageTitle}"/>
                <TextBlock Text="{DynamicResource PasswordCheck_Subtitle}"
                           Style="{StaticResource Text.BodyMuted}"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top">
                <ToggleButton Content="{DynamicResource PasswordCheck_Filter_IssuesOnly}"
                              IsChecked="{Binding ShowIssuesOnly}"
                              Style="{StaticResource SecondaryToggleBtnStyle}"
                              Padding="12,6"
                              Margin="0,0,8,0"
                              Cursor="Hand"/>
                <Button Content="{DynamicResource ReloadButton}"
                        Command="{Binding ReloadCommand}"
                        Style="{StaticResource SecondaryBtnStyle}"
                        Padding="12,6"/>
            </StackPanel>
        </Grid>

        <!-- KPM-style metric cards: soft full-bleed accent wash + balanced type -->
        <UniformGrid Grid.Row="1" Columns="6" Margin="0,0,0,16">
            <Border Style="{StaticResource MetricCardStyle}">
                <Grid>
                    <Border Style="{StaticResource MetricWashStyle}"
                            Background="{DynamicResource PrimaryColor}"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,12">
                        <Viewbox Width="26" Height="26" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource bx_check}" Fill="{DynamicResource PrimaryColor}" Stretch="Uniform"/>
                        </Viewbox>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding CheckedCountText}"
                                       Style="{StaticResource Text.StatValue}"
                                       FontSize="24"
                                       HorizontalAlignment="Left"
                                       Foreground="{DynamicResource PrimaryColor}"/>
                            <TextBlock Text="{DynamicResource PasswordCheck_Stat_Checked}"
                                       Style="{StaticResource MetricLabelStyle}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource MetricCardStyle}">
                <Grid>
                    <Border Style="{StaticResource MetricWashStyle}"
                            Background="{DynamicResource SuccessColor}"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,12">
                        <Viewbox Width="26" Height="26" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource bx_lock}" Fill="{DynamicResource SuccessColor}" Stretch="Uniform"/>
                        </Viewbox>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding StrongCountText}"
                                       Style="{StaticResource Text.StatValue}"
                                       FontSize="24"
                                       HorizontalAlignment="Left"
                                       Foreground="{DynamicResource SuccessColor}"/>
                            <TextBlock Text="{DynamicResource PasswordCheck_Stat_Strong}"
                                       Style="{StaticResource MetricLabelStyle}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource MetricCardStyle}">
                <Grid>
                    <Border Style="{StaticResource MetricWashStyle}"
                            Background="{DynamicResource OrangeColor}"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,12">
                        <Viewbox Width="26" Height="26" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource bx_info}" Fill="{DynamicResource OrangeColor}" Stretch="Uniform"/>
                        </Viewbox>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding StrongWithIssuesCountText}"
                                       Style="{StaticResource Text.StatValue}"
                                       FontSize="24"
                                       HorizontalAlignment="Left"
                                       Foreground="{DynamicResource OrangeColor}"/>
                            <TextBlock Text="{DynamicResource PasswordCheck_Stat_StrongWithIssues}"
                                       Style="{StaticResource MetricLabelStyle}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource MetricCardStyle}">
                <Grid>
                    <Border Style="{StaticResource MetricWashStyle}"
                            Background="{DynamicResource AccentGold}"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,12">
                        <Viewbox Width="26" Height="26" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource bx_warning}" Fill="{DynamicResource AccentGold}" Stretch="Uniform"/>
                        </Viewbox>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding IssueCountText}"
                                       Style="{StaticResource Text.StatValue}"
                                       FontSize="24"
                                       HorizontalAlignment="Left"
                                       Foreground="{DynamicResource AccentGold}"/>
                            <TextBlock Text="{DynamicResource PasswordCheck_Stat_Issues}"
                                       Style="{StaticResource MetricLabelStyle}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource MetricCardStyle}">
                <Grid>
                    <Border Style="{StaticResource MetricWashStyle}"
                            Background="{DynamicResource DeepRedColor}"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,12">
                        <Viewbox Width="26" Height="26" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource bx_error}" Fill="{DynamicResource DeepRedColor}" Stretch="Uniform"/>
                        </Viewbox>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding WeakCountText}"
                                       Style="{StaticResource Text.StatValue}"
                                       FontSize="24"
                                       HorizontalAlignment="Left"
                                       Foreground="{DynamicResource DeepRedColor}"/>
                            <TextBlock Text="{DynamicResource PasswordCheck_Stat_Weak}"
                                       Style="{StaticResource MetricLabelStyle}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource MetricCardStyle}">
                <Grid>
                    <Border Style="{StaticResource MetricWashStyle}"
                            Background="{DynamicResource PurpleColor}"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,12">
                        <Viewbox Width="26" Height="26" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource bx_copy}" Fill="{DynamicResource PurpleColor}" Stretch="Uniform"/>
                        </Viewbox>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding ReusedCountText}"
                                       Style="{StaticResource Text.StatValue}"
                                       FontSize="24"
                                       HorizontalAlignment="Left"
                                       Foreground="{DynamicResource PurpleColor}"/>
                            <TextBlock Text="{DynamicResource PasswordCheck_Stat_Reused}"
                                       Style="{StaticResource MetricLabelStyle}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding EntriesView}"
                              ItemTemplate="{StaticResource RowItemTemplate}"
                              Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}"/>
            </ScrollViewer>

            <uc:EmptyState IconData="{StaticResource bx_check}"
                           Title="{DynamicResource PasswordCheck_Empty}"
                           Hint="{DynamicResource PasswordCheck_EmptyHint}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>
    </Grid>
</Page>
