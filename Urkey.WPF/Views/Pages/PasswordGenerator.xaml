<Page x:Class="Urkey.WPF.Views.Pages.PasswordGenerator"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Urkey.WPF.Views.Pages"
      mc:Ignorable="d" 
        d:DesignHeight="450"
    d:DesignWidth="800"
    Title="{DynamicResource PasswordGeneratorTitle}"
    Foreground="{DynamicResource TextColor}">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{DynamicResource PasswordGeneratorTitle}"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <Border Grid.Row="1"
                CornerRadius="8"
                BorderThickness="1"
                Padding="20"
                Style="{StaticResource CardStyle}">
            <Border.Effect>
                <DropShadowEffect Color="#03000000"
                                  Direction="270"
                                  ShadowDepth="7"
                                  BlurRadius="25"
                                  Opacity=".2"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Length"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Slider x:Name="LengthSlider"
                            Minimum="8"
                            Maximum="32"
                            Value="16"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Width="240"
                            ValueChanged="LengthSlider_OnValueChanged"/>
                    <TextBlock x:Name="LengthValueText"
                               Text="16"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="Generated password"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                <TextBox x:Name="GeneratedPasswordBox"
                         IsReadOnly="True"
                         FontFamily="Consolas"
                         FontSize="14"
                         Padding="10"
                         Margin="0,0,0,16"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Generate"
                            Width="120"
                            Margin="0,0,10,0"
                            Style="{StaticResource PrimaryBtnStyle}"
                            Click="GenerateButton_Click"/>
                    <Button Content="Copy"
                            Width="120"
                            Style="{StaticResource PrimaryBtnStyle}"
                            Click="CopyButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
