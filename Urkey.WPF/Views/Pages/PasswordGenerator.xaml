<Page x:Class="Urkey.WPF.Views.Pages.PasswordGenerator"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="{DynamicResource PasswordGeneratorTitle}"
      Foreground="{DynamicResource TextColor}"
      Background="{DynamicResource BgColor}"
      FlowDirection="{DynamicResource AppFlowDirection}">

    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{DynamicResource PasswordGeneratorTitle}"
                   Style="{StaticResource Text.PageTitle}"
                   Margin="{StaticResource PageHeaderMargin}"/>

        <!-- Fixed width so 64-char passwords never stretch the card -->
        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}"
                VerticalAlignment="Top"
                Width="560"
                MinWidth="560"
                MaxWidth="560"
                HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="{DynamicResource PasswordGenerator_Length}"
                           Style="{StaticResource Text.SectionTitle}"
                           FontSize="14"
                           Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="LengthSlider"
                            Grid.Column="0"
                            Minimum="8"
                            Maximum="64"
                            Value="16"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"
                            ValueChanged="LengthSlider_OnValueChanged"/>
                    <TextBlock x:Name="LengthValueText"
                               Grid.Column="1"
                               Text="16"
                               Style="{StaticResource Text.SectionTitle}"
                               FontSize="14"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               MinWidth="28"/>
                </Grid>

                <TextBlock Text="{DynamicResource PasswordGenerator_Charset}"
                           Style="{StaticResource Text.SectionTitle}"
                           FontSize="14"
                           Margin="0,0,0,8"/>
                <WrapPanel Margin="0,0,0,20">
                    <CheckBox x:Name="LowercaseCheck"
                              Content="{DynamicResource PasswordGenerator_Lowercase}"
                              IsChecked="True"
                              Margin="0,0,16,8"
                              Foreground="{DynamicResource TextColor}"/>
                    <CheckBox x:Name="UppercaseCheck"
                              Content="{DynamicResource PasswordGenerator_Uppercase}"
                              IsChecked="True"
                              Margin="0,0,16,8"
                              Foreground="{DynamicResource TextColor}"/>
                    <CheckBox x:Name="DigitsCheck"
                              Content="{DynamicResource PasswordGenerator_Digits}"
                              IsChecked="True"
                              Margin="0,0,16,8"
                              Foreground="{DynamicResource TextColor}"/>
                    <CheckBox x:Name="SymbolsCheck"
                              Content="{DynamicResource PasswordGenerator_Symbols}"
                              IsChecked="True"
                              Margin="0,0,16,8"
                              Foreground="{DynamicResource TextColor}"/>
                </WrapPanel>

                <TextBlock Text="{DynamicResource PasswordGenerator_Generated}"
                           Style="{StaticResource Text.SectionTitle}"
                           FontSize="14"
                           Margin="0,0,0,8"/>
                <TextBox x:Name="GeneratedPasswordBox"
                         IsReadOnly="True"
                         FontFamily="Consolas"
                         FontSize="15"
                         Padding="{StaticResource InputPadding}"
                         Margin="0,0,0,12"
                         MinHeight="72"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         Background="{DynamicResource InputBgColor}"
                         Foreground="{DynamicResource TextColor}"
                         BorderBrush="{DynamicResource BorderColor}"
                         BorderThickness="1"
                         CaretBrush="{DynamicResource PrimaryColor}"/>

                <TextBlock x:Name="StrengthText"
                           Style="{StaticResource Text.Caption}"
                           Margin="0,0,0,20"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="{DynamicResource PasswordGenerator_Generate}"
                            MinWidth="110"
                            Margin="0,0,8,0"
                            Style="{StaticResource PrimaryBtnStyle}"
                            IsDefault="True"
                            Click="GenerateButton_Click"/>
                    <Button Content="{DynamicResource PasswordGenerator_Copy}"
                            MinWidth="110"
                            Margin="0,0,8,0"
                            Style="{StaticResource SecondaryBtnStyle}"
                            Click="CopyButton_Click"/>
                    <Button Content="{DynamicResource PasswordGenerator_SaveAsEntry}"
                            MinWidth="130"
                            Style="{StaticResource SecondaryBtnStyle}"
                            Click="SaveAsEntryButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
