<Page x:Class="Urkey.WPF.Views.Pages.PasswordGenerator"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="{DynamicResource PasswordGeneratorTitle}"
      Foreground="{DynamicResource TextColor}"
      Background="{DynamicResource BgColor}"
      FlowDirection="{DynamicResource AppFlowDirection}"
      Loaded="OnPageLoaded">

    <Grid Margin="{StaticResource PageMargin}">
        <!-- Embedded KPM-style generator panel (centered, not a modal) -->
        <Border Style="{StaticResource CardStyle}"
                Width="520"
                MaxWidth="560"
                MinWidth="420"
                Padding="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <!-- Header -->
                <DockPanel Margin="0,0,0,20" LastChildFill="True">
                    <Viewbox DockPanel.Dock="Left"
                             Width="{StaticResource IconSizeLG}"
                             Height="{StaticResource IconSizeLG}"
                             Margin="0,0,12,0"
                             VerticalAlignment="Center">
                        <Path Data="{StaticResource bx_password_gen}"
                              Fill="{DynamicResource PrimaryColor}"
                              Stretch="Uniform"/>
                    </Viewbox>
                    <TextBlock Text="{DynamicResource PasswordGeneratorTitle}"
                               Style="{StaticResource Text.SectionTitle}"
                               FontSize="{StaticResource FontSizeTitle}"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <!-- Password display -->
                <Border Background="{DynamicResource ElevatedBgColor}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Padding="14,12"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="PasswordDisplay"
                                   FontFamily="Consolas"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextColor}"
                                   MinHeight="28"/>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="12,0,0,0">
                            <Button x:Name="ToggleVisibilityButton"
                                    Style="{StaticResource IconBtnStyle}"
                                    Width="36" Height="36"
                                    Margin="0,0,4,0"
                                    ToolTip="{DynamicResource PasswordGenerator_Show}"
                                    Click="ToggleVisibility_Click">
                                <Viewbox Width="{StaticResource IconSizeMD}" Height="{StaticResource IconSizeMD}">
                                    <Path x:Name="VisibilityIcon"
                                          Data="{StaticResource bx_eye}"
                                          Fill="{DynamicResource TextColor}"
                                          Stretch="Uniform"/>
                                </Viewbox>
                            </Button>
                            <Button Style="{StaticResource IconBtnStyle}"
                                    Width="36" Height="36"
                                    Margin="0,0,4,0"
                                    ToolTip="{DynamicResource PasswordGenerator_Copy}"
                                    Click="CopyButton_Click">
                                <Viewbox Width="{StaticResource IconSizeMD}" Height="{StaticResource IconSizeMD}">
                                    <Path Data="{StaticResource bx_copy}"
                                          Fill="{DynamicResource TextColor}"
                                          Stretch="Uniform"/>
                                </Viewbox>
                            </Button>
                            <Button Style="{StaticResource PrimaryBtnStyle}"
                                    Padding="12,8"
                                    MinWidth="0"
                                    ToolTip="{DynamicResource PasswordGenerator_Regenerate}"
                                    Click="GenerateButton_Click">
                                <Viewbox Width="{StaticResource IconSizeMD}" Height="{StaticResource IconSizeMD}">
                                    <Path Data="{StaticResource bx_refresh}"
                                          Fill="{DynamicResource ButtonPrimaryText}"
                                          Stretch="Uniform"/>
                                </Viewbox>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock x:Name="StrengthText"
                           Style="{StaticResource Text.Caption}"
                           Margin="0,0,0,20"
                           FontWeight="SemiBold"/>

                <!-- Settings -->
                <TextBlock Text="{DynamicResource PasswordGenerator_Settings}"
                           Style="{StaticResource Text.SectionTitle}"
                           FontSize="{StaticResource FontSizeSubtitle}"
                           Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource PasswordGenerator_Length}"
                               Style="{StaticResource Text.Body}"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"/>
                    <Slider x:Name="LengthSlider"
                            Grid.Column="1"
                            Minimum="8"
                            Maximum="64"
                            Value="16"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"
                            ValueChanged="LengthSlider_OnValueChanged"/>
                    <Border Grid.Column="2"
                            Margin="12,0,0,0"
                            MinWidth="40"
                            Padding="10,4"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Background="{DynamicResource InputBgColor}"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="LengthValueText"
                                   Text="16"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextColor}"/>
                    </Border>
                </Grid>

                <UniformGrid Columns="2" Margin="0,0,0,24">
                    <CheckBox x:Name="UppercaseCheck"
                              Content="{DynamicResource PasswordGenerator_Uppercase}"
                              IsChecked="True"
                              Margin="0,0,12,10"
                              Foreground="{DynamicResource TextColor}"
                              Checked="Charset_Changed"
                              Unchecked="Charset_Changed"/>
                    <CheckBox x:Name="LowercaseCheck"
                              Content="{DynamicResource PasswordGenerator_Lowercase}"
                              IsChecked="True"
                              Margin="0,0,0,10"
                              Foreground="{DynamicResource TextColor}"
                              Checked="Charset_Changed"
                              Unchecked="Charset_Changed"/>
                    <CheckBox x:Name="DigitsCheck"
                              Content="{DynamicResource PasswordGenerator_Digits}"
                              IsChecked="True"
                              Margin="0,0,12,0"
                              Foreground="{DynamicResource TextColor}"
                              Checked="Charset_Changed"
                              Unchecked="Charset_Changed"/>
                    <CheckBox x:Name="SymbolsCheck"
                              Content="{DynamicResource PasswordGenerator_Symbols}"
                              IsChecked="True"
                              Foreground="{DynamicResource TextColor}"
                              Checked="Charset_Changed"
                              Unchecked="Charset_Changed"/>
                </UniformGrid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{DynamicResource PasswordGenerator_Copy}"
                            MinWidth="110"
                            Margin="0,0,8,0"
                            Style="{StaticResource SecondaryBtnStyle}"
                            Click="CopyButton_Click"/>
                    <Button Content="{DynamicResource PasswordGenerator_SaveAsEntry}"
                            MinWidth="140"
                            Style="{StaticResource PrimaryBtnStyle}"
                            Click="SaveAsEntryButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
