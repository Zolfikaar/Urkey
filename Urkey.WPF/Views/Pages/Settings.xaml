<Page x:Class="Urkey.WPF.Views.Pages.Settings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="{DynamicResource Settings_Title}"
      Foreground="{DynamicResource TextColor}"
      Background="{DynamicResource BgColor}"
      FlowDirection="{DynamicResource AppFlowDirection}">

    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{DynamicResource Settings_Title}"
                   Style="{StaticResource Text.PageTitle}"
                   Margin="0,0,0,16"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="SettingsNav"
                     Grid.Column="0"
                     BorderThickness="0"
                     Background="Transparent"
                     Padding="0,0,16,0"
                     SelectedIndex="0"
                     SelectionChanged="SettingsNav_SelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource SettingsNavItemStyle}"/>
                </ListBox.ItemContainerStyle>
                <ListBoxItem Tag="General" Content="{DynamicResource SettingsNav_General}"/>
                <ListBoxItem Tag="ImportExport" Content="{DynamicResource SettingsNav_ImportExport}"/>
                <ListBoxItem Tag="Advanced" Content="{DynamicResource SettingsNav_Advanced}"/>
            </ListBox>

            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <!-- General -->
                    <StackPanel x:Name="GeneralPanel">
                        <StackPanel Style="{StaticResource SettingsSectionStyle}">
                            <TextBlock Text="{DynamicResource StartupSettings_Title}" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,6"/>
                            <TextBlock Text="{DynamicResource StartupSettings_Description}" Style="{StaticResource Text.BodyMuted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <CheckBox x:Name="StartupCheck"
                                      Content="{DynamicResource StartupSettings_LaunchAtLogin}"
                                      Foreground="{DynamicResource TextColor}"
                                      Checked="StartupCheck_Changed"
                                      Unchecked="StartupCheck_Changed"/>
                        </StackPanel>
                        <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,16"/>

                        <StackPanel Style="{StaticResource SettingsSectionStyle}">
                            <TextBlock Text="{DynamicResource MasterPassword_Title}" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,6"/>
                            <TextBlock Text="{DynamicResource MasterPassword_Description}" Style="{StaticResource Text.BodyMuted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <Button x:Name="ChangeMasterPasswordButton"
                                    Content="{DynamicResource ChangeMasterPassword_Button}"
                                    Style="{StaticResource OutlineBtnStyle}"
                                    HorizontalAlignment="Left"
                                    Click="OnChangeMasterPasswordClick"/>
                        </StackPanel>
                        <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,16"/>

                        <StackPanel Style="{StaticResource SettingsSectionStyle}">
                            <TextBlock Text="{DynamicResource AutoLock_Title}" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,6"/>
                            <TextBlock Text="{DynamicResource AutoLock_Description}" Style="{StaticResource Text.BodyMuted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <RadioButton x:Name="AutoLockNeverRadio"
                                         Content="{DynamicResource AutoLock_Never}"
                                         GroupName="AutoLock"
                                         Foreground="{DynamicResource TextColor}"
                                         Margin="0,0,0,8"
                                         Checked="AutoLockMode_Changed"/>
                            <RadioButton x:Name="AutoLockIdleRadio"
                                         Content="{DynamicResource AutoLock_AfterInactivity}"
                                         GroupName="AutoLock"
                                         Foreground="{DynamicResource TextColor}"
                                         Margin="0,0,0,8"
                                         Checked="AutoLockMode_Changed"/>
                            <ComboBox x:Name="AutoLockMinutesBox"
                                      Width="180"
                                      HorizontalAlignment="Left"
                                      Margin="24,0,0,12"
                                      SelectionChanged="AutoLockMinutesBox_SelectionChanged"/>
                            <CheckBox x:Name="PromptUnlockOnLoginFieldsCheck"
                                      Content="{DynamicResource AutoLock_PromptOnLoginFields}"
                                      Foreground="{DynamicResource TextColor}"
                                      IsEnabled="False"
                                      ToolTip="{DynamicResource Feature_RequiresExtension}"/>
                        </StackPanel>
                        <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,16"/>

                        <StackPanel Style="{StaticResource SettingsSectionStyle}">
                            <TextBlock Text="{DynamicResource ClipboardSettings_Title}" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,6"/>
                            <TextBlock Text="{DynamicResource ClipboardSettings_Description}" Style="{StaticResource Text.BodyMuted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource ClipboardSettings_ClearAfter}"
                                           Style="{StaticResource Text.Body}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                                <Grid>
                                    <Button x:Name="ClipboardTimeButton"
                                            Content="{DynamicResource ClipboardTime_10Seconds}"
                                            Style="{StaticResource OutlineBtnStyle}"
                                            MinWidth="140"
                                            Click="ClipboardTimeButton_Click"/>
                                    <Popup x:Name="ClipboardTimePopup"
                                           PlacementTarget="{Binding ElementName=ClipboardTimeButton}"
                                           Placement="Bottom"
                                           StaysOpen="False"
                                           AllowsTransparency="True">
                                        <Border Background="{DynamicResource CardBgColor}"
                                                BorderBrush="{DynamicResource BorderColor}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="6"
                                                MinWidth="160">
                                            <StackPanel>
                                                <Button x:Name="ClipboardTime10" Content="{DynamicResource ClipboardTime_10Seconds}" Click="ClipboardTime_Selected" Style="{StaticResource OutlineBtnStyle}" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
                                                <Button x:Name="ClipboardTime30" Content="{DynamicResource ClipboardTime_30Seconds}" Click="ClipboardTime_Selected" Style="{StaticResource OutlineBtnStyle}" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
                                                <Button x:Name="ClipboardTime60" Content="{DynamicResource ClipboardTime_1Minute}" Click="ClipboardTime_Selected" Style="{StaticResource OutlineBtnStyle}" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
                                                <Button x:Name="ClipboardTimeNever" Content="{DynamicResource ClipboardTime_Never}" Click="ClipboardTime_Selected" Style="{StaticResource OutlineBtnStyle}" HorizontalAlignment="Stretch"/>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                        <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,16"/>

                        <StackPanel Style="{StaticResource SettingsSectionStyle}">
                            <TextBlock Text="{DynamicResource LanguageSettings_Title}" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,6"/>
                            <TextBlock Text="{DynamicResource LanguageSettings_Description}" Style="{StaticResource Text.BodyMuted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <ToggleButton x:Name="LangToggle"
                                          Content="{DynamicResource Settings_ChangeLanguage}"
                                          Style="{StaticResource PrimaryToggleButtonStyle}"
                                          HorizontalAlignment="Left"
                                          Click="OnLanguageChanged"/>
                        </StackPanel>
                        <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,16"/>

                        <StackPanel Style="{StaticResource SettingsSectionStyle}">
                            <TextBlock Text="{DynamicResource ThemeSettings_Title}" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,6"/>
                            <TextBlock Text="{DynamicResource ThemeSettings_Description}" Style="{StaticResource Text.BodyMuted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <RadioButton x:Name="ThemeSystemRadio" Content="{DynamicResource Theme_System}" GroupName="Theme" Foreground="{DynamicResource TextColor}" Margin="0,0,0,8" Checked="ThemeRadio_Changed"/>
                            <RadioButton x:Name="ThemeLightRadio" Content="{DynamicResource Theme_Light}" GroupName="Theme" Foreground="{DynamicResource TextColor}" Margin="0,0,0,8" Checked="ThemeRadio_Changed"/>
                            <RadioButton x:Name="ThemeDarkRadio" Content="{DynamicResource Theme_Dark}" GroupName="Theme" Foreground="{DynamicResource TextColor}" Checked="ThemeRadio_Changed"/>
                        </StackPanel>
                        <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,16"/>

                        <StackPanel Style="{StaticResource SettingsSectionStyle}">
                            <TextBlock Text="{DynamicResource SidebarSettings_Title}" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,6"/>
                            <TextBlock Text="{DynamicResource SidebarSettings_Description}" Style="{StaticResource Text.BodyMuted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <ToggleButton x:Name="SidebarToggle"
                                          Style="{StaticResource PrimaryToggleButtonStyle}"
                                          HorizontalAlignment="Left"
                                          Checked="SidebarToggle_Checked"
                                          Unchecked="SidebarToggle_Unchecked"
                                          Loaded="SidebarToggle_Loaded"/>
                        </StackPanel>
                        <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,16"/>

                        <StackPanel Style="{StaticResource SettingsSectionStyle}">
                            <TextBlock Text="{DynamicResource AutosaveAutofill_Title}" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,6"/>
                            <TextBlock Text="{DynamicResource AutosaveAutofill_Description}" Style="{StaticResource Text.BodyMuted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <TextBlock Text="{DynamicResource AutosaveAutofill_EnableFor}" Style="{StaticResource Text.Body}" Margin="0,0,0,8"/>
                            <CheckBox x:Name="AutosavePasswordsCheck" Content="{DynamicResource AutosavePasswords}" Foreground="{DynamicResource TextColor}" Margin="0,0,0,8" Checked="AutofillPref_Changed" Unchecked="AutofillPref_Changed"/>
                            <CheckBox x:Name="AutofillPasswordsCheck" Content="{DynamicResource AutofillPasswords}" Foreground="{DynamicResource TextColor}" Margin="0,0,0,8" Checked="AutofillPref_Changed" Unchecked="AutofillPref_Changed"/>
                            <CheckBox x:Name="AutosaveAddressesCheck" Content="{DynamicResource AutosaveAddresses}" Foreground="{DynamicResource TextColor}" Margin="0,0,0,8" Checked="AutofillPref_Changed" Unchecked="AutofillPref_Changed"/>
                            <CheckBox x:Name="AutofillAddressesCheck" Content="{DynamicResource AutofillAddresses}" Foreground="{DynamicResource TextColor}" Margin="0,0,0,8" Checked="AutofillPref_Changed" Unchecked="AutofillPref_Changed"/>
                            <CheckBox x:Name="AutosaveBankCardsCheck" Content="{DynamicResource AutosaveBankCards}" Foreground="{DynamicResource TextColor}" Margin="0,0,0,8" Checked="AutofillPref_Changed" Unchecked="AutofillPref_Changed"/>
                            <CheckBox x:Name="AutofillBankCardsCheck" Content="{DynamicResource AutofillBankCards}" Foreground="{DynamicResource TextColor}" Checked="AutofillPref_Changed" Unchecked="AutofillPref_Changed"/>
                        </StackPanel>
                        <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,16"/>

                        <StackPanel Style="{StaticResource SettingsSectionStyle}" Margin="0,0,0,24">
                            <TextBlock Text="{DynamicResource UserAccount_Title}" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,6"/>
                            <TextBlock x:Name="AccountNameText" Text="{DynamicResource UserAccount_Name}" Style="{StaticResource Text.Body}" Margin="0,0,0,4"/>
                            <TextBlock Text="{DynamicResource UserAccount_Description}" Style="{StaticResource Text.BodyMuted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <Button x:Name="SignOutButton"
                                    Content="{DynamicResource SignOutButton}"
                                    Style="{StaticResource OutlineBtnStyle}"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Import / Export -->
                    <StackPanel x:Name="ImportPanel" Visibility="Collapsed">
                        <StackPanel Style="{StaticResource SettingsSectionStyle}">
                            <TextBlock Text="{DynamicResource ImportSettings_Title}" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,6"/>
                            <TextBlock Text="{DynamicResource ImportSettings_Description}" Style="{StaticResource Text.BodyMuted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <Button x:Name="ImportPasswordsButton"
                                    Content="{DynamicResource Import_Button}"
                                    Style="{StaticResource OutlineBtnStyle}"
                                    HorizontalAlignment="Left"
                                    Click="OnImportPasswordsClick"/>
                        </StackPanel>
                        <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,16"/>

                        <StackPanel Style="{StaticResource SettingsSectionStyle}">
                            <TextBlock Text="{DynamicResource ExportCsv_Title}" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,6"/>
                            <TextBlock Text="{DynamicResource ExportCsv_Description}" Style="{StaticResource Text.BodyMuted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <Button Content="{DynamicResource Export_Button}"
                                    Style="{StaticResource OutlineBtnStyle}"
                                    HorizontalAlignment="Left"
                                    Click="OnExportCsvClick"/>
                        </StackPanel>
                        <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,16"/>

                        <StackPanel Style="{StaticResource SettingsSectionStyle}">
                            <TextBlock Text="{DynamicResource ExportText_Title}" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,6"/>
                            <TextBlock Text="{DynamicResource ExportText_Description}" Style="{StaticResource Text.BodyMuted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <Button Content="{DynamicResource Export_Button}"
                                    Style="{StaticResource OutlineBtnStyle}"
                                    HorizontalAlignment="Left"
                                    Click="OnExportTextClick"/>
                        </StackPanel>
                        <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,16"/>

                        <StackPanel Style="{StaticResource SettingsSectionStyle}">
                            <TextBlock Text="{DynamicResource Backup_Title}" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,6"/>
                            <TextBlock Text="{DynamicResource Backup_Description}" Style="{StaticResource Text.BodyMuted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <Button Content="{DynamicResource Backup_Button}"
                                    Style="{StaticResource OutlineBtnStyle}"
                                    HorizontalAlignment="Left"
                                    Click="OnBackupClick"/>
                        </StackPanel>
                        <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,16"/>

                        <Border Background="{DynamicResource DangerCardBg}"
                                BorderBrush="{DynamicResource DangerCardBorder}"
                                BorderThickness="1"
                                Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource ResetAppData_Title}"
                                           Style="{StaticResource Text.SectionTitle}"
                                           Foreground="{DynamicResource ErrorColor}"
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="{DynamicResource ResetAppData_Description}"
                                           Style="{StaticResource Text.BodyMuted}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,12"/>
                                <Button x:Name="ResetAppDataButton"
                                        Content="{DynamicResource ResetAppData_Button}"
                                        Style="{StaticResource DangerBtnStyle}"
                                        HorizontalAlignment="Left"
                                        Click="OnResetAppDataClick"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Advanced -->
                    <StackPanel x:Name="AdvancedPanel" Visibility="Collapsed">
                        <StackPanel Style="{StaticResource SettingsSectionStyle}">
                            <TextBlock Text="{DynamicResource SortAz_Title}" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,6"/>
                            <TextBlock Text="{DynamicResource SortAz_Description}" Style="{StaticResource Text.BodyMuted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <Button Content="{DynamicResource SortAz_Button}"
                                    Style="{StaticResource OutlineBtnStyle}"
                                    HorizontalAlignment="Left"
                                    Click="OnSortAzClick"/>
                        </StackPanel>
                        <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,16"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="{DynamicResource Compromised_Title}" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,6"/>
                                <TextBlock Text="{DynamicResource Compromised_Description}" Style="{StaticResource Text.BodyMuted}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleButton x:Name="CompromisedToggle"
                                          Grid.Column="1"
                                          Style="{StaticResource SwitchToggleStyle}"
                                          VerticalAlignment="Center"
                                          Checked="CompromisedToggle_Changed"
                                          Unchecked="CompromisedToggle_Changed"/>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,16"/>

                        <StackPanel Style="{StaticResource SettingsSectionStyle}">
                            <TextBlock Text="{DynamicResource Diagnostics_Title}" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,6"/>
                            <TextBlock Text="{DynamicResource Diagnostics_Description}" Style="{StaticResource Text.BodyMuted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <CheckBox x:Name="LogEventsCheck"
                                      Content="{DynamicResource Diagnostics_LogEvents}"
                                      Foreground="{DynamicResource TextColor}"
                                      Checked="LogEventsCheck_Changed"
                                      Unchecked="LogEventsCheck_Changed"/>
                        </StackPanel>
                        <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,16"/>

                        <StackPanel Style="{StaticResource SettingsSectionStyle}">
                            <TextBlock Text="{DynamicResource FastHotkey_Title}" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,6"/>
                            <TextBlock Text="{DynamicResource FastHotkey_Description}" Style="{StaticResource Text.BodyMuted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <CheckBox x:Name="FastHotkeyCheck"
                                      Content="{DynamicResource FastHotkey_Enable}"
                                      Foreground="{DynamicResource TextColor}"
                                      Margin="0,0,0,10"
                                      Checked="FastHotkey_Changed"
                                      Unchecked="FastHotkey_Changed"/>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="HotkeyModifierBox"
                                          Width="140"
                                          Margin="0,0,8,0"
                                          SelectionChanged="FastHotkey_Changed"/>
                                <TextBlock Text="+" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextMutedColor}"/>
                                <ComboBox x:Name="HotkeyKeyBox"
                                          Width="72"
                                          SelectionChanged="FastHotkey_Changed"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,16"/>

                        <StackPanel Style="{StaticResource SettingsSectionStyle}" Margin="0,0,0,24">
                            <TextBlock Text="{DynamicResource LocalVault_Title}" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,6"/>
                            <TextBlock Text="{DynamicResource LocalVault_Description}" Style="{StaticResource Text.BodyMuted}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
