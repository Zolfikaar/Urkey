<Page x:Class="Urkey.WPF.Views.Pages.Settings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Urkey.WPF.Views.Pages"
      mc:Ignorable="d"
      Title="{DynamicResource Settings_Title}"
      Foreground="{DynamicResource TextColor}">

    <Page.Resources>
        <Style TargetType="ScrollBar">
            <Setter Property="Margin"
                    Value="10,0,0,0"/>
            <Setter Property="Width"
                    Value="6"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="true">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Visibility="Collapsed"/>
                                </Track.DecreaseRepeatButton>

                                <!-- 🟢 الـ Thumb (المقبض) بحواف منحنية -->
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource SecondaryTextColor}"
                                                        CornerRadius="5"
                                                        Width="10"
                                                        Margin="1"
                                                        SnapsToDevicePixels="True"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Visibility="Collapsed"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


    </Page.Resources>

    <Border
        Margin="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Page Header -->
            <Border Grid.Row="0"
                    Background="Transparent"
                    Margin="30,30,30,20">
                <TextBlock Text="{DynamicResource Settings_Title}"
                           FontSize="24"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- Settings Content -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Margin="30,0,30,30">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50*"/>
                        <ColumnDefinition Width="50*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Security Settings -->
                    <Border x:Name="SecurityCard"
                            Grid.Row="0"
                            Grid.Column="0"
                            CornerRadius="8"
                            BorderThickness="1"
                            Margin="0,0,15,20"
                            VerticalAlignment="Stretch"
                            Style="{StaticResource CardStyle}">
                        <Border.Effect>
                            <DropShadowEffect
                                Color="#03000000"
                                Direction="270"
                                ShadowDepth="7"
                                BlurRadius="25"
                                Opacity=".2"/>
                        </Border.Effect>
                        <StackPanel Margin="20">
                            <TextBlock Text="{DynamicResource SecuritySettings_Title}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,20"/>

                            <!-- Master Password Change -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource MasterPassword_Title}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,5"/>
                                    <TextBlock Text="{DynamicResource MasterPassword_Description}"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextColor}"/>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="{DynamicResource ChangeBtn}"
                                        Style="{StaticResource PrimaryBtnStyle}"
                                        FontSize="12"
                                        Padding="12,6"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Language Settings -->
                    <Border Grid.Row="0"
                            Grid.Column="1"
                            CornerRadius="8"
                            BorderThickness="1"
                            Margin="15,0,0,20"
                            Height="{Binding ActualHeight, ElementName=SecurityCard}"
                            Style="{StaticResource CardStyle}">
                        <Border.Effect>
                            <DropShadowEffect
                                Color="#03000000"
                                Direction="270"
                                ShadowDepth="7"
                                BlurRadius="25"
                                Opacity=".2"/>
                        </Border.Effect>
                        <StackPanel Margin="20">
                            <TextBlock Text="{DynamicResource LanguageSettings_Title}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,20"/>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource LanguageSettings_Description}"
                                               FontSize="12"
                                               Margin="0,0,0,5"
                                               Foreground="{DynamicResource SecondaryTextColor}"/>
                                </StackPanel>

                                <ToggleButton x:Name="LangToggle"
                                              Grid.Column="1"
                                              Content="{DynamicResource ChangeBtn}"
                                              Style="{StaticResource PrimaryToggleButtonStyle}"
                                              VerticalAlignment="Center"
                                              Click="OnLanguageChanged"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Theme Settings -->
                    <Border Grid.Row="1"
                            Grid.Column="0"
                            CornerRadius="8"
                            BorderThickness="1"
                            Margin="0,0,15,20"
                            Height="{Binding ActualHeight, ElementName=SecurityCard}"
                            Width="{Binding ActualWidth, ElementName=SecurityCard}"
                            Style="{StaticResource CardStyle}">
                        <Border.Effect>
                            <DropShadowEffect
                                Color="#03000000"
                                Direction="270"
                                ShadowDepth="7"
                                BlurRadius="25"
                                Opacity=".2"/>
                        </Border.Effect>
                        <StackPanel Margin="20">
                            <TextBlock Text="{DynamicResource ThemeSettings_Title}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,20"/>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource ThemeSettings_Description}"
                                               FontSize="12"
                                               Margin="0,0,0,5"
                                               Foreground="{DynamicResource SecondaryTextColor}"/>
                                </StackPanel>

                                <Button x:Name="ThemeToggle"
                                        Grid.Column="1"
                                        Content="{DynamicResource ChangeBtn}"
                                        Style="{StaticResource PrimaryBtnStyle}"
                                        FontSize="12"
                                        Padding="12,6"
                                        VerticalAlignment="Center"
                                        Click="OnThemeChanged"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Sidebar Default State Toggle -->
                    <Border Grid.Row="1"
                            Grid.Column="1"
                            CornerRadius="8"
                            BorderThickness="1"
                            Margin="15,0,0,20"
                            Height="{Binding ActualHeight, ElementName=SecurityCard}"
                            Style="{StaticResource CardStyle}">
                        <Border.Effect>
                            <DropShadowEffect
                                Color="#03000000"
                                Direction="270"
                                ShadowDepth="7"
                                BlurRadius="25"
                                Opacity=".2"/>
                        </Border.Effect>
                        <StackPanel Margin="20">
                            <TextBlock Text="{DynamicResource SidebarSettings_Title}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,20"/>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource SidebarSettings_DefaultState}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,5"/>
                                    <TextBlock Text="{DynamicResource SidebarSettings_Description}"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextColor}"/>
                                </StackPanel>

                                <ToggleButton x:Name="SidebarToggle"
                                              Grid.Column="1"
                                              Style="{StaticResource PrimaryToggleButtonStyle}"
                                              VerticalAlignment="Center"
                                              Checked="SidebarToggle_Checked"
                                              Unchecked="SidebarToggle_Unchecked"
                                              Loaded="SidebarToggle_Loaded"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Clipboard Clear Time -->
                    <Border Grid.Row="2"
                            Grid.Column="0"
                            CornerRadius="8"
                            BorderThickness="1"
                            Margin="0,0,15,20"
                            Height="{Binding ActualHeight, ElementName=SecurityCard}"
                            Width="{Binding ActualWidth, ElementName=SecurityCard}"
                            Style="{StaticResource CardStyle}">
                        <Border.Effect>
                            <DropShadowEffect
                                Color="#03000000"
                                Direction="270"
                                ShadowDepth="7"
                                BlurRadius="25"
                                Opacity=".2"/>
                        </Border.Effect>
                        <StackPanel Margin="20">
                            <TextBlock Text="{DynamicResource ClipboardSettings_Title}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,20"/>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource ClipboardSettings_ClearAfter}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,5"/>
                                    <TextBlock Text="{DynamicResource ClipboardSettings_Description}"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextColor}"/>
                                </StackPanel>

                                <Grid Grid.Column="1"
                                      VerticalAlignment="Center">
                                    <Button x:Name="ClipboardTimeButton"
                                            Content="{DynamicResource ClipboardTime_10Seconds}"
                                            Background="{DynamicResource CardBgColor}"
                                            Foreground="{DynamicResource TextColor}"
                                            BorderBrush="{DynamicResource BorderColor}"
                                            BorderThickness="1"
                                            Padding="12,8"
                                            MinWidth="120"
                                            FontSize="12"
                                            Cursor="Hand"
                                            Click="ClipboardTimeButton_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <Grid>
                                                        <TextBlock Text="{TemplateBinding Content}"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Left"/>
                                                        <Path Data="M0,0 L6,6 L12,0 Z"
                                                              Fill="{TemplateBinding Foreground}"
                                                              Width="8"
                                                              Height="4"
                                                              HorizontalAlignment="Right"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,0,0"/>
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <Popup x:Name="ClipboardTimePopup"
                                           PlacementTarget="{Binding ElementName=ClipboardTimeButton}"
                                           Placement="Bottom"
                                           StaysOpen="False"
                                           AllowsTransparency="True">
                                        <Grid>
                                            <Rectangle Fill="{DynamicResource CardBgColor}"
                                                       RadiusX="8"
                                                       RadiusY="8"
                                                       Stroke="{DynamicResource BorderColor}"
                                                       StrokeThickness="1"/>
                                            <Border Background="Transparent"
                                                    CornerRadius="8"
                                                    Padding="8"
                                                    MinWidth="170">
                                                <StackPanel>
                                                    <StackPanel.Resources>
                                                        <Style x:Key="MenuButtonStyle"
                                                               TargetType="Button">
                                                            <Setter Property="Background"
                                                                    Value="Transparent"/>
                                                            <Setter Property="BorderThickness"
                                                                    Value="0"/>
                                                            <Setter Property="Cursor"
                                                                    Value="Hand"/>
                                                            <Setter Property="HorizontalContentAlignment"
                                                                    Value="Left"/>
                                                            <Setter Property="Padding"
                                                                    Value="12,8"/>
                                                            <Setter Property="Margin"
                                                                    Value="2"/>
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource TextColor}"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}"
                                                                                CornerRadius="4"
                                                                                Padding="{TemplateBinding Padding}"
                                                                                TextElement.Foreground="{TemplateBinding Foreground}">
                                                                            <ContentPresenter/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver"
                                                                                     Value="True">
                                                                                <Setter Property="Background"
                                                                                        Value="{DynamicResource HoverColor}"/>
                                                                                <Setter Property="Foreground"
                                                                                        Value="{DynamicResource PrimaryColor}"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </StackPanel.Resources>
                                                    <Button x:Name="ClipboardTime10"
                                                            Content="{DynamicResource ClipboardTime_10Seconds}"
                                                            Style="{StaticResource MenuButtonStyle}"
                                                            Click="ClipboardTime_Selected"/>
                                                    <Button x:Name="ClipboardTime30"
                                                            Content="{DynamicResource ClipboardTime_30Seconds}"
                                                            Style="{StaticResource MenuButtonStyle}"
                                                            Click="ClipboardTime_Selected"/>
                                                    <Button x:Name="ClipboardTime60"
                                                            Content="{DynamicResource ClipboardTime_1Minute}"
                                                            Style="{StaticResource MenuButtonStyle}"
                                                            Click="ClipboardTime_Selected"/>
                                                    <Button x:Name="ClipboardTimeNever"
                                                            Content="{DynamicResource ClipboardTime_Never}"
                                                            Style="{StaticResource MenuButtonStyle}"
                                                            Click="ClipboardTime_Selected"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Popup>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- User Account -->
                    <Border Grid.Row="2"
                            Grid.Column="1"
                            CornerRadius="8"
                            BorderThickness="1"
                            Margin="15,0,0,20"
                            Height="{Binding ActualHeight, ElementName=SecurityCard}"
                            Style="{StaticResource CardStyle}">
                        <Border.Effect>
                            <DropShadowEffect
                                Color="#03000000"
                                Direction="270"
                                ShadowDepth="7"
                                BlurRadius="25"
                                Opacity=".2"/>
                        </Border.Effect>
                        <StackPanel Margin="20">
                            <TextBlock Text="{DynamicResource UserAccount_Title}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,20"/>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="AccountNameText"
                                               Text="{DynamicResource UserAccount_Name}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,5"/>
                                    <TextBlock Text="{DynamicResource UserAccount_Description}"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextColor}"/>
                                </StackPanel>

                                <Button x:Name="SignOutButton"
                                        Grid.Column="1"
                                        Content="{DynamicResource SignOutButton}"
                                        Style="{StaticResource PrimaryBtnStyle}"
                                        FontSize="12"
                                        Padding="12,6"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Autosave and Autofill -->
                    <Border Grid.Row="3"
                            Grid.Column="0"
                            CornerRadius="8"
                            BorderThickness="1"
                            Margin="0,0,15,0"
                            Height="{Binding ActualHeight, ElementName=SecurityCard}"
                            Width="{Binding ActualWidth, ElementName=SecurityCard}"
                            Style="{StaticResource CardStyle}">
                        <Border.Effect>
                            <DropShadowEffect
                                Color="#03000000"
                                Direction="270"
                                ShadowDepth="7"
                                BlurRadius="25"
                                Opacity=".2"/>
                        </Border.Effect>
                        <StackPanel Margin="20">
                            <TextBlock Text="{DynamicResource AutosaveAutofill_Title}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,20"/>

                            <StackPanel>
                                <CheckBox x:Name="AutosavePasswordsCheck"
                                          Content="{DynamicResource AutosavePasswords}"
                                          FontSize="14"
                                          Margin="0,0,0,12"
                                          Foreground="{DynamicResource TextColor}"/>

                                <CheckBox x:Name="AutofillPasswordsCheck"
                                          Content="{DynamicResource AutofillPasswords}"
                                          FontSize="14"
                                          Margin="0,0,0,12"
                                          Foreground="{DynamicResource TextColor}"/>

                                <CheckBox x:Name="AutosaveAddressesCheck"
                                          Content="{DynamicResource AutosaveAddresses}"
                                          FontSize="14"
                                          Margin="0,0,0,12"
                                          Foreground="{DynamicResource TextColor}"/>

                                <CheckBox x:Name="AutofillAddressesCheck"
                                          Content="{DynamicResource AutofillAddresses}"
                                          FontSize="14"
                                          Margin="0,0,0,12"
                                          Foreground="{DynamicResource TextColor}"/>

                                <CheckBox x:Name="AutosaveBankCardsCheck"
                                          Content="{DynamicResource AutosaveBankCards}"
                                          FontSize="14"
                                          Margin="0,0,0,12"
                                          Foreground="{DynamicResource TextColor}"/>

                                <CheckBox x:Name="AutofillBankCardsCheck"
                                          Content="{DynamicResource AutofillBankCards}"
                                          FontSize="14"
                                          Foreground="{DynamicResource TextColor}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Sync Across Devices -->
                    <Border Grid.Row="3"
                            Grid.Column="1"
                            CornerRadius="8"
                            BorderThickness="1"
                            Margin="15,0,0,0"
                            Height="{Binding ActualHeight, ElementName=SecurityCard}"
                            Style="{StaticResource CardStyle}">
                        <Border.Effect>
                            <DropShadowEffect
                                Color="#03000000"
                                Direction="270"
                                ShadowDepth="7"
                                BlurRadius="25"
                                Opacity=".2"/>
                        </Border.Effect>
                        <StackPanel Margin="20">
                            <TextBlock Text="{DynamicResource SyncSettings_Title}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,20"/>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource SyncSettings_SyncDevices}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,5"/>
                                    <TextBlock Text="{DynamicResource SyncSettings_Description}"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextColor}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <CheckBox x:Name="SyncDevicesCheck"
                                          Grid.Column="1"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>


            </ScrollViewer>
        </Grid>
    </Border>
</Page>
