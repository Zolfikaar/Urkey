<Window x:Class="Urkey.WPF.Views.Windows.AccountDetails"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{DynamicResource AccountDetailsTitle}"
        Width="520"
        Background="{DynamicResource BgColor}"
        Foreground="{DynamicResource TextColor}"
        FlowDirection="{DynamicResource AppFlowDirection}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="Height">

    <Border Style="{DynamicResource CardStyle}"
            Margin="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="Cairo"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Margin" Value="0,0,10,12"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Style>

                <Style TargetType="TextBlock" x:Key="ValueStyle">
                    <Setter Property="FontFamily" Value="Cairo"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Margin" Value="0,0,0,12"/>
                </Style>
            </Grid.Resources>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource AccountNameFieldTitle}"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ServiceName}" Style="{StaticResource ValueStyle}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource UserNameFieldTitle}"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Username}" Style="{StaticResource ValueStyle}"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource EmailFieldTitle}"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Email}" Style="{StaticResource ValueStyle}"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource TypeFieldTitle}"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AccountType}" Style="{StaticResource ValueStyle}"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource WebsiteFieldTitle}"/>
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Url}" Style="{StaticResource ValueStyle}" TextWrapping="Wrap"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="{DynamicResource AccountsType}"/>
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ApplicationPath}" Style="{StaticResource ValueStyle}" TextWrapping="Wrap"/>

            <Button Grid.Row="6"
                    Grid.ColumnSpan="2"
                    Content="{DynamicResource CloseButton}"
                    Style="{DynamicResource PrimaryBtnStyle}"
                    Padding="16,8"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0"
                    IsDefault="True"
                    Click="OnCloseClick"/>
        </Grid>
    </Border>
</Window>
