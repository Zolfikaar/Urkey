<Window x:Class="Urkey.WPF.Views.Windows.AddAddress"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Urkey.WPF.Views.Windows"
        mc:Ignorable="d"
        Title="{DynamicResource AddAddressTitle}"
        Width="520"
        Background="{DynamicResource BgColor}"
        Foreground="{DynamicResource TextColor}"
        FlowDirection="{DynamicResource AppFlowDirection}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="Height">
    <Border Style="{DynamicResource CardStyle}"
            Margin="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="FontFamily"
                            Value="Cairo"/>
                    <Setter Property="Foreground"
                            Value="{DynamicResource TextColor}"/>
                    <Setter Property="VerticalAlignment"
                            Value="Center"/>
                    <Setter Property="Margin"
                            Value="0,0,10,6"/>
                </Style>
                <Style TargetType="TextBox">
                    <Setter Property="Foreground"
                            Value="{DynamicResource TextColor}"/>
                    <Setter Property="Background"
                            Value="{DynamicResource InputBgColor}"/>
                    <Setter Property="BorderBrush"
                            Value="{DynamicResource BorderColor}"/>
                    <Setter Property="BorderThickness"
                            Value="1"/>
                    <Setter Property="Padding"
                            Value="10"/>
                    <Setter Property="Margin"
                            Value="0,0,0,12"/>
                </Style>
            </Grid.Resources>

            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Text="{DynamicResource AddressNameFieldTitle}"/>
            <TextBox x:Name="NameTextBox"
                     Grid.Row="0"
                     Grid.Column="1"/>

            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Text="{DynamicResource StreetFieldTitle}"/>
            <TextBox x:Name="StreetTextBox"
                     Grid.Row="1"
                     Grid.Column="1"/>

            <TextBlock Grid.Row="2"
                       Grid.Column="0"
                       Text="{DynamicResource CityFieldTitle}"/>
            <TextBox x:Name="CityTextBox"
                     Grid.Row="2"
                     Grid.Column="1"/>

            <TextBlock Grid.Row="3"
                       Grid.Column="0"
                       Text="{DynamicResource GovernorateFieldTitle}"/>
            <TextBox x:Name="GovernorateTextBox"
                     Grid.Row="3"
                     Grid.Column="1"/>

            <TextBlock Grid.Row="4"
                       Grid.Column="0"
                       Text="{DynamicResource ZipCodeFieldTitle}"/>
            <TextBox x:Name="ZipTextBox"
                     Grid.Row="4"
                     Grid.Column="1"/>

            <TextBlock Grid.Row="5"
                       Grid.Column="0"
                       Text="{DynamicResource CountryFieldTitle}"/>
            <TextBox x:Name="CountryTextBox"
                     Grid.Row="5"
                     Grid.Column="1"/>

            <TextBlock Grid.Row="6"
                       Grid.Column="0"
                       Text="{DynamicResource NotesFieldTitle}"/>
            <TextBox x:Name="NotesTextBox"
                     Grid.Row="6"
                     Grid.Column="1"
                     AcceptsReturn="True"
                     Height="80"
                     TextWrapping="Wrap"/>

            <StackPanel Grid.Row="7"
                        Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,10,0,0">
                <Button Content="{DynamicResource CancelButton}"
                        Style="{DynamicResource SecondaryBtnStyle}"
                        Margin="0,0,10,0"
                        Click="OnCancelClick" IsCancel="True"/>
                <Button Content="{DynamicResource SaveBtnTitle}"
                        Style="{DynamicResource PrimaryBtnStyle}"
                        Padding="16,8"
                        Click="OnSaveClick" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
