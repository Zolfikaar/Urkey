<Window x:Class="Urkey.WPF.Views.Windows.AddNote"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Urkey.WPF.Views.Windows"
        mc:Ignorable="d"
        Title="{DynamicResource AddNoteTitle}"
        Height="520"
        Width="520"
        Background="{DynamicResource BgColor}"
        Foreground="{DynamicResource TextColor}"
        FlowDirection="{DynamicResource AppFlowDirection}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Icon="pack://application:,,,/Assets/Icons/app-icon.ico"
        >
    <Border Style="{DynamicResource CardStyle}"
            Margin="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="FontFamily"
                            Value="Cairo"/>
                    <Setter Property="Foreground"
                            Value="{DynamicResource TextColor}"/>
                    <Setter Property="VerticalAlignment"
                            Value="Center"/>
                    <Setter Property="Margin"
                            Value="0,0,10,6"/>
                </Style>
                <Style TargetType="TextBox">
                    <Setter Property="Foreground"
                            Value="{DynamicResource TextColor}"/>
                    <Setter Property="Background"
                            Value="{DynamicResource InputBgColor}"/>
                    <Setter Property="BorderBrush"
                            Value="{DynamicResource BorderColor}"/>
                    <Setter Property="BorderThickness"
                            Value="1"/>
                    <Setter Property="Padding"
                            Value="10"/>
                    <Setter Property="Margin"
                            Value="0,0,0,12"/>
                </Style>
            </Grid.Resources>

            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Text="{DynamicResource TitleFieldTitle}"/>
            <TextBox x:Name="TitleTextBox"
                     Grid.Row="0"
                     Grid.Column="1"/>

            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Text="{DynamicResource ContentFieldTitle}"/>
            <TextBox x:Name="ContentTextBox"
                     Grid.Row="1"
                     Grid.Column="1"
                     AcceptsReturn="True"
                     Height="120"
                     TextWrapping="Wrap"/>

            <TextBlock Grid.Row="2"
                       Grid.Column="0"
                       Text="{DynamicResource CategoryFieldTitle}"/>
            <TextBox x:Name="CategoryTextBox"
                     Grid.Row="2"
                     Grid.Column="1"/>

            <TextBlock Grid.Row="3"
                       Grid.Column="0"
                       Text="{DynamicResource TagsFieldTitle}"/>
            <TextBox x:Name="TagsTextBox"
                     Grid.Row="3"
                     Grid.Column="1"
                     />

            <StackPanel Grid.Row="4"
                        Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,10,0,0">
                <Button Content="{DynamicResource CancelButton}"
                        Style="{DynamicResource SecondaryBtnStyle}"
                        Margin="0,0,10,0"
                        Click="OnCancelClick" IsCancel="True"/>
                <Button Content="{DynamicResource SaveBtnTitle}"
                        Style="{DynamicResource PrimaryBtnStyle}"
                        Padding="16,8"
                        Click="OnSaveClick" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
