<Window x:Class="Urkey.WPF.Views.Windows.ChangeMasterPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ChangeMasterPassword_Title}"
        Width="420"
        Height="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgColor}"
        Foreground="{DynamicResource TextColor}"
        FlowDirection="{DynamicResource AppFlowDirection}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{DynamicResource ChangeMasterPassword_Current}"
                       Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
            <PasswordBox x:Name="CurrentPasswordBox" Height="36" Padding="8,6"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <TextBlock Text="{DynamicResource ChangeMasterPassword_New}"
                       Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
            <PasswordBox x:Name="NewPasswordBox" Height="36" Padding="8,6"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,14">
            <TextBlock Text="{DynamicResource ChangeMasterPassword_Confirm}"
                       Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Height="36" Padding="8,6"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource CancelButton}"
                    MinWidth="100"
                    Margin="0,0,8,0"
                    Style="{StaticResource SecondaryBtnStyle}"
                    Click="OnCancelClick" IsCancel="True"/>
            <Button Content="{DynamicResource SaveBtnTitle}"
                    MinWidth="100"
                    Style="{StaticResource PrimaryBtnStyle}"
                    Click="OnSaveClick" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
