<Window x:Class="Urkey.WPF.Views.Windows.DocumentDetails"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{DynamicResource DocumentDetailsTitle}"
        Width="500"
        Background="{DynamicResource BgColor}"
        Foreground="{DynamicResource TextColor}"
        FlowDirection="{DynamicResource AppFlowDirection}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="Height">

    <Border Style="{DynamicResource CardStyle}"
            Margin="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="Cairo"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Margin" Value="0,0,10,12"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Style>

                <Style TargetType="TextBlock" x:Key="ValueStyle">
                    <Setter Property="FontFamily" Value="Cairo"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Margin" Value="0,0,0,12"/>
                </Style>
            </Grid.Resources>

            <!-- Name -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource DocumentNameFieldTitle}"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}" Style="{StaticResource ValueStyle}"/>

            <!-- Type -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource TypeFieldTitle}"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Type}" Style="{StaticResource ValueStyle}"/>

            <!-- Number -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource NumberFieldTitle}"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Number}" Style="{StaticResource ValueStyle}"/>

            <!-- Issuer -->
            <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource IssuerFieldTitle}"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Issuer}" Style="{StaticResource ValueStyle}"/>

            <!-- Expiry Date -->
            <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource ExpiryDateFieldTitle}"/>
            <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource ValueStyle}">
                <TextBlock.Text>
                    <Binding Path="ExpiryDate" Converter="{StaticResource LocaleDate}" ConverterParameter="d"/>
                </TextBlock.Text>
            </TextBlock>

            <!-- Notes -->
            <TextBlock Grid.Row="5" Grid.Column="0" Text="{DynamicResource NotesFieldTitle}" VerticalAlignment="Top" Margin="0,0,10,12"/>
            <TextBlock Grid.Row="5" Grid.Column="1" 
                      Text="{Binding Notes}" 
                      TextWrapping="Wrap"
                      Margin="0,0,0,12"
                      Foreground="{DynamicResource TextColor}"/>

            <!-- Close Button -->
            <Button Grid.Row="6" 
                   Grid.ColumnSpan="2"
                   Content="{DynamicResource CloseButton}"
                   Style="{DynamicResource PrimaryBtnStyle}"
                   Padding="16,8"
                   HorizontalAlignment="Right"
                   Margin="0,10,0,0"
                   Click="OnCloseClick"/>
        </Grid>
    </Border>
</Window>

