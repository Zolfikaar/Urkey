<Window x:Class="Urkey.WPF.Views.Windows.DocumentPreview"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource DocumentPreview_Title}"
        Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource BgColor}"
        Foreground="{DynamicResource TextColor}"
        FlowDirection="{DynamicResource AppFlowDirection}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="CircularButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                               CornerRadius="20"
                               Width="{TemplateBinding Width}"
                               Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Style="{DynamicResource CardStyle}" Margin="20" Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Height="60" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <!-- Document Title -->
                <StackPanel Grid.Column="0">
                    <TextBlock FontSize="20" 
                              FontWeight="Bold"
                              Foreground="{DynamicResource TextColor}"
                              Text="{Binding DocumentName}"/>
                    <TextBlock FontSize="12"
                              Foreground="{DynamicResource TextMutedColor}"
                              Margin="0,4,0,0"
                              Text="{Binding DocumentType}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DocumentType}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Zoom Controls -->
                <StackPanel Grid.Column="1" 
                           Orientation="Horizontal" 
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <Button Command="{Binding ZoomOutCommand}"
                            Style="{StaticResource CircularButtonStyle}"
                            Margin="0,0,8,0"
                            ToolTip="{DynamicResource ZoomOutButton}">
                        <TextBlock Text="−" 
                                  VerticalAlignment="Center" 
                                  HorizontalAlignment="Center"
                                  FontSize="18"
                                  Foreground="{DynamicResource TextColor}"/>
                    </Button>
                    <Slider Value="{Binding ZoomLevel}" 
                           Minimum="0.05" 
                           Maximum="3.0" 
                           Width="200"
                           TickFrequency="0.1"
                           IsSnapToTickEnabled="True"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           Cursor="Hand"
                           ToolTip="{DynamicResource ZoomResetButton}"/>
                    <Button Command="{Binding ZoomInCommand}"
                            Style="{StaticResource CircularButtonStyle}"
                            Margin="0,0,8,0"
                            ToolTip="{DynamicResource ZoomInButton}">
                        <TextBlock Text="+" 
                                  VerticalAlignment="Center" 
                                  HorizontalAlignment="Center"
                                  FontSize="18"
                                  Foreground="{DynamicResource TextColor}"/>
                    </Button>
                    <Button Command="{Binding ZoomResetCommand}"
                            Style="{StaticResource CircularButtonStyle}"
                            ToolTip="{DynamicResource ZoomResetButton}">
                        <TextBlock Text="{DynamicResource ZoomResetButton}" 
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"
                                  FontSize="12"
                                  Foreground="{DynamicResource TextColor}"/>
                    </Button>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" 
                           Orientation="Horizontal" 
                           HorizontalAlignment="Right" 
                           Margin="0,0,0,0">
                    <Button Style="{StaticResource CircularButtonStyle}"
                           Margin="0,0,8,0"
                           ToolTip="{DynamicResource RotateButton}"
                           Command="{Binding RotateCommand}">
                        <Path Data="{StaticResource bx_rotate}" 
                             Fill="{DynamicResource TextColor}"
                             Width="20" Height="20"/>
                    </Button>
                    <Button Style="{StaticResource CircularButtonStyle}"
                           Margin="0,0,8,0"
                           ToolTip="{DynamicResource EditButton}"
                           Click="OnEditClick">
                        <Path Data="{StaticResource bx_edit}" 
                             Fill="{DynamicResource TextColor}"
                             Width="20" Height="20"/>
                    </Button>
                    <Button Style="{StaticResource CircularButtonStyle}"
                           Margin="0,0,8,0"
                           ToolTip="{DynamicResource DownloadButton}"
                           Click="OnDownloadClick">
                        <Path Data="{StaticResource bx_download}" 
                             Fill="{DynamicResource TextColor}"
                             Width="20" Height="20"/>
                    </Button>
                    <Button Style="{StaticResource CircularButtonStyle}"
                           ToolTip="{DynamicResource DeleteButton}"
                           Click="OnDeleteClick">
                        <Path Data="{StaticResource bx_delete}" 
                             Fill="{DynamicResource TextColor}"
                             Width="20" Height="20"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Document Image Container -->
            <ScrollViewer Grid.Row="1" 
                         Background="{DynamicResource BgColor}"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"
                         x:Name="ImageScrollViewer"
                         HorizontalContentAlignment="Center"
                         VerticalContentAlignment="Center">
                <Grid x:Name="ImageContainer"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <Image Source="{Binding PreviewImage}"
                          Stretch="None"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          RenderTransformOrigin="0.5,0.5"
                          SnapsToDevicePixels="True"
                          RenderOptions.BitmapScalingMode="HighQuality"
                          RenderOptions.CachingHint="Cache">
                        <Image.LayoutTransform>
                            <TransformGroup>
                                <!-- Rotation transform (includes EXIF correction) -->
                                <RotateTransform Angle="{Binding RotationAngle}"/>
                                <!-- Zoom/scale transform -->
                                <ScaleTransform ScaleX="{Binding ZoomLevel}" 
                                              ScaleY="{Binding ZoomLevel}"/>
                            </TransformGroup>
                        </Image.LayoutTransform>
                    </Image>
                </Grid>
            </ScrollViewer>

            <!-- Debug HUD (toggleable) -->
            <Border Grid.Row="1"
                   Background="{DynamicResource OverlayScrimColor}"
                   Padding="8"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="10"
                   CornerRadius="4"
                   Visibility="{Binding ShowDebug, Converter={StaticResource BooleanToVisibilityConverter}}"
                   IsHitTestVisible="False">
                <StackPanel>
                    <TextBlock Text="Debug Info"
                              Foreground="{DynamicResource TextColor}"
                              FontWeight="Bold"
                              Margin="0,0,0,4"/>
                    <TextBlock Foreground="{DynamicResource TextColor}" FontSize="10">
                        <Run Text="Image: "/>
                        <Run Text="{Binding PreviewImage.PixelWidth, Mode=OneWay, StringFormat='{}{0}'}"/>
                        <Run Text=" × "/>
                        <Run Text="{Binding PreviewImage.PixelHeight, Mode=OneWay, StringFormat='{}{0}'}"/>
                    </TextBlock>
                    <TextBlock Foreground="{DynamicResource TextColor}" FontSize="10">
                        <Run Text="Viewport: "/>
                        <Run Text="{Binding ElementName=ImageScrollViewer, Path=ViewportWidth, Mode=OneWay, StringFormat='{}{0:F0}'}"/>
                        <Run Text=" × "/>
                        <Run Text="{Binding ElementName=ImageScrollViewer, Path=ViewportHeight, Mode=OneWay, StringFormat='{}{0:F0}'}"/>
                    </TextBlock>
                    <TextBlock Foreground="{DynamicResource TextColor}" FontSize="10">
                        <Run Text="Zoom: "/>
                        <Run Text="{Binding ZoomLevel, StringFormat='{}{0:F2}'}"/>
                    </TextBlock>
                    <TextBlock Foreground="{DynamicResource TextColor}" FontSize="10">
                        <Run Text="Rotation: "/>
                        <Run Text="{Binding RotationAngle, StringFormat='{}{0:F0}°'}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
