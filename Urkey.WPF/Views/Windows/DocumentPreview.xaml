<Window x:Class="Urkey.WPF.Views.Windows.DocumentPreview"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource DocumentPreview_Title}"
        Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#16181D"
        Foreground="{DynamicResource TextColor}"
        FlowDirection="{DynamicResource AppFlowDirection}"
        Icon="pack://application:,,,/Assets/Icons/app-icon.ico"
        >
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="CircularButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                               CornerRadius="20"
                               Width="{TemplateBinding Width}"
                               Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#33FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#1E2128"
                    BorderBrush="#2F343E"
                    BorderThickness="0,0,0,1"
                    Padding="16,10">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <!-- Document Title -->
                <StackPanel Grid.Column="0">
                    <TextBlock FontSize="18" 
                              FontWeight="Bold"
                              Foreground="White"
                              Text="{Binding DocumentName}"/>
                    <TextBlock FontSize="12"
                              Foreground="#9AA0AB"
                              Margin="0,4,0,0"
                              Text="{Binding DocumentType}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DocumentType}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Zoom Controls -->
                <StackPanel Grid.Column="1" 
                           Orientation="Horizontal" 
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <Button Command="{Binding ZoomOutCommand}"
                            Style="{StaticResource CircularButtonStyle}"
                            Margin="0,0,8,0"
                            ToolTip="{DynamicResource ZoomOutButton}">
                        <Viewbox Width="16" Height="16">
                            <Path Data="{StaticResource bx_minus}" Fill="White" Stretch="Uniform"/>
                        </Viewbox>
                    </Button>
                    <Slider Value="{Binding ZoomLevel}" 
                           Minimum="0.05" 
                           Maximum="3.0" 
                           Width="180"
                           TickFrequency="0.1"
                           IsSnapToTickEnabled="True"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           Cursor="Hand"
                           ToolTip="{DynamicResource ZoomResetButton}"/>
                    <Button Command="{Binding ZoomInCommand}"
                            Style="{StaticResource CircularButtonStyle}"
                            Margin="0,0,8,0"
                            ToolTip="{DynamicResource ZoomInButton}">
                        <Viewbox Width="16" Height="16">
                            <Path Data="{StaticResource bx_plus}" Fill="White" Stretch="Uniform"/>
                        </Viewbox>
                    </Button>
                    <Button Command="{Binding ZoomResetCommand}"
                            Style="{StaticResource CircularButtonStyle}"
                            ToolTip="{DynamicResource ZoomResetButton}">
                        <Viewbox Width="16" Height="16">
                            <Path Data="{StaticResource bx_search}" Fill="White" Stretch="Uniform"/>
                        </Viewbox>
                    </Button>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" 
                           Orientation="Horizontal" 
                           HorizontalAlignment="Right">
                    <Button Style="{StaticResource CircularButtonStyle}"
                           Margin="0,0,8,0"
                           ToolTip="{DynamicResource RotateButton}"
                           Command="{Binding RotateCommand}">
                        <Path Data="{StaticResource bx_rotate}" 
                             Fill="White"
                             Width="18" Height="18"/>
                    </Button>
                    <Button Style="{StaticResource CircularButtonStyle}"
                           Margin="0,0,8,0"
                           ToolTip="{DynamicResource EditButton}"
                           Click="OnEditClick">
                        <Path Data="{StaticResource bx_edit}" 
                             Fill="White"
                             Width="18" Height="18"/>
                    </Button>
                    <Button Style="{StaticResource CircularButtonStyle}"
                           Margin="0,0,8,0"
                           ToolTip="{DynamicResource DownloadButton}"
                           Click="OnDownloadClick">
                        <Path Data="{StaticResource bx_download}" 
                             Fill="White"
                             Width="18" Height="18"/>
                    </Button>
                    <Button Style="{StaticResource CircularButtonStyle}"
                           ToolTip="{DynamicResource DeleteButton}"
                           Click="OnDeleteClick">
                        <Path Data="{StaticResource bx_delete}" 
                             Fill="White"
                             Width="18" Height="18"/>
                    </Button>
                </StackPanel>
            </Grid>
            </Border>

            <!-- Document Image Container -->
            <ScrollViewer Grid.Row="1" 
                         Background="#16181D"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"
                         x:Name="ImageScrollViewer"
                         HorizontalContentAlignment="Center"
                         VerticalContentAlignment="Center">
                <Grid x:Name="ImageContainer"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Margin="24">
                    <Border Background="#2A2E36" CornerRadius="6" Padding="10">
                    <Image Source="{Binding PreviewImage}"
                          Stretch="None"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          RenderTransformOrigin="0.5,0.5"
                          SnapsToDevicePixels="True"
                          RenderOptions.BitmapScalingMode="HighQuality"
                          RenderOptions.CachingHint="Cache">
                        <Image.LayoutTransform>
                            <TransformGroup>
                                <RotateTransform Angle="{Binding RotationAngle}"/>
                                <ScaleTransform ScaleX="{Binding ZoomLevel}" 
                                              ScaleY="{Binding ZoomLevel}"/>
                            </TransformGroup>
                        </Image.LayoutTransform>
                    </Image>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- Debug HUD (toggleable) -->
            <Border Grid.Row="1"
                   Background="{DynamicResource OverlayScrimColor}"
                   Padding="8"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="10"
                   CornerRadius="4"
                   Visibility="{Binding ShowDebug, Converter={StaticResource BooleanToVisibilityConverter}}"
                   IsHitTestVisible="False">
                <StackPanel>
                    <TextBlock Text="Debug Info"
                              Foreground="White"
                              FontWeight="Bold"
                              Margin="0,0,0,4"/>
                    <TextBlock Foreground="White" FontSize="10">
                        <Run Text="Zoom: "/>
                        <Run Text="{Binding ZoomLevel, StringFormat='{}{0:F2}'}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
    </Grid>
</Window>
