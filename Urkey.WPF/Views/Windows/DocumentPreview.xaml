<Window x:Class="Urkey.WPF.Views.Windows.DocumentPreview"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Document Preview"
        Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgColor}">

    <Border Style="{DynamicResource CardStyle}" Margin="20" Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- الصورة -->
            <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Image x:Name="DocumentImage"
                       Stretch="Uniform"
                       MaxHeight="520"
                       MaxWidth="760"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            </ScrollViewer>

            <!-- الأزرار -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Export Image"
                        Style="{DynamicResource SecondaryBtnStyle}"
                        Margin="0,0,10,0"
                        Click="OnExportClick"/>
                <Button Content="Close"
                        Style="{DynamicResource PrimaryBtnStyle}"
                        Padding="16,8"
                        Click="OnCloseClick"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
