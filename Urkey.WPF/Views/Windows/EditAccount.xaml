<Window x:Class="Urkey.WPF.Views.Windows.EditAccount"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:Urkey.WPF.Converters"
        mc:Ignorable="d"
        Title="{DynamicResource EditAccountTitle}"
        Height="640"
        Width="540"
        Background="{DynamicResource BgColor}"
        Foreground="{DynamicResource TextColor}"
        FlowDirection="{DynamicResource AppFlowDirection}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinWidth="480"
        MinHeight="520">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBgColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource InputBgColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Height" Value="40"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource FormComboBoxStyle}"/>
        <Style x:Key="IconOnlyBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <Viewbox Width="18" Height="18"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Path Data="{TemplateBinding Tag}"
                                      Fill="{TemplateBinding Foreground}"
                                      Stretch="Uniform"/>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource HoverColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{DynamicResource CardStyle}" Margin="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource AccountTypeTitle}" VerticalAlignment="Center"/>
                    <ComboBox x:Name="AccountTypeCombo" Grid.Column="1" SelectionChanged="OnAccountTypeChanged">
                        <ComboBoxItem Content="{DynamicResource AccountTypeWebsite}" Tag="Website"/>
                        <ComboBoxItem Content="{DynamicResource AccountsType}" Tag="Application"/>
                        <ComboBoxItem Content="{DynamicResource OtherType}" Tag="Other"/>
                    </ComboBox>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource AccountNameFieldTitle}" VerticalAlignment="Center"/>
                    <TextBox x:Name="AccountNameTextBox" Grid.Column="1" Margin="0"/>
                </Grid>

                <Border Grid.Row="2" Style="{DynamicResource CardStyle}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource DetailsTitle}" FontWeight="Bold" Margin="0,0,0,10"/>
                        <StackPanel x:Name="WebsitePanel">
                            <TextBlock Text="{DynamicResource WebsiteFieldTitle}"/>
                            <TextBox x:Name="WebsiteTextBox"/>
                        </StackPanel>
                        <StackPanel x:Name="ApplicationPanel">
                            <TextBlock Text="{DynamicResource AccountNameFieldTitle}"/>
                            <TextBox x:Name="AppNameTextBox"/>
                            <TextBlock Text="{DynamicResource LicenseKeyFieldTitle}"/>
                            <TextBox x:Name="LicenseKeyTextBox"/>
                        </StackPanel>
                        <StackPanel x:Name="OtherPanel">
                            <TextBlock Text="{DynamicResource CategoryFieldTitle}"/>
                            <TextBox x:Name="CategoryTextBox"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="3" Style="{DynamicResource CardStyle}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource CredentialsTitle}" FontWeight="Bold" Margin="0,0,0,10"/>

                        <TextBlock Text="{DynamicResource UserNameFieldTitle}"/>
                        <TextBox x:Name="UsernameTextBox"/>

                        <TextBlock Text="{DynamicResource PasswordFieldTitle}"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="PasswordBox" Grid.Column="0" Margin="0"/>
                            <TextBox x:Name="PasswordRevealBox" Grid.Column="0" Visibility="Collapsed" Margin="0"/>
                            <Button Grid.Column="1"
                                    Style="{StaticResource IconOnlyBtnStyle}"
                                    Tag="{StaticResource bx_eye}"
                                    ToolTip="{DynamicResource ShowBtnTitle}"
                                    Click="OnToggleShowPassword_Click"/>
                            <Button Grid.Column="2"
                                    Style="{StaticResource IconOnlyBtnStyle}"
                                    Tag="{StaticResource bx_copy}"
                                    ToolTip="{DynamicResource CopyBtnTitle}"
                                    Click="OnCopyPassword_Click"/>
                        </Grid>

                        <TextBlock Text="{DynamicResource EmailFieldTitle}"/>
                        <TextBox x:Name="EmailTextBox"/>

                        <TextBlock Text="{DynamicResource NotesFieldTitle}"/>
                        <TextBox x:Name="NotesTextBox"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="80"
                                 VerticalContentAlignment="Top"
                                 Margin="0"/>
                    </StackPanel>
                </Border>

                <DockPanel Grid.Row="4" Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource AutologinTitle}" Margin="0,0,8,0"/>
                        <ToggleButton Content="{DynamicResource DisabledText}"
                                      Width="90"
                                      Style="{DynamicResource PrimaryToggleButtonStyle}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <Button Content="{DynamicResource CancelButton}"
                                Style="{StaticResource SecondaryBtnStyle}"
                                MinWidth="90"
                                Margin="0,0,8,0"
                                Click="OnCancelClick"
                                IsCancel="True"/>
                        <Button Content="{DynamicResource SaveBtnTitle}"
                                Style="{StaticResource PrimaryBtnStyle}"
                                MinWidth="90"
                                Click="OnSaveClick"
                                IsDefault="True"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>
    </ScrollViewer>
</Window>
