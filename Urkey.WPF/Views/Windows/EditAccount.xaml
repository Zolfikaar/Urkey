<Window x:Class="Urkey.WPF.Views.Windows.EditAccount"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:Urkey.WPF.Converters"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Edit Account"
        Height="560"
        Width="520"
        Background="{DynamicResource BgColor}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="Height">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <sys:String x:Key="AccountTypeTitle">Account Type</sys:String>
        <sys:String x:Key="AccountNameFieldTitle">Account Name</sys:String>
        <sys:String x:Key="UserNameFieldTitle">Username</sys:String>
        <sys:String x:Key="PasswordFieldTitle">Password</sys:String>
        <sys:String x:Key="EmailFieldTitle">Email</sys:String>
        <sys:String x:Key="WebsiteFieldTitle">Website</sys:String>
        <sys:String x:Key="AppNameFieldTitle">App Name</sys:String>
        <sys:String x:Key="LicenseKeyFieldTitle">License Key</sys:String>
        <sys:String x:Key="NotesFieldTitle">Notes</sys:String>
        <sys:String x:Key="CategoryFieldTitle">Category</sys:String>
    </Window.Resources>

    <Border Style="{DynamicResource CardStyle}" Margin="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: type and account name -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{StaticResource AccountTypeTitle}" />
                <ComboBox x:Name="AccountTypeCombo" Grid.Column="1" SelectionChanged="OnAccountTypeChanged">
                    <ComboBoxItem Content="Website"/>
                    <ComboBoxItem Content="Application"/>
                    <ComboBoxItem Content="Other"/>
                </ComboBox>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{StaticResource AccountNameFieldTitle}" />
                <TextBox x:Name="AccountNameTextBox" Grid.Column="1" />
            </Grid>

            <!-- Type-specific group and Accounts info -->
            <StackPanel Grid.Row="2" Orientation="Vertical">
                <Border Style="{DynamicResource CardStyle}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Item type" FontWeight="Bold" DockPanel.Dock="Left"/>
                            <TextBlock Text="{StaticResource AccountTypeTitle}" Foreground="{DynamicResource SubTextColor}" Margin="6,0,0,0"/>
                        </DockPanel>
                        <StackPanel x:Name="WebsitePanel">
                            <TextBlock Text="{StaticResource WebsiteFieldTitle}" />
                            <TextBox x:Name="WebsiteTextBox" />
                        </StackPanel>
                        <StackPanel x:Name="ApplicationPanel">
                            <TextBlock Text="{StaticResource AppNameFieldTitle}" />
                            <TextBox x:Name="AppNameTextBox" />
                            <TextBlock Text="{StaticResource LicenseKeyFieldTitle}" />
                            <TextBox x:Name="LicenseKeyTextBox" />
                        </StackPanel>
                        <StackPanel x:Name="OtherPanel">
                            <TextBlock Text="{StaticResource CategoryFieldTitle}" />
                            <TextBox x:Name="CategoryTextBox" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource CardStyle}" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,8">
                            <TextBlock Text="Accounts" FontWeight="Bold" DockPanel.Dock="Left"/>
                            <Button Content="+ Add" Style="{DynamicResource SecondaryBtnStyle}" Width="68" Height="26" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                        </DockPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{StaticResource UserNameFieldTitle}" />
                        <TextBox x:Name="UsernameTextBox" Grid.Row="1" Grid.Column="1" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{StaticResource PasswordFieldTitle}" />
                        <Grid Grid.Row="2" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="PasswordBox" Grid.Column="0" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center">
                                <Button Content="👁" Width="28" Height="28" Style="{DynamicResource SecondaryBtnStyle}" Margin="0,0,4,0"/>
                                <Button Content="📋" Width="28" Height="28" Style="{DynamicResource SecondaryBtnStyle}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{StaticResource EmailFieldTitle}" />
                        <TextBox x:Name="EmailTextBox" Grid.Row="3" Grid.Column="1" />

                        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Password change history" Foreground="{DynamicResource SubTextColor}" />
                            <TextBlock Text=" ▼" Foreground="{DynamicResource SubTextColor}" />
                        </StackPanel>

                        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Add comment" Foreground="{DynamicResource PrimaryColor}" Cursor="Hand"/>
                        </StackPanel>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="{StaticResource NotesFieldTitle}" />
                        <TextBox x:Name="NotesTextBox" Grid.Row="6" Grid.Column="1" AcceptsReturn="True" TextWrapping="Wrap" Height="80"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Footer -->
            <DockPanel Grid.Row="3" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Autologin" Margin="0,0,8,0"/>
                    <ToggleButton Content="Disabled" Width="80"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="{DynamicResource CancelBtnTitle}" Style="{DynamicResource SecondaryBtnStyle}" Click="OnCancelClick"/>
                    <Button Content="{DynamicResource SaveBtnTitle}" Style="{DynamicResource PrimaryBtnStyle}" Padding="16,8" Click="OnSaveClick"/>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
