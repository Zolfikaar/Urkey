<Window x:Class="Urkey.WPF.Views.Windows.FirstTimeSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uc="clr-namespace:Urkey.WPF.UserControls"
        WindowStyle="SingleBorderWindow"
        WindowState="Maximized"
        ResizeMode="CanResize"
        Background="{DynamicResource AuthBgColor}"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/Icons/favicon.ico"
        Title="{DynamicResource FirstTimeSetupWindow_Title}"
        FlowDirection="{DynamicResource AppFlowDirection}">

    <Grid>
        <Image Source="/Assets/Backgrounds/splash-bg.jpg"
               Stretch="UniformToFill"
               Opacity="0.92"/>

        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MinWidth="400"
                MaxWidth="440"
                Padding="{StaticResource CardPadding}"
                Background="{DynamicResource AuthPanelBg}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                CornerRadius="{StaticResource CardCornerRadius}"
                Effect="{StaticResource CardShadow}">

            <StackPanel>

                <TextBlock Text="{DynamicResource Setup_WelcomeTitle}"
                           Style="{StaticResource Text.AuthTitle}"
                           Margin="0,0,0,8"/>

                <TextBlock Text="{DynamicResource Setup_WelcomeSubtitle}"
                           Style="{StaticResource Text.AuthSubtitle}"
                           Margin="0,0,0,28"/>

                <TextBlock Text="{DynamicResource Setup_MasterPasswordTitle}"
                           Style="{StaticResource Text.AuthLabel}"/>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <PasswordBox x:Name="MasterPasswordBox"
                                 Grid.Column="0"
                                 Style="{StaticResource AuthPasswordBoxStyle}"
                                 KeyDown="PasswordBox_KeyDown"/>

                    <TextBox x:Name="MasterPasswordTextBox"
                             Grid.Column="0"
                             Style="{StaticResource AuthTextBoxStyle}"
                             Visibility="Collapsed"
                             KeyDown="PasswordBox_KeyDown"/>

                    <Button x:Name="MasterShowBtn"
                            Grid.Column="1"
                            Style="{StaticResource AuthIconBtnStyle}"
                            Click="ToggleMasterPasswordButton_Click"
                            ToolTip="{DynamicResource UnlockWindow_ShowPassword}">
                        <Path Data="{StaticResource bx_eye}"
                              Width="20"
                              Height="20"
                              Fill="{DynamicResource AuthTextColor}"
                              Stretch="Uniform"/>
                    </Button>
                </Grid>

                <TextBlock x:Name="MasterWarning"
                           Text=""
                           Foreground="{DynamicResource ErrorColor}"
                           FontSize="{StaticResource FontSizeCaption}"
                           Margin="0,4,0,12"/>

                <TextBlock Text="{DynamicResource Setup_MasterPasswordConfirmTitle}"
                           Style="{StaticResource Text.AuthLabel}"/>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <PasswordBox x:Name="ConfirmPasswordBox"
                                 Grid.Column="0"
                                 Style="{StaticResource AuthPasswordBoxStyle}"
                                 KeyDown="PasswordBox_KeyDown"/>

                    <TextBox x:Name="ConfirmPasswordTextBox"
                             Grid.Column="0"
                             Style="{StaticResource AuthTextBoxStyle}"
                             Visibility="Collapsed"
                             KeyDown="PasswordBox_KeyDown"/>

                    <Button x:Name="ConfirmShowBtn"
                            Grid.Column="1"
                            Style="{StaticResource AuthIconBtnStyle}"
                            Click="ToggleConfirmPasswordButton_Click"
                            ToolTip="{DynamicResource UnlockWindow_ShowPassword}">
                        <Path Data="{StaticResource bx_eye}"
                              Width="20"
                              Height="20"
                              Fill="{DynamicResource AuthTextColor}"
                              Stretch="Uniform"/>
                    </Button>
                </Grid>

                <TextBlock x:Name="ConfirmWarning"
                           Text=""
                           Foreground="{DynamicResource ErrorColor}"
                           FontSize="{StaticResource FontSizeCaption}"
                           Margin="0,4,0,12"/>

                <TextBlock Text="{DynamicResource EmailFieldTitle}"
                           Style="{StaticResource Text.AuthLabel}"/>

                <TextBox x:Name="EmailBox"
                         Style="{StaticResource AuthTextBoxStyle}"/>

                <TextBlock x:Name="EmailWarning"
                           Text=""
                           Foreground="{DynamicResource ErrorColor}"
                           FontSize="{StaticResource FontSizeCaption}"
                           Margin="0,4,0,12"/>

                <TextBlock Text="{DynamicResource Setup_PhoneTitle}"
                           Style="{StaticResource Text.AuthLabel}"/>

                <TextBox x:Name="PhoneBox"
                         Style="{StaticResource AuthTextBoxStyle}"/>

                <TextBlock x:Name="PhoneWarning"
                           Text=""
                           Foreground="{DynamicResource ErrorColor}"
                           FontSize="{StaticResource FontSizeCaption}"
                           Margin="0,4,0,24"/>

                <Button x:Name="ContinueBtn"
                        Content="{DynamicResource Setup_ContinueButton}"
                        Style="{StaticResource AuthPrimaryBtnStyle}"
                        HorizontalAlignment="Stretch"
                        IsDefault="True"
                        Click="ContinueBtn_Click"/>
            </StackPanel>
        </Border>

        <Button x:Name="SettingsButton"
                Style="{StaticResource AuthSettingsBtnStyle}"
                Click="SettingsButton_Click"/>

        <Popup x:Name="SettingsPopup"
               Placement="Top"
               PlacementTarget="{Binding ElementName=SettingsButton}"
               StaysOpen="False"
               PopupAnimation="Fade">
            <Border Style="{StaticResource AuthPopupPanelStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings_Title}"
                               Foreground="{DynamicResource AuthTextColor}"
                               FontSize="{StaticResource FontSizeSubtitle}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"
                               HorizontalAlignment="Center"/>

                    <Button Content="{DynamicResource Settings_ChangeLanguage}"
                            Background="Transparent"
                            Foreground="{DynamicResource AuthTextColor}"
                            BorderThickness="0"
                            FontSize="{StaticResource FontSizeBody}"
                            Padding="6"
                            Cursor="Hand"
                            HorizontalAlignment="Center"
                            Click="ChangeLanguage_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Foreground" Value="{DynamicResource AuthTextColor}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentGold}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>

        <uc:ToastHost Panel.ZIndex="100"
                      Margin="24"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Bottom"
                      FlowDirection="{DynamicResource AppFlowDirection}"/>
    </Grid>
</Window>
