<Window x:Class="Urkey.WPF.Views.Windows.ImportPasswordsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Urkey.WPF.ViewModels"
        Title="{DynamicResource Import_WindowTitle}"
        Width="820"
        Height="560"
        MinWidth="700"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource BgColor}"
        Foreground="{DynamicResource TextColor}"
        FlowDirection="{DynamicResource AppFlowDirection}"
        Closing="OnClosing"
        Icon="pack://application:,,,/Assets/Icons/app-icon.ico"
        >

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="HeaderTitle"
                       Text="{DynamicResource Import_WindowTitle}"
                       Style="{StaticResource Text.SectionTitle}"
                       Margin="0,0,0,6"/>
            <TextBlock x:Name="HeaderSubtitle"
                       Text="{DynamicResource Import_Parsing}"
                       Style="{StaticResource Text.BodyMuted}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Content host -->
        <Grid Grid.Row="1">
            <!-- Parsing / Importing progress -->
            <StackPanel x:Name="ProgressPanel"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <ProgressBar x:Name="BusyProgress"
                             IsIndeterminate="True"
                             Width="280"
                             Height="8"
                             Margin="0,0,0,12"/>
                <TextBlock x:Name="ProgressText"
                           Text="{DynamicResource Import_Parsing}"
                           Style="{StaticResource Text.BodyMuted}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Column mapping -->
            <ScrollViewer x:Name="MappingPanel"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{DynamicResource Import_Mapping_Name}"
                                   Style="{StaticResource Text.Body}"
                                   VerticalAlignment="Center"/>
                        <ComboBox Style="{StaticResource FormComboBoxStyle}" x:Name="MapNameCombo"
                                  Grid.Column="1"
                                  MinHeight="32"
                                  DisplayMemberPath="Display"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{DynamicResource Import_Mapping_Url}"
                                   Style="{StaticResource Text.Body}"
                                   VerticalAlignment="Center"/>
                        <ComboBox Style="{StaticResource FormComboBoxStyle}" x:Name="MapUrlCombo"
                                  Grid.Column="1"
                                  MinHeight="32"
                                  DisplayMemberPath="Display"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{DynamicResource Import_Mapping_Username}"
                                   Style="{StaticResource Text.Body}"
                                   VerticalAlignment="Center"/>
                        <ComboBox Style="{StaticResource FormComboBoxStyle}" x:Name="MapUsernameCombo"
                                  Grid.Column="1"
                                  MinHeight="32"
                                  DisplayMemberPath="Display"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{DynamicResource Import_Mapping_Email}"
                                   Style="{StaticResource Text.Body}"
                                   VerticalAlignment="Center"/>
                        <ComboBox Style="{StaticResource FormComboBoxStyle}" x:Name="MapEmailCombo"
                                  Grid.Column="1"
                                  MinHeight="32"
                                  DisplayMemberPath="Display"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{DynamicResource Import_Mapping_Password}"
                                   Style="{StaticResource Text.Body}"
                                   VerticalAlignment="Center"/>
                        <ComboBox Style="{StaticResource FormComboBoxStyle}" x:Name="MapPasswordCombo"
                                  Grid.Column="1"
                                  MinHeight="32"
                                  DisplayMemberPath="Display"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{DynamicResource Import_Mapping_Notes}"
                                   Style="{StaticResource Text.Body}"
                                   VerticalAlignment="Center"/>
                        <ComboBox Style="{StaticResource FormComboBoxStyle}" x:Name="MapNotesCombo"
                                  Grid.Column="1"
                                  MinHeight="32"
                                  DisplayMemberPath="Display"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- Preview -->
            <Grid x:Name="PreviewPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="PreviewCountText"
                           Grid.Row="0"
                           Style="{StaticResource Text.Body}"
                           Margin="0,0,0,10"/>

                <DockPanel Grid.Row="1" Margin="0,0,0,10" LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button Content="{DynamicResource Import_SelectAll}"
                                Style="{StaticResource SecondaryBtnStyle}"
                                Padding="10,4"
                                Margin="0,0,8,0"
                                Click="OnSelectAllClick"/>
                        <Button Content="{DynamicResource Import_DeselectAll}"
                                Style="{StaticResource SecondaryBtnStyle}"
                                Padding="10,4"
                                Click="OnDeselectAllClick"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                DockPanel.Dock="Right"
                                VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Import_Duplicates_Global}"
                                   Style="{StaticResource Text.BodyMuted}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <ComboBox Style="{StaticResource FormComboBoxStyle}" x:Name="GlobalDuplicateCombo"
                                  MinWidth="160"
                                  MinHeight="30"
                                  SelectionChanged="OnGlobalDuplicateChanged">
                            <ComboBoxItem x:Name="DupSkipItem" Content="{DynamicResource Import_Dup_Skip}" Tag="Skip"/>
                            <ComboBoxItem x:Name="DupImportItem" Content="{DynamicResource Import_Dup_ImportAnyway}" Tag="ImportAnyway"/>
                            <ComboBoxItem x:Name="DupOverwriteItem" Content="{DynamicResource Import_Dup_Overwrite}" Tag="Overwrite"/>
                        </ComboBox>
                    </StackPanel>
                </DockPanel>

                <DataGrid x:Name="PreviewGrid"
                          Grid.Row="2"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          RowHeight="36"
                          IsReadOnly="False"
                          Background="Transparent"
                          BorderBrush="{DynamicResource BorderColor}"
                          BorderThickness="1"
                          AlternatingRowBackground="{DynamicResource CardBgColor}">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                Width="40"/>
                        <DataGridTextColumn Header="{DynamicResource Column_Service}"
                                            Binding="{Binding ServiceName}"
                                            IsReadOnly="True"
                                            Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource WebsiteFieldTitle}"
                                            Binding="{Binding Url}"
                                            IsReadOnly="True"
                                            Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource Column_Username}"
                                            Binding="{Binding Username}"
                                            IsReadOnly="True"
                                            Width="140"/>
                        <DataGridTextColumn Header="{DynamicResource PasswordFieldTitle}"
                                            Binding="{Binding MaskedPassword}"
                                            IsReadOnly="True"
                                            Width="100"/>
                        <DataGridTemplateColumn Header="{DynamicResource Import_Duplicate}"
                                                Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:ImportPreviewItem}">
                                    <ComboBox Style="{StaticResource FormComboBoxStyle}" SelectedIndex="{Binding DuplicateResolution, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Visibility="{Binding DuplicateBadgeVisible, Converter={StaticResource BoolToVisibility}}"
                                              Height="28"
                                              MinHeight="28"
                                              Padding="8,0">
                                        <ComboBoxItem Content="{DynamicResource Import_Dup_Skip}"/>
                                        <ComboBoxItem Content="{DynamicResource Import_Dup_ImportAnyway}"/>
                                        <ComboBoxItem Content="{DynamicResource Import_Dup_Overwrite}"/>
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- Summary -->
            <StackPanel x:Name="SummaryPanel"
                        Visibility="Collapsed"
                        VerticalAlignment="Center">
                <TextBlock x:Name="SummaryTitle"
                           Text="{DynamicResource Import_Summary_Title}"
                           Style="{StaticResource Text.SectionTitle}"
                           Margin="0,0,0,12"/>
                <TextBlock x:Name="SummaryImported"
                           Style="{StaticResource Text.Body}"
                           Margin="0,0,0,6"/>
                <TextBlock x:Name="SummarySkipped"
                           Style="{StaticResource Text.Body}"
                           Margin="0,0,0,6"/>
                <TextBlock x:Name="SummaryOverwritten"
                           Style="{StaticResource Text.Body}"
                           Margin="0,0,0,6"/>
                <TextBlock x:Name="SummaryFailed"
                           Style="{StaticResource Text.Body}"
                           Margin="0,0,0,12"/>
                <TextBlock x:Name="SummaryFailuresDetail"
                           Style="{StaticResource Text.BodyMuted}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16"
                           MaxHeight="120"
                           Visibility="Collapsed"/>

                <CheckBox x:Name="SecureDeleteCheck"
                          Content="{DynamicResource Import_SecureDelete}"
                          IsChecked="True"
                          FontSize="14"
                          Foreground="{DynamicResource TextColor}"
                          Margin="0,0,0,8"/>
                <TextBlock Text="{DynamicResource Import_SecureDelete_Hint}"
                           Style="{StaticResource Text.BodyMuted}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <!-- Footer buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="CancelButton"
                    Content="{DynamicResource CancelButton}"
                    MinWidth="100"
                    Margin="0,0,8,0"
                    Style="{StaticResource SecondaryBtnStyle}"
                    Click="OnCancelClick"/>
            <Button x:Name="PrimaryButton"
                    Content="{DynamicResource Import_Continue}"
                    MinWidth="120"
                    Style="{StaticResource PrimaryBtnStyle}"
                    Click="OnPrimaryClick"
                    IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>
