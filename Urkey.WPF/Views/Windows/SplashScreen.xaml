<Window x:Class="Urkey.WPF.Views.Windows.SplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        WindowState="Maximized"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource AuthBgColor}"
        FlowDirection="{DynamicResource AppFlowDirection}"
        Loaded="SplashScreen_Loaded"
        Icon="pack://application:,,,/Assets/Icons/app-icon.ico"
        >

    <Grid>
        <Image Source="/Assets/Backgrounds/splash-bg.jpg"
               Stretch="UniformToFill"
               Opacity="0.92"/>

        <Image Source="/Assets/Logos/Logo_with_bg.png"
               Width="640"
               Height="900"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Margin="0,0,0,130"
               Opacity="1"/>

        <TextBlock Text="{DynamicResource AppTitle}"
                   Foreground="{DynamicResource AuthTextColor}"
                   FontSize="64"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,150"/>

        <TextBlock Text="{DynamicResource SplashScreen_Tagline}"
                   Foreground="{DynamicResource AccentGold}"
                   FontSize="22"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,100"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   MaxWidth="600"/>
    </Grid>
</Window>
