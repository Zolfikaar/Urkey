<Window x:Class="Urkey.WPF.Views.Windows.SplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Loaded="Window_Loaded">

    <Grid>
        <!-- Background -->
        <Grid.Background>
            <ImageBrush ImageSource="/Assets/Backgrounds/splash-bg.jpg"
                        Stretch="Fill"/>
        </Grid.Background>

        <!-- ========================================= -->
        <!-- 1) GLOW — خلف اللوغو — يظهر شعاعه فقط -->
        <!-- ========================================= -->

        <Ellipse x:Name="glowCircle"
                 Width="150"
                 Height="150"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Fill="#FFEFC36D"
                 Margin="0,0,0,200"
                 Opacity="0">

            <Ellipse.Effect>
                <BlurEffect Radius="80"/>
            </Ellipse.Effect>

            <Ellipse.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>

                            <!-- ظهور التوهج (يبدأ بعد 0.5 ثانية) -->
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0"
                                             To="0.4"
                                             BeginTime="0:0:0.1"
                                             Duration="0:0:3"/>

                            <!-- التمدد من صغير جداً إلى حجم متوسط (أصغر بكثير من اللوغو) -->
                            <!-- اللوغو 640x900، التوهج يصل إلى 400 كحد أقصى -->
                            <DoubleAnimation Storyboard.TargetProperty="Width"
                                             From="150"
                                             To="270"
                                             BeginTime="0:0:0.1"
                                             Duration="0:0:3"/>

                            <DoubleAnimation Storyboard.TargetProperty="Height"
                                             From="150"
                                             To="270"
                                             BeginTime="0:0:0.5"
                                             Duration="0:0:3.5"/>

                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Ellipse.Triggers>
        </Ellipse>

        <!-- ============================== -->
        <!-- 2) LOGO — ثابت لا يتحرك أبداً -->
        <!-- ============================== -->
        <Image Source="/Assets/Logos/Logo_with_bg.png"
               Width="640"
               Height="900"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Margin="0,0,0,130"
               Opacity="1"/>

        <!-- اسم التطبيق -->
        <TextBlock Text="{DynamicResource SplashScreen_AppName}"
                   Foreground="White"
                   FontSize="75"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,150"/>

        <!-- الوصف -->
        <TextBlock Text="{DynamicResource SplashScreen_Tagline}"
                   Foreground="White"
                   FontSize="28"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,100"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   MaxWidth="600"/>
    </Grid>
</Window>
