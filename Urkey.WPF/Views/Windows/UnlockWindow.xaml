<Window x:Class="Urkey.WPF.Views.Windows.UnlockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Urkey.WPF.Views.Windows"
        Title="{DynamicResource UnlockWindow_Title}"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        WindowState="Normal"
        Width="1200"
        Height="800"
        WindowStartupLocation="CenterScreen"
        Background="#001E57"
        AllowsTransparency="False"
        ShowInTaskbar="True"
        Topmost="False"
        Icon="/Assets/Icons/favicon.ico">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <!-- خلفية الصورة -->
        <Image Source="/Assets/Backgrounds/splash-bg.jpg"
               Stretch="Fill"
               Opacity="0.95"/>

        <!-- التوهج الخلفي - ثابت بدون حركة -->
        <Ellipse Width="180"
                 Height="180"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Margin="0,0,0,70"
                 Fill="#FFD9BD56"
                 Opacity="0.4">
            <Ellipse.Effect>
                <BlurEffect Radius="70"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- شعار التطبيق - ثابت بدون حركة -->
        <Grid x:Name="LogoContainer"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Margin="0,0,0,100"
              Opacity="1">
            <Image Source="/Assets/Logos/Logo_with_bg.png"
                   Width="640"
                   Height="900"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
        </Grid>

        <!-- منطقة الإدخال -->
        <StackPanel x:Name="InputPanel"
                    VerticalAlignment="Bottom"
                    Margin="0 0 0 100"
                    Opacity="1"
                    HorizontalAlignment="Center">

            <!-- رسالة الحافظة مقفلة -->
            <TextBlock Text="{DynamicResource UnlockWindow_VaultLocked}"
                       Foreground="White"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,0"/>

            <TextBlock Text="{DynamicResource UnlockWindow_EnterMasterPassword}"
                       Foreground="#E2BD56"
                       FontSize="16"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       MaxWidth="400"/>

            <!-- حقل كلمة المرور مع أيقونة العين -->
            <Grid HorizontalAlignment="Center"
                  Width="320"
                  Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <PasswordBox x:Name="MasterPasswordBox"
                             Grid.Column="0"
                             Height="56"
                             FontSize="18"
                             Padding="15,12,45,12"
                             Background="#0C1C3A"
                             Foreground="White"
                             BorderBrush="#E2BD56"
                             BorderThickness="2"
                             PasswordChar="●"
                             VerticalContentAlignment="Center"
                             KeyDown="PasswordBox_KeyDown"/>

                <TextBox x:Name="MasterPasswordTextBox"
                         Grid.Column="0"
                         Height="56"
                         FontSize="18"
                         Padding="15,12,45,12"
                         Background="#0C1C3A"
                         Foreground="White"
                         BorderBrush="#E2BD56"
                         BorderThickness="2"
                         VerticalContentAlignment="Center"
                         Visibility="Collapsed"
                         KeyDown="PasswordBox_KeyDown"/>

                <!-- زر إظهار/إخفاء كلمة المرور -->
                <Border Width="40"
                        Height="56"
                        Cursor="Hand"
                        Background="Transparent"
                        HorizontalAlignment="Right"
                        Grid.Column="0"
                        MouseLeftButtonUp="TogglePasswordArea_MouseLeftButtonUp"
                        Panel.ZIndex="1">

                    <Button x:Name="TogglePasswordButton"
                            Width="40"
                            Height="56"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="TogglePasswordButton_Click"
                            VerticalAlignment="Center"
                            Margin="0,0,0,0">
                        <Path Data="{StaticResource bx_eye}"
                              Fill="White"
                              Width="20"
                              Height="20"
                              Stretch="Uniform"/>
                    </Button>
                </Border>


            </Grid>

            <!-- زر إلغاء القفل -->
            <Border Width="200"
                    Height="50"
                    Background="#E2BD56"
                    Cursor="Hand"
                    Margin="0,0,0,15">
                <Button x:Name="UnlockButton"
                        Width="200"
                        Height="50"
                        HorizontalAlignment="Center"
                        Foreground="#001E57"
                        FontSize="18"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Click="UnlockButton_Click">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <Path Data="{StaticResource bx_lock}"
                                  Fill="#001E57"
                                  Width="20"
                                  Height="20"
                                  Margin="0,0,10,0"
                                  Stretch="Uniform"/>
                            <TextBlock Text="{DynamicResource UnlockWindow_UnlockButton}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
            </Border>

            <!-- رابط نسيان كلمة المرور -->
            <TextBlock x:Name="ForgotPasswordLink"
                       Text="{DynamicResource UnlockWindow_ForgotPassword}"
                       Foreground="#E2BD56"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Cursor="Hand"
                       TextDecorations="Underline"
                       MouseDown="ForgotPasswordLink_MouseDown">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter Property="Foreground"
                                        Value="#FFD9BD56"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <!-- زر الإعدادات في الزاوية -->
        <Button x:Name="SettingsButton"
                Width="50"
                Height="50"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="20"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                Click="SettingsButton_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="25"
                                        Width="50"
                                        Height="50">
                                    <Path Data="{StaticResource bx_settings}"
                                          Fill="White"
                                          Width="24"
                                          Height="24"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter Property="Background"
                                    Value="#33E2BD56"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="#33E2BD56"
                                                CornerRadius="25"
                                                Width="50"
                                                Height="50">
                                            <Path Data="{StaticResource bx_settings}"
                                                  Fill="#E2BD56"
                                                  Width="24"
                                                  Height="24"
                                                  Stretch="Uniform"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <!-- قائمة الإعدادات (Popup) -->
        <Popup x:Name="SettingsPopup"
               Placement="Top"
               PlacementTarget="{Binding ElementName=SettingsButton}"
               StaysOpen="False"
               PopupAnimation="Fade">
            <Border Background="#0C1C3A"
                    BorderBrush="#E2BD56"
                    BorderThickness="2"
                    CornerRadius="8"
                    Padding="10"
                    MinWidth="200">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings_Title}"
                               Foreground="White"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>
                    <!-- يمكن إضافة خيارات الإعدادات هنا لاحقاً -->
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
