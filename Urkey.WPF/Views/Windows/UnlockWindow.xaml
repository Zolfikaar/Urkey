<Window x:Class="Urkey.WPF.Views.Windows.UnlockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:uc="clr-namespace:Urkey.WPF.UserControls"
        mc:Ignorable="d"
        Title="{DynamicResource AppTitle}"
        WindowStyle="SingleBorderWindow"
        WindowState="Maximized"
        ResizeMode="CanResize"
        Width="1200"
        Height="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AuthBgColor}"
        AllowsTransparency="False"
        ShowInTaskbar="True"
        Topmost="False"
        Icon="/Assets/Icons/favicon.ico"
        FlowDirection="{DynamicResource AppFlowDirection}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Image Source="/Assets/Backgrounds/splash-bg.jpg"
               Stretch="UniformToFill"
               Opacity="0.92"/>

        <Grid x:Name="LogoContainer"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Margin="0,0,0,100">
            <Image Source="/Assets/Logos/Logo_with_bg.png"
                   Width="640"
                   Height="900"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
        </Grid>

        <StackPanel x:Name="InputPanel"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,96"
                    HorizontalAlignment="Center"
                    MaxWidth="400">

            <TextBlock Text="{DynamicResource UnlockWindow_VaultLocked}"
                       Style="{StaticResource Text.AuthTitle}"
                       Margin="0,0,0,8"/>

            <TextBlock Text="{DynamicResource UnlockWindow_EnterMasterPassword}"
                       Style="{StaticResource Text.AuthSubtitle}"
                       Margin="0,0,0,20"
                       MaxWidth="400"/>

            <!-- Password field: trailing toggle column flips with FlowDirection -->
            <Grid Width="320"
                  HorizontalAlignment="Center"
                  Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <PasswordBox x:Name="MasterPasswordBox"
                             Grid.Column="0"
                             Style="{StaticResource AuthPasswordBoxStyle}"
                             KeyDown="PasswordBox_KeyDown"/>

                <TextBox x:Name="MasterPasswordTextBox"
                         Grid.Column="0"
                         Style="{StaticResource AuthTextBoxStyle}"
                         Visibility="Collapsed"
                         KeyDown="PasswordBox_KeyDown"/>

                <Button x:Name="TogglePasswordButton"
                        Grid.Column="1"
                        Style="{StaticResource AuthIconBtnStyle}"
                        Click="TogglePasswordButton_Click"
                        ToolTip="{DynamicResource UnlockWindow_ShowPassword}">
                    <Path Data="{StaticResource bx_eye}"
                          Fill="{DynamicResource AuthTextColor}"
                          Width="20"
                          Height="20"
                          Stretch="Uniform"/>
                </Button>
            </Grid>

            <Button x:Name="UnlockButton"
                    Style="{StaticResource AuthPrimaryBtnStyle}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,16"
                    IsDefault="True"
                    Click="UnlockButton_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource bx_lock}"
                          Fill="{DynamicResource AuthButtonForeground}"
                          Width="20"
                          Height="20"
                          Margin="8,0"
                          Stretch="Uniform"
                          VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource UnlockWindow_UnlockButton}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AuthButtonForeground}"/>
                </StackPanel>
            </Button>

            <TextBlock x:Name="ForgotPasswordLink"
                       Text="{DynamicResource UnlockWindow_ForgotPassword}"
                       Style="{StaticResource Text.AuthLink}"
                       MouseDown="ForgotPasswordLink_MouseDown"/>
        </StackPanel>

        <Button x:Name="SettingsButton"
                Style="{StaticResource AuthSettingsBtnStyle}"
                Click="SettingsButton_Click"/>

        <Popup x:Name="SettingsPopup"
               Placement="Top"
               PlacementTarget="{Binding ElementName=SettingsButton}"
               StaysOpen="False"
               PopupAnimation="Fade">
            <Border Style="{StaticResource AuthPopupPanelStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings_Title}"
                               Foreground="{DynamicResource AuthTextColor}"
                               FontSize="{StaticResource FontSizeSubtitle}"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Popup>

        <uc:ToastHost Panel.ZIndex="100"
                      Margin="24"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Bottom"
                      FlowDirection="{DynamicResource AppFlowDirection}"/>
    </Grid>
</Window>
